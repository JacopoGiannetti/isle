    "Una pioggia sottile e leggera. Agli alberi fa solo bene.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pioggia sottile e leggera. Agli alberi fa solo bene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fine, light rain. It only does the trees good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lluvia fina y ligera. A los árboles solo les sienta bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pluie fine et légère. Elle ne fait que du bien aux arbres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein feiner, leichter Regen. Den Bäumen tut er nur gut."
          }
        }
      }
    },
    "Una risposta al giorno, all'ora che scegli.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
