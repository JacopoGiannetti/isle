    "Scegli tu cosa piantare. Ogni pianta attira animali diversi: la quercia porta scoiattoli, i fiori portano conigli. Più l'isola cresce, più animali ci stanno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wählst, was du pflanzt. Jede Pflanze lockt andere Tiere an: die Eiche bringt Eichhörnchen, die Blumen bringen Kaninchen. Je mehr die Insel wächst, desto mehr Tiere können bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose what to plant. Each plant attracts different animals: the oak brings squirrels, the flowers bring rabbits. The more the island grows, the more animals can stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú eliges qué plantar. Cada planta atrae animales distintos: el roble trae ardillas, las flores traen conejos. Cuanto más crece la isla, más animales caben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est toi qui choisis quoi planter. Chaque plante attire des animaux différents : le chêne amène les écureuils, les fleurs amènent les lapins. Plus l'île grandit, plus il y a de place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli tu cosa piantare. Ogni pianta attira animali diversi: la quercia porta scoiattoli, i fiori portano conigli. Più l'isola cresce, più animali ci stanno."
          }
        }
      }
    },
    "Scegli tu quanto essere severo con te stesso." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entscheidest, wie streng du mit dir sein willst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose how strict to be with yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú eliges lo estricto que quieres ser contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À toi de choisir à quel point être strict avec toi-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli tu quanto essere severo con te stesso."
          }
        }
      }
    },
    "Scegli tutto quello che ti è successo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle alles, was dir passiert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick everything that happened to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige todo lo que te pasó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis tout ce qui t'est arrivé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli tutto quello che ti è successo."
          }
        }
      }
    },
    "Scegli tutto quello che vale per te." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle alles, was auf dich zutrifft."
          }
        },
        "en" : {
