    "Righe nella ghiaia, come onde che stanno ferme." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linien im Kies, wie Wellen, die stillstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lines in the gravel, like waves standing still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Líneas en la grava, como olas que se quedan quietas."
          }
        },
        "fr" : {
          "stringUnit" : {
