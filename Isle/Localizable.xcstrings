    "Brilla come una goccia verde tra i fiori dell'aloe." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er glänzt wie ein grüner Tropfen zwischen den Aloeblüten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It shines like a green drop among the aloe flowers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilla como una gota verde entre las flores del aloe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il brille comme une goutte verte parmi les fleurs de l'aloès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brilla come una goccia verde tra i fiori dell'aloe."
          }
        }
      }
    },
