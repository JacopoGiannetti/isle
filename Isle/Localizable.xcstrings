          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua"
          }
        }
      }
    },
    "Controlla le uova una per una, tutti i giorni. Porta ai piccoli le bacche più morbide." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie prüft die Eier, eins nach dem anderen, jeden Tag. Den Kleinen bringt sie die weichsten Beeren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She checks the eggs one by one, every day. She brings the little ones the softest berries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa los huevos uno por uno, todos los días. Les lleva a las crías las bayas más blandas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle vérifie les œufs un par un, tous les jours. Elle apporte aux petits les baies les plus tendres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla le uova una per una, tutti i giorni. Porta ai piccoli le bacche più morbide."
          }
        }
      }
    },
