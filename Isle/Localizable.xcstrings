    },
    "Isle è fatta apposta per quello che ti ha fermato." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle ist genau für das gemacht, was dich gebremst hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle is built for exactly what stopped you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle está hecha justo para lo que te frenó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle est pensée exactement pour ce qui t'a arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle è fatta apposta per quello che ti ha fermato."
          }
        }
      }
    },
    "Isle è fatta per le cose che di solito fanno mollare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle ist für genau das gemacht, woran man sonst scheitert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle is built for the things that usually make people give up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle está hecha para lo que suele hacer abandonar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle est pensée pour ce qui fait d'habitude lâcher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle è fatta per le cose che di solito fanno mollare."
          }
        }
      }
    },
    "Isle non ha account e non legge mai le tue isole: restano su questo iPhone e nel tuo iCloud privato, che puoi vedere solo tu." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle hat keine Konten und liest deine Inseln nie: Sie bleiben auf diesem iPhone und in deiner privaten iCloud, die nur du sehen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle has no accounts and never reads your islands: they stay on this iPhone and in your private iCloud, which only you can see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle no tiene cuentas y nunca lee tus islas: se quedan en este iPhone y en tu iCloud privado, que solo tú puedes ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle n'a pas de compte et ne lit jamais tes îles : elles restent sur cet iPhone et dans ton iCloud privé, que toi seul peux voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle non ha account e non legge mai le tue isole: restano su questo iPhone e nel tuo iCloud privato, che puoi vedere solo tu."
          }
        }
      }
    },
    "Isle vive degli abbonamenti, non dei tuoi dati. Non li vendiamo a nessuno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle lebt von Abos, nicht von deinen Daten. Wir verkaufen sie an niemanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle lives on subscriptions, not on your data. We don't sell it to anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle vive de las suscripciones, no de tus datos. No se los vendemos a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle vit des abonnements, pas de tes données. Nous ne les vendons à personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isle vive degli abbonamenti, non dei tuoi dati. Non li vendiamo a nessuno."
          }
        }
      }
    },
