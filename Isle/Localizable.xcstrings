    "Alle %@ ti chiediamo «%@». Ogni «No» vale un seme e un pezzo d'isola in più, subito." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um %@ fragen wir dich „%@“. Jedes „Nein“ ist ein Samen und ein Stück Insel mehr, sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At %@ we ask you \"%@\". Every \"No\" is a seed and a little more island, right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A las %@ te preguntamos «%@». Cada «No» vale una semilla y un trozo más de isla, al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %@ on te demande « %@ ». Chaque « Non » vaut une graine et un bout d'île en plus, tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@ ti chiediamo «%@». Ogni «No» vale un seme e un pezzo d'isola in più, subito."
          }
        }
      }
    },
    "Alle %@ ti chiediamo «%@». Ogni giorno pulito vale un seme e un pezzo d'isola in più, subito." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um %@ fragen wir dich „%@“. Jeder saubere Tag ist ein Samen und ein Stück Insel mehr, sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At %@ we ask you \"%@\". Every clean day is a seed and a little more island, right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A las %@ te preguntamos «%@». Cada día limpio vale una semilla y un trozo más de isla, al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %@ on te demande « %@ ». Chaque jour sans accroc vaut une graine et un bout d'île en plus, tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@ ti chiediamo «%@». Ogni giorno pulito vale un seme e un pezzo d'isola in più, subito."
          }
        }
      }
    },
    "Alle %@ ti chiediamo: «%@». Ogni «No» fa crescere l'isola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um %@ fragen wir dich: „%@“. Jedes „Nein“ lässt die Insel wachsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At %@ we'll ask you: \"%@\". Every \"No\" grows the island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A las %@ te preguntamos: «%@». Cada «No» hace crecer la isla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %@ on te demande : « %@ ». Chaque « Non » fait grandir l'île."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@ ti chiediamo: «%@». Ogni «No» fa crescere l'isola."
          }
        }
      }
    },
