    "È caduto un meteorite, per fortuna dove non c'era niente.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È caduto un meteorite, per fortuna dove non c'era niente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meteorite fell, luckily where nothing was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha caído un meteorito, por suerte donde no había nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une météorite est tombée, heureusement là où il n'y avait rien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Meteorit ist gefallen, zum Glück dort, wo nichts war."
          }
        }
      }
    },
    "È caduto un meteorite. Il cratere diventerà uno stagno: anche questo fa parte della tua isola. Si riparte da adesso.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È caduto un meteorite. Il cratere diventerà uno stagno: anche questo fa parte della tua isola. Si riparte da adesso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meteorite fell. The crater will become a pond: this too is part of your island. We start again from now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha caído un meteorito. El cráter se convertirá en un estanque: también esto forma parte de tu isla. Se empieza de nuevo desde ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une météorite est tombée. Le cratère deviendra un étang : ça aussi, c'est ton île. On repart à partir de maintenant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Meteorit ist gefallen. Der Krater wird zum Teich: auch das gehört zu deiner Insel. Wir beginnen jetzt von vorn."
          }
        }
      }
    },
    "È caduto un meteorite. Il cratere diventerà uno stagno: anche questo fa parte della tua isola. Si riparte da domani.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È caduto un meteorite. Il cratere diventerà uno stagno: anche questo fa parte della tua isola. Si riparte da domani."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meteorite fell. The crater will become a pond: this too is part of your island. We start again tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha caído un meteorito. El cráter se convertirá en un estanque: también esto forma parte de tu isla. Se empieza de nuevo mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une météorite est tombée. Le cratère deviendra un étang : ça aussi, c'est ton île. On repart demain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Meteorit ist gefallen. Der Krater wird zum Teich: auch das gehört zu deiner Insel. Wir beginnen morgen von vorn."
          }
        }
      }
    },
    "È caduto un meteorite. Persi: %@.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È caduto un meteorite. Persi: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meteorite fell. Lost: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha caído un meteorito. Perdidos: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une météorite est tombée. Perdus : %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Meteorit ist gefallen. Verloren: %@."
          }
        }
      }
    },
    "È caduto un seme: è spuntato un germoglio di %@.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È caduto un seme: è spuntato un germoglio di %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A seed fell: a sapling of %@ has sprouted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha caído una semilla: ha brotado un retoño de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une graine est tombée : une pousse de %@ a germé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Samen ist gefallen: ein Sprössling von %@ ist gesprossen."
          }
        }
      }
    },
    "È fatto della stessa nebbia del mattino. Quando il sole scalda, svanisce.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È fatto della stessa nebbia del mattino. Quando il sole scalda, svanisce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's made of the same morning mist. When the sun warms, it vanishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está hecho de la misma niebla de la mañana. Cuando el sol calienta, se desvanece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est fait de la même brume du matin. Quand le soleil réchauffe, il s'évanouit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist aus demselben Morgennebel. Wenn die Sonne wärmt, vergeht es."
          }
        }
      }
    },
