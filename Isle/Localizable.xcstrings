    "Ti fissa senza battere ciglio. Per ore." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er starrt dich an, ohne zu blinzeln. Stundenlang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stares at you without blinking. For hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te mira fijamente sin pestañear. Durante horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te fixe sans cligner des yeux. Pendant des heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti fissa senza battere ciglio. Per ore."
          }
        }
      }
    },
    "Ti manca 1 volta, hai tempo fino a %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir fehlt noch 1 Mal, du hast Zeit bis %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 more time to go, you have until %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te falta 1 vez, tienes hasta el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te manque 1 fois, tu as jusqu'à %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti manca 1 volta, hai tempo fino a %@."
          }
        }
      }
    },
    "Ti manca 1 volta: oggi è l'ultimo giorno della settimana." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir fehlt noch 1 Mal: heute ist der letzte Tag der Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 more time to go: today is the last day of the week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te falta 1 vez: hoy es el último día de la semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te manque 1 fois : aujourd'hui, c'est le dernier jour de la semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti manca 1 volta: oggi è l'ultimo giorno della settimana."
          }
        }
      }
    },
