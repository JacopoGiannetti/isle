    "Stanotte le lucciole sono tantissime e danzano intorno all'isola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stanotte le lucciole sono tantissime e danzano intorno all'isola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonight the fireflies are countless, dancing around the island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta noche hay muchísimas luciérnagas y danzan alrededor de la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette nuit les lucioles sont innombrables et dansent autour de l'île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute Nacht sind die Glühwürmchen zahllos und tanzen um die Insel."
          }
        }
      }
    },
