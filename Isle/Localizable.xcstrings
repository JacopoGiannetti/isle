    "Intreccia nidi tra i fiori dell'acacia. Il suo è sempre il più bello." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er flicht Nester zwischen den Akazienblüten. Seines ist immer das schönste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It weaves nests among the acacia flowers. Its own is always the prettiest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teje nidos entre las flores de la acacia. El suyo siempre es el más bonito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tresse des nids parmi les fleurs de l'acacia. Le sien est toujours le plus beau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intreccia nidi tra i fiori dell'acacia. Il suo è sempre il più bello."
          }
        }
      }
    },
