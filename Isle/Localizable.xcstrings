    "Essere fiero di me" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stolz auf mich sein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be proud of myself"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estar orgulloso de mí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être fier de moi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essere fiero di me"
          }
        }
