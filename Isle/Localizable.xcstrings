            "value" : "Solo se acerca donde la nieve es profunda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s'approche que là où la neige est épaisse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
