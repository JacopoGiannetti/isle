      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gefürchtetste von allen. Mit den kurzen Ärmchen umarmt er aber ganz schlecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The most feared of all. With those short little arms, though, its hugs are terrible."
