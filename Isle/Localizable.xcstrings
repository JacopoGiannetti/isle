          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rarest night of all: the island shines silver and sparks rise from the grass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La noche más rara de todas: la isla brilla de plata y suben chispas de la hierba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuit la plus rare de toutes : l'île brille d'argent et des étincelles s'élèvent de l'herbe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die seltenste Nacht von allen: die Insel glänzt silbern, und Funken steigen aus dem Gras."
          }
        }
      }
    },
    "La storia della tua isola comincia oggi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La storia della tua isola comincia oggi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The story of your island begins today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La historia de tu isla empieza hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'histoire de ton île commence aujourd'hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschichte deiner Insel beginnt heute."
          }
        }
      }
    },
    "La tempesta ha spazzato l'isola": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tempesta ha spazzato l'isola"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storm swept the island"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tormenta ha barrido la isla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tempête a balayé l'île"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sturm hat die Insel gefegt"
          }
        }
      }
    },
    "La tempesta ha spazzato via l'isola. Restano gli alberi più forti: basta una risposta per ricominciare.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tempesta ha spazzato via l'isola. Restano gli alberi più forti: basta una risposta per ricominciare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storm swept the island away. The strongest trees remain: one answer is enough to begin again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tormenta se ha llevado la isla. Quedan los árboles más fuertes: basta una respuesta para recomenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tempête a emporté l'île. Il reste les arbres les plus forts : une réponse suffit pour recommencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sturm hat die Insel hinweggefegt. Die stärksten Bäume bleiben: eine Antwort genügt, um neu zu beginnen."
          }
        }
      }
    },
    "La tempesta è passata sopra l'isola. Torna: ripartirà tutto, un po' alla volta.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tempesta è passata sopra l'isola. Torna: ripartirà tutto, un po' alla volta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storm has passed over the island. Come back: it will all start again, a little at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tormenta ha pasado sobre la isla. Vuelve: todo volverá a empezar, poco a poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tempête est passée sur l'île. Reviens : tout reprendra, un peu à la fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sturm ist über die Insel gezogen. Komm zurück: alles beginnt wieder, Stück für Stück."
          }
        }
      }
    },
    "La tempesta è passata. L'isola ricomincia a fiorire.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tempesta è passata. L'isola ricomincia a fiorire."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storm has passed. The island is beginning to bloom again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tormenta ha pasado. La isla vuelve a florecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tempête est passée. L'île recommence à fleurir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sturm ist vorbei. Die Insel beginnt wieder zu blühen."
          }
        }
      }
    },
    "La terra si sta richiudendo. Fra qualche giorno qui ci sarà uno stagno.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La terra si sta richiudendo. Fra qualche giorno qui ci sarà uno stagno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The earth is closing over. In a few days there will be a pond here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tierra se está cerrando. En unos días aquí habrá un estanque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La terre se referme. Dans quelques jours, il y aura un étang ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erde schließt sich. In ein paar Tagen wird hier ein Teich sein."
          }
        }
      }
    },
    "La tua isola ti aspetta. Rispondi e pianta il seme di oggi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua isola ti aspetta. Rispondi e pianta il seme di oggi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your island is waiting. Answer and plant today's seed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu isla te espera. Responde y planta la semilla de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton île t'attend. Réponds et plante la graine d'aujourd'hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Insel wartet. Antworte und pflanze den Samen von heute."
          }
        }
      }
    },
    "La vedi solo se lei vuole.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vedi solo se lei vuole."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You only see her if she wants you to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo la ves si ella quiere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne la vois que si elle le veut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst sie nur, wenn sie will."
          }
        }
      }
    },
    "La voglia dura pochi minuti. Respiriamo insieme.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voglia dura pochi minuti. Respiriamo insieme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The craving only lasts a few minutes. Let's breathe together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El antojo dura pocos minutos. Respiremos juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envie ne dure que quelques minutes. Respirons ensemble."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verlangen dauert nur ein paar Minuten. Lass uns zusammen atmen."
          }
        }
      }
    },
    "La voglia è passata": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voglia è passata"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The craving has passed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El antojo ha pasado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envie est passée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verlangen ist vorbei"
          }
        }
      }
    },
    "Lampi e tuoni lontani. Fa scena, ma all'isola non succede niente.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampi e tuoni lontani. Fa scena, ma all'isola non succede niente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distant lightning and thunder. It puts on a show, but nothing happens to the island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relámpagos y truenos lejanos. Hace escena, pero a la isla no le pasa nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclairs et tonnerre au loin. Ça en jette, mais il ne se passe rien sur l'île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferne Blitze und Donner. Viel Theater, aber der Insel geschieht nichts."
          }
        }
      }
    },
    "Lampi e vento: i fiori volano via e qualche albero sta seccando.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampi e vento: i fiori volano via e qualche albero sta seccando."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lightning and wind: the flowers blow away and some trees are drying out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Relámpagos y viento: las flores se vuelan y algún árbol se está secando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclairs et vent : les fleurs s'envolent et quelques arbres se dessèchent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blitze und Wind: die Blumen fliegen fort, und ein paar Bäume verdorren."
          }
        }
      }
    },
