    "Ce l'hai fatta. Sulla tua isola sta per nascere qualcosa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast es geschafft. Auf deiner Insel will etwas wachsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You did it. Something is about to bloom on your island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo has logrado. En tu isla está a punto de nacer algo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as réussi. Sur ton île, quelque chose est sur le point de naître."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce l'hai fatta. Sulla tua isola sta per nascere qualcosa."
          }
        }
      }
    },
