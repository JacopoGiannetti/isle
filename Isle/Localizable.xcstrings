        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si nasconde tra i pomodori maturi e aspetta le lumache. Di notte canta con la voce bassa."
          }
        }
      }
    },
    "Si nasconde tra le azalee e canta. Lo senti sempre, ma non lo vedi quasi mai." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er versteckt sich zwischen den Azaleen und singt. Man hört ihn immer, sieht ihn aber fast nie."
