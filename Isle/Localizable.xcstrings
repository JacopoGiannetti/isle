    "Alza il collo fuori dalla palude per guardarsi intorno. Poi sparisce senza un'onda." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er streckt den Hals aus dem Sumpf, um sich umzusehen. Dann verschwindet er ohne eine Welle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lifts its neck out of the swamp to look around. Then it vanishes without a ripple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saca el cuello del pantano para mirar alrededor. Luego desaparece sin una ola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sort le cou du marais pour regarder autour de lui. Puis il disparaît sans une vague."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alza il collo fuori dalla palude per guardarsi intorno. Poi sparisce senza un'onda."
          }
        }
      }
    },
    "Alza una zampa per salutare chi passa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
