    "Era legno, ora è pietra. Ci vuole solo un po' di pazienza." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es war Holz, jetzt ist es Stein. Es braucht nur ein bisschen Geduld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was wood, now it's stone. It just takes a little patience."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era madera, ahora es piedra. Solo hace falta un poco de paciencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'était du bois, c'est de la pierre. Il suffit d'un peu de patience."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era legno, ora è pietra. Ci vuole solo un po' di pazienza."
          }
        }
      }
    },
