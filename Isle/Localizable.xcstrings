    "Così rossi che si vedono dalla luna." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So rot, dass man sie vom Mond aus sieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So red you can see them from the moon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tan rojos que se ven desde la luna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rouges qu'on les voit depuis la lune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così rossi che si vedono dalla luna."
          }
        }
      }
    },
    "Così tanti fiori che le foglie non si vedono più." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So viele Blüten, dass man die Blätter nicht mehr sieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So many flowers you can't see the leaves anymore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tantas flores que ya no se ven las hojas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant de fleurs qu'on ne voit plus les feuilles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così tanti fiori che le foglie non si vedono più."
          }
        }
      }
    },
    "Così tanti frutti che i rami si piegano." : {
      "extractionState" : "manual",
