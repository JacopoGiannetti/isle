            "value" : "Für eine Weile fort"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gone for a while"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marchados un tiempo"
          }
        },
        "fr" : {
