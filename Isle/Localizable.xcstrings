    "Cerca formiche tra l'erba in fiore. Se ha paura si arrotola a palla e aspetta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sucht Ameisen in der blühenden Steppe. Hat es Angst, rollt es sich zur Kugel und wartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It looks for ants in the blooming grass. When it's scared, it rolls into a ball and waits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca hormigas entre la hierba en flor. Si tiene miedo, se enrolla como una bola y espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cherche des fourmis dans l'herbe en fleurs. S'il a peur, il se roule en boule et attend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca formiche tra l'erba in fiore. Se ha paura si arrotola a palla e aspetta."
          }
        }
      }
    },
    "Cerca le ghiande e i pomodori gialli. La cintura bianca si vede anche da lontano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sucht Eicheln und gelbe Tomaten. Der weiße Gürtel ist schon von Weitem zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It looks for acorns and yellow tomatoes. Its white belt can be seen even from far away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca bellotas y tomates amarillos. El cinturón blanco se ve incluso de lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cherche des glands et des tomates jaunes. Sa ceinture blanche se voit même de loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca le ghiande e i pomodori gialli. La cintura bianca si vede anche da lontano."
          }
        }
      }
    },
    "Cerca le rane vicino alla fontana che canta. Quando vola, le ali diventano rosa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sucht Frösche beim singenden Brunnen. Im Flug werden seine Flügel rosa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It looks for frogs near the singing fountain. When it flies, its wings turn pink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca ranas cerca de la fuente que canta. Cuando vuela, las alas se vuelven rosas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cherche des grenouilles près de la fontaine qui chante. Quand il vole, ses ailes deviennent roses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca le rane vicino alla fontana che canta. Quando vola, le ali diventano rosa."
          }
        }
      }
    },
