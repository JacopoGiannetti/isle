    "Con la testa tocca le stelle, e se ne porta via qualcuna." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Kopf berührt sie die Sterne und nimmt ein paar mit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its head touches the stars, and it takes a few home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la cabeza toca las estrellas, y se lleva alguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la tête, elle touche les étoiles, et en emporte quelques-unes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con la testa tocca le stelle, e se ne porta via qualcuna."
