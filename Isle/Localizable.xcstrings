    "Intelligentissimo. Ha già capito che lo spaventapasseri è finto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superschlau. Sie hat längst kapiert, dass die Vogelscheuche nicht echt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very clever. It has already figured out the scarecrow is fake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listísimo. Ya ha entendido que el espantapájaros es de mentira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Très intelligent. Il a déjà compris que l'épouvantail est faux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intelligentissimo. Ha già capito che lo spaventapasseri è finto."
          }
        }
      }
    },
    "Intreccia nidi a forma di pallina." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er flicht Nester in Form kleiner Kugeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It weaves nests shaped like little balls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teje nidos con forma de pelotita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tresse des nids en forme de petite balle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intreccia nidi a forma di pallina."
          }
        }
      }
    },
    "Intreccia nidi con l'erba per tutto il giorno. Se il nido non gli piace, lo disfa e ricomincia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er flicht den ganzen Tag Nester aus Gras. Gefällt ihm ein Nest nicht, löst er es auf und fängt von vorn an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It weaves grass nests all day long. If it doesn't like a nest, it unpicks it and starts again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teje nidos de hierba todo el día. Si el nido no le gusta, lo deshace y empieza de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tresse des nids d'herbe toute la journée. Si le nid ne lui plaît pas, il le défait et recommence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intreccia nidi con l'erba per tutto il giorno. Se il nido non gli piace, lo disfa e ricomincia."
          }
        }
      }
    },
    "Intreccia nidi tra i fiori dell'acacia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er flicht Nester zwischen den Akazienblüten."
