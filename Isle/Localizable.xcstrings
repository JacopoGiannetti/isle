        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esconde bajo la glicinia y lo observa todo con aire astuto. De noche sale a buscar fruta caída."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se cache sous la glycine et observe tout d'un air malin. La nuit, il sort chercher des fruits tombés."
