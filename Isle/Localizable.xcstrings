    "Suona la sua cresta sotto la magnolia bianca. La musica arriva fino al mare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er spielt seinen Kamm unter der weißen Magnolie. Die Musik reicht bis zum Meer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It plays its crest beneath the white magnolia. The music carries all the way to the sea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca su cresta bajo la magnolia blanca. La música llega hasta el mar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il joue de sa crête sous le magnolia blanc. La musique porte jusqu'à la mer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona la sua cresta sotto la magnolia bianca. La musica arriva fino al mare."
          }
        }
      }
    },
