    "Vola tra i fiori dell'azalea e beve da ognuno. Le ali gialle e nere si vedono da lontano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fliegt zwischen den Azaleenblüten und trinkt aus jeder. Seine gelb-schwarzen Flügel sieht man von Weitem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flies among the azalea flowers and drinks from each one. Its yellow and black wings can be seen from far away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela entre las flores de la azalea y bebe de cada una. Las alas amarillas y negras se ven de lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vole parmi les fleurs de l'azalée et boit dans chacune. Ses ailes jaunes et noires se voient de loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola tra i fiori dell'azalea e beve da ognuno. Le ali gialle e nere si vedono da lontano."
          }
        }
      }
    },
