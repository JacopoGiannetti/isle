    "Di notte si arrampica tra i filari della vigna e assaggia un acino per grappolo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts klettert er zwischen den Rebzeilen herum und probiert eine Beere pro Traube."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At night it climbs among the vineyard rows and tastes one grape from each bunch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De noche trepa entre las hileras de la viña y prueba una uva de cada racimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuit, elle grimpe entre les rangs de vigne et goûte un grain par grappe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di notte si arrampica tra i filari della vigna e assaggia un acino per grappolo."
          }
        }
      }
    },
    "Di notte si posa sul ramo più alto del Salice d'argento. I suoi occhi d'oro vedono tutta l'isola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts setzt sie sich auf den höchsten Ast der Silberweide. Ihre goldenen Augen sehen die ganze Insel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At night it perches on the highest branch of the Silver Willow. Its golden eyes see the whole island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De noche se posa en la rama más alta del Sauce de plata. Sus ojos de oro ven toda la isla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuit elle se pose sur la plus haute branche du Saule d'argent. Ses yeux d'or voient toute l'île."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di notte si posa sul ramo più alto del Salice d'argento. I suoi occhi d'oro vedono tutta l'isola."
          }
        }
      }
    },
    "Di pietra, coperta di muschio. Di notte si accende." : {
