    "Pattuglia il fiordo in silenzio. Salta fuori dall'acqua solo per farsi vedere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er patrouilliert still im Fjord. Er springt nur aus dem Wasser, um gesehen zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It patrols the fjord in silence. It leaps out of the water just to show off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patrulla el fiordo en silencio. Salta fuera del agua solo para que la vean."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle patrouille le fjord en silence. Elle saute hors de l'eau juste pour se faire voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattuglia il fiordo in silenzio. Salta fuori dall'acqua solo per farsi vedere."
          }
        }
      }
    },
    "Pattuglia l'acqua avanti e indietro, sempre sulla stessa rotta. Si ferma sulle canne ad asciugare le ali." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patrouilliert das Wasser hin und her, immer auf derselben Route. Bleibt am Schilf, um die Flügel zu trocknen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It patrols the water back and forth, always on the same route. It stops on the reeds to dry its wings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patrulla el agua de un lado a otro, siempre por la misma ruta. Se para en las cañas a secarse las alas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle patrouille l'eau d'un bout à l'autre, toujours sur la même route. Elle s'arrête sur les roseaux pour sécher ses ailes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattuglia l'acqua avanti e indietro, sempre sulla stessa rotta. Si ferma sulle canne ad asciugare le ali."
          }
        }
      }
    },
    "Pattuglia la palude con le sue ali enormi. Quando si posa, la canna si piega." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie patrouilliert mit ihren riesigen Flügeln über den Sumpf. Wenn sie landet, biegt sich das Schilf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It patrols the swamp on its huge wings. When it lands, the reed bends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patrulla el pantano con sus alas enormes. Cuando se posa, la caña se dobla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle patrouille sur le marais de ses ailes immenses. Quand elle se pose, le roseau plie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pattuglia la palude con le sue ali enormi. Quando si posa, la canna si piega."
          }
        }
      }
    },
