    "Piove da qualche ora. Gli animali si sono messi al riparo e aspettano te.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piove da qualche ora. Gli animali si sono messi al riparo e aspettano te."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's been raining for a few hours. The animals have taken shelter and they're waiting for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva unas horas lloviendo. Los animales se han puesto a cubierto y te esperan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pleut depuis quelques heures. Les animaux se sont mis à l'abri et t'attendent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es regnet seit ein paar Stunden. Die Tiere haben Schutz gesucht und warten auf dich."
          }
        }
      }
    },
    "Piove forte, ma è solo il tempo: gli animali restano sull'isola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piove forte, ma è solo il tempo: gli animali restano sull'isola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's raining hard, but it's only weather: the animals stay on the island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llueve fuerte, pero es solo el tiempo: los animales se quedan en la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pleut fort, mais ce n'est que le temps : les animaux restent sur l'île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es regnet stark, aber es ist nur Wetter: die Tiere bleiben auf der Insel."
          }
        }
      }
    },
    "Piove sull'isola": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piove sull'isola"
          }
        },
        "en": {
          "stringUnit": {
