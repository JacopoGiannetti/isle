    "Si nasconde tra i pomodori maturi e aspetta le lumache. Di notte canta con la voce bassa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie versteckt sich zwischen den reifen Tomaten und wartet auf Schnecken. Nachts singt sie mit tiefer Stimme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It hides among the ripe tomatoes and waits for snails. At night it sings in a low voice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esconde entre los tomates maduros y espera a los caracoles. De noche canta con voz grave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se cache parmi les tomates mûres et attend les escargots. La nuit, il chante d'une voix grave."
