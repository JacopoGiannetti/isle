    "Pattuglia l'acqua avanti e indietro, sempre sulla stessa rotta. Si ferma sulle canne ad asciugare le ali.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pattuglia l'acqua avanti e indietro, sempre sulla stessa rotta. Si ferma sulle canne ad asciugare le ali."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It patrols the water back and forth, always on the same route. It stops on the reeds to dry its wings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrulla el agua de un lado a otro, siempre por la misma ruta. Se para en las cañas a secarse las alas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle patrouille l'eau d'un bout à l'autre, toujours sur la même route. Elle s'arrête sur les roseaux pour sécher ses ailes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrouilliert das Wasser hin und her, immer auf derselben Route. Bleibt am Schilf, um die Flügel zu trocknen."
          }
        }
      }
    },
