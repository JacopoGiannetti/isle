    "Una nebbiolina bassa si posa tra gli alberi e sparisce col sole.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nebbiolina bassa si posa tra gli alberi e sparisce col sole."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low mist settles among the trees and vanishes with the sun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una neblina baja se posa entre los árboles y desaparece con el sol."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite brume se pose entre les arbres et s'en va avec le soleil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein niedriger Nebel legt sich zwischen die Bäume und verschwindet mit der Sonne."
          }
        }
      }
    },
