            "value" : "Pick everything that's true for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige todo lo que vaya contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis tout ce qui te correspond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli tutto quello che vale per te."
          }
        }
      }
    },
    "Sceglie la ciliegia più rossa e la mangia con calma. Fischia piano, quasi sottovoce." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt die röteste Kirsche und isst sie in Ruhe. Pfeift leise, fast nur für sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It picks the reddest cherry and eats it slowly. It whistles softly, almost under its breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la cereza más roja y se la come con calma. Silba bajito, casi en voz baja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il choisit la cerise la plus rouge et la mange sans se presser. Il siffle tout doucement, presque à voix basse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie la ciliegia più rossa e la mangia con calma. Fischia piano, quasi sottovoce."
          }
        }
      }
    },
    "Schiuma bianca e pesci che saltano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weißer Schaum und springende Fische."
          }
        },
        "en" : {
          "stringUnit" : {
