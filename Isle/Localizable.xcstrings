          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta entre los abetos de escarcha y desaparece en un destello de plata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
