    "Prende a testate i tronchi per salutare. Non si fa mai male." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er stößt zur Begrüßung mit dem Kopf gegen Baumstämme. Er tut sich nie weh."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It headbutts tree trunks to say hello. It never gets hurt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da cabezazos a los troncos para saludar. Nunca se hace daño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il donne des coups de tête aux troncs pour dire bonjour. Il ne se fait jamais mal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende a testate i tronchi per salutare. Non si fa mai male."
          }
        }
      }
    },
    "Prende a testate la cicadea rossa, piano, per far cadere i semi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er stößt sanft mit dem Kopf gegen den roten Palmfarn, damit die Samen fallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gently headbutts the red cycad to make the seeds fall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da cabezazos suaves a la cícada roja para que caigan las semillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il donne de petits coups de tête au cycas rouge pour faire tomber les graines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende a testate la cicadea rossa, piano, per far cadere i semi."
          }
        }
      }
    },
    "Prende il sole su un sasso, una zampa alla volta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sonnt sich auf einem Stein, ein Bein nach dem anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sunbathes on a stone, one leg at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma el sol sobre una piedra, una pata cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se dore sur une pierre, une patte à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende il sole su un sasso, una zampa alla volta."
          }
        }
      }
    },
    "Prende il sole sui sassi caldi, poi sparisce in un lampo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sonnt sich auf warmen Steinen und verschwindet dann blitzschnell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sunbathes on the warm stones, then vanishes in a flash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma el sol en las piedras calientes y luego desaparece en un relámpago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se dore sur les pierres chaudes, puis disparaît en un éclair."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende il sole sui sassi caldi, poi sparisce in un lampo."
          }
        }
      }
    },
    "Prende il sole sui sassi del giardino perfetto. La coda brilla di blu quando corre." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sonnt sich auf den Steinen des perfekten Gartens. Sein Schwanz glänzt blau, wenn er rennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sunbathes on the stones of the perfect garden. Its tail shines blue when it runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma el sol en las piedras del jardín perfecto. La cola le brilla de azul cuando corre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se dore sur les pierres du jardin parfait. Sa queue brille de bleu quand il court."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende il sole sui sassi del giardino perfetto. La coda brilla di blu quando corre."
          }
        }
      }
    },
