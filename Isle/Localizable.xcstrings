    "Guizza tra le radici dell'Abete innevato, sempre di corsa. Si alza sulle zampe dietro per guardarsi intorno.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guizza tra le radici dell'Abete innevato, sempre di corsa. Si alza sulle zampe dietro per guardarsi intorno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It darts among the roots of the Snowy Fir, always running. It stands up on its hind legs to look around."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escabulle entre las raíces del Abeto nevado, siempre a la carrera. Se alza sobre las patas traseras para mirar alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file entre les racines du Sapin enneigé, toujours en courant. Il se dresse sur ses pattes de derrière pour regarder autour de lui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Huscht zwischen den Wurzeln der verschneiten Tanne, immer in Eile. Stellt sich auf die Hinterbeine, um sich umzusehen."
          }
        }
      }
    },
    "Ha %d cuccioli: %@": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha %d cuccioli: %@"
          }
        },
        "en": {
          "stringUnit": {
