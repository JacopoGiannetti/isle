    "Nessun giudizio: quasi tutti ci provano più di una volta prima di farcela." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Urteil: Fast alle versuchen es mehr als einmal, bevor es klappt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No judgment: almost everyone tries more than once before it sticks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin juicios: casi todos lo intentan más de una vez antes de lograrlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun jugement : presque tout le monde essaie plusieurs fois avant d'y arriver."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun giudizio: quasi tutti ci provano più di una volta prima di farcela."
          }
        }
      }
    },
    "Nessuno l'ha costruito. Una mattina era lì." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand hat es gebaut. Eines Morgens war es da."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody built it. One morning, it was there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie lo construyó. Una mañana estaba ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne l'a construit. Un matin, il était là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno l'ha costruito. Una mattina era lì."
          }
        }
      }
    },
    "Nessuno l'ha mai visto due volte nello stesso posto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand hat es je zweimal am selben Ort gesehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No one has ever seen it twice in the same place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie lo ha visto dos veces en el mismo sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne l'a jamais vu deux fois au même endroit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno l'ha mai visto due volte nello stesso posto."
          }
        }
      }
    },
    "Nessuno ne ha mai visto il fondo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand hat je seinen Grund gesehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No one has ever seen the bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie ha visto nunca su fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n'en a jamais vu le fond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ne ha mai visto il fondo."
          }
        }
      }
    },
    "Nessuno sa da dove venga la sua luce." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand weiß, woher sein Licht kommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No one knows where its light comes from."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie sabe de dónde viene su luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne sait d'où vient sa lumière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno sa da dove venga la sua luce."
          }
        }
      }
    },
    "Nessuno sa dove vada di giorno. Di notte cammina tra il Ciliegio d'oro e l'Albero di luce, senza lasciare impronte." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand weiß, wohin es am Tag geht. Nachts läuft es zwischen dem goldenen Kirschbaum und dem Lichtbaum, ohne Spuren zu hinterlassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No one knows where it goes by day. At night it walks between the Golden Cherry Tree and the Light Tree, without leaving footprints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie sabe adónde va de día. De noche camina entre el Cerezo de oro y el Árbol de luz, sin dejar huellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne sait où il va le jour. La nuit il marche entre le Cerisier d'or et l'Arbre de lumière, sans laisser d'empreintes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno sa dove vada di giorno. Di notte cammina tra il Ciliegio d'oro e l'Albero di luce, senza lasciare impronte."
          }
        }
      }
    },
