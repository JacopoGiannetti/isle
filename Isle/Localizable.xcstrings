    "Temporale: il vento si è portato via i fiori e %d alberi sono seccati.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporale: il vento si è portato via i fiori e %d alberi sono seccati."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thunderstorm: the wind took the flowers and %d trees have dried out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tormenta: el viento se ha llevado las flores y %d árboles se han secado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orage : le vent a emporté les fleurs et %d arbres ont séché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewitter: der Wind hat die Blumen mitgenommen, und %d Bäume sind verdorrt."
          }
        }
      }
    },
