        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop by and say hello."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa a saludar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe dire bonjour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schau vorbei und sag hallo."
          }
        }
      }
    },
    "Passa il giorno immobile sul bordo dell'acqua. Quando scende la sera canta insieme a tutte le altre.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa il giorno immobile sul bordo dell'acqua. Quando scende la sera canta insieme a tutte le altre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It spends the day still at the water's edge. When evening falls it sings with all the others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el día inmóvil al borde del agua. Cuando cae la tarde canta junto a todas las demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle passe la journée immobile au bord de l'eau. Quand le soir tombe, elle chante avec toutes les autres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringt den Tag still am Wasserrand. Wenn der Abend kommt, singt sie mit allen anderen."
          }
        }
      }
    },
    "Passa la giornata intorno all'alveare, con pazienza infinita. Le api lo lasciano fare: ne prende sempre poco.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa la giornata intorno all'alveare, con pazienza infinita. Le api lo lasciano fare: ne prende sempre poco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It spends the day around the hive, with infinite patience. The bees let it: it always takes just a little."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el día alrededor de la colmena, con paciencia infinita. Las abejas lo dejan: siempre toma poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passe la journée autour de la ruche, avec une patience infinie. Les abeilles le laissent faire : il n'en prend toujours qu'un peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbringt den Tag am Bienenstock, mit unendlicher Geduld. Die Bienen lassen ihn: er nimmt immer nur ein wenig."
          }
        }
      }
    },
