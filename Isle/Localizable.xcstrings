    "Mangia bambù per dodici ore al giorno. Poi si riposa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er frisst zwölf Stunden am Tag Bambus. Dann ruht er sich aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats bamboo for twelve hours a day. Then it rests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come bambú doce horas al día. Luego descansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mange du bambou douze heures par jour. Puis il se repose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia bambù per dodici ore al giorno. Poi si riposa."
          }
        }
      }
    },
    "Mangia dalle cime degli alberi senza alzarsi in punta di piedi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er frisst aus den Baumkronen, ohne sich auf die Zehenspitzen zu stellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats from the treetops without standing on tiptoe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come de las copas de los árboles sin ponerse de puntillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mange à la cime des arbres sans se mettre sur la pointe des pieds."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia dalle cime degli alberi senza alzarsi in punta di piedi."
          }
        }
      }
    },
    "Mangia i brutti sogni di tutta l'isola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er frisst die bösen Träume der ganzen Insel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats the bad dreams of the whole island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se come las pesadillas de toda la isla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mange les mauvais rêves de toute l'île."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia i brutti sogni di tutta l'isola."
          }
        }
      }
    },
    "Mangia i gattini del salice nano. Si tuffa nella neve per fare il bagno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er frisst die Kätzchen der Zwergweide. Er taucht in den Schnee, um zu baden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats the dwarf willow's catkins. It dives into the snow to take a bath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come los amentos del sauce enano. Se zambulle en la nieve para darse un baño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mange les chatons du saule nain. Il plonge dans la neige pour prendre son bain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia i gattini del salice nano. Si tuffa nella neve per fare il bagno."
          }
        }
      }
    },
    "Mangia i lamponi uno a uno con le zampe enormi. Poi si addormenta pancia all'aria." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er isst die Moltebeeren eine nach der anderen mit seinen riesigen Pranken. Dann schläft er auf dem Rücken ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats the cloudberries one by one with its huge paws. Then it falls asleep belly-up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come las moras una a una con sus patas enormes. Luego se duerme panza arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mange les plaquebières une à une avec ses pattes énormes. Puis il s'endort le ventre à l'air."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia i lamponi uno a uno con le zampe enormi. Poi si addormenta pancia all'aria."
          }
        }
      }
    },
    "Mangia le foglie dell'aloe senza fretta. Si ritira nel guscio quando fa troppo caldo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie frisst ganz ohne Eile Aloeblätter. Wenn es zu heiß wird, zieht sie sich in ihren Panzer zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats aloe leaves with no hurry at all. It pulls into its shell when it gets too hot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come hojas de aloe sin prisa. Se esconde en el caparazón cuando hace demasiado calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle mange les feuilles d'aloès sans se presser. Elle rentre dans sa carapace quand il fait trop chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia le foglie dell'aloe senza fretta. Si ritira nel guscio quando fa troppo caldo."
          }
        }
      }
    },
    "Mangia le foglie più alte dell'acacia a ombrello. Per bere deve allargare le zampe, e ci mette un po'." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie frisst die höchsten Blätter der Schirmakazie. Zum Trinken muss sie die Beine spreizen, und das dauert ein bisschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats the highest leaves of the umbrella acacia. To drink, it has to spread its legs, and that takes a while."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come las hojas más altas de la acacia paraguas. Para beber tiene que abrir las patas, y tarda un rato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle mange les plus hautes feuilles de l'acacia parasol. Pour boire, elle doit écarter les pattes, et ça prend un moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia le foglie più alte dell'acacia a ombrello. Per bere deve allargare le zampe, e ci mette un po'."
          }
        }
      }
    },
    "Mangia le foglie più alte della sequoia. Dorme in piedi, come un cavallo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er frisst die höchsten Blätter des Mammutbaums. Er schläft im Stehen, wie ein Pferd."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats the highest leaves of the sequoia. It sleeps standing up, like a horse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come las hojas más altas de la secuoya. Duerme de pie, como un caballo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mange les feuilles les plus hautes du séquoia. Il dort debout, comme un cheval."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia le foglie più alte della sequoia. Dorme in piedi, come un cavallo."
          }
        }
      }
    },
    "Mangia le gemme dell'abete coi ghiaccioli. Fa un fischio dolce e lento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er frisst die Knospen der Tanne mit Eiszapfen. Er pfeift sanft und langsam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats the buds of the icicle fir. It gives a soft, slow whistle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come las yemas del abeto con carámbanos. Silba dulce y despacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mange les bourgeons du sapin aux glaçons. Il siffle doucement, lentement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia le gemme dell'abete coi ghiaccioli. Fa un fischio dolce e lento."
          }
        }
      }
    },
    "Mangia le lumache dell'orto. Il contadino lo adora." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie frisst die Schnecken im Gemüsegarten. Der Bauer liebt sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It eats the snails in the vegetable garden. The farmer adores it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se come los caracoles del huerto. El granjero lo adora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mange les escargots du potager. Le fermier l'adore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia le lumache dell'orto. Il contadino lo adora."
          }
        }
      }
    },
    "Mangia solo i frutti della marula dorata." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie frisst nur die Früchte der goldenen Marula."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only eats the fruit of the golden marula."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo come los frutos de la marula dorada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne mange que les fruits de la marula dorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia solo i frutti della marula dorata."
          }
        }
      }
    },
    "Mangia solo i frutti più dorati. Li sceglie con cura, uno per uno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie frisst nur die goldensten Früchte. Sie sucht sie sorgfältig aus, eine nach der anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only eats the most golden fruit. It picks each one carefully, one by one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo come los frutos más dorados. Los elige con cuidado, uno a uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne mange que les fruits les plus dorés. Il les choisit avec soin, un par un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangia solo i frutti più dorati. Li sceglie con cura, uno per uno."
          }
        }
      }
    },
