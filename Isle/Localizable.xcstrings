    "Aspetta immobile. Poi, zac.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetta immobile. Poi, zac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It waits, perfectly still. Then — snap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera inmóvil. Luego, zas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il attend, immobile. Puis, zac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet regungslos. Dann — zack."
          }
        }
      }
    },
    "Aspetta su un ramo sopra la cascata, immobile. Poi si tuffa come un lampo turchese.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetta su un ramo sopra la cascata, immobile. Poi si tuffa come un lampo turchese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It waits on a branch above the waterfall, perfectly still. Then it dives like a turquoise flash."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera en una rama sobre la cascada, inmóvil. Luego se zambulle como un relámpago turquesa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il attend sur une branche au-dessus de la cascade, immobile. Puis il plonge comme un éclair turquoise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf einem Ast über dem Wasserfall, ganz still. Dann stürzt sie sich hinab wie ein türkiser Blitz."
          }
        }
      }
    },
