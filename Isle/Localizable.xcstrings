    "L'acqua fuma piano nelle mattine fresche." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wasser dampft leise an kühlen Morgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The water steams softly on cool mornings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agua humea despacio en las mañanas frescas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'eau fume tout doucement les matins frais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'acqua fuma piano nelle mattine fresche."
          }
        }
      }
    },
    "L'albero più alto dell'isola. I colli lunghi la adorano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der höchste Baum der Insel. Die Langhälse lieben ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tallest tree on the island. The long necks love it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El árbol más alto de la isla. Los cuellos largos lo adoran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'arbre le plus haut de l'île. Les longs cous l'adorent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'albero più alto dell'isola. I colli lunghi la adorano."
          }
        }
      }
    },
    "L'hai visto" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast es gesehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've seen it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo has visto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu l'as vu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'hai visto"
          }
        }
      }
    },
    "L'ho fatto un'altra volta" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hab's noch mal gemacht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I did it once more"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo he hecho otra vez"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je l'ai refait"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ho fatto un'altra volta"
          }
        }
      }
    },
    "L'isola cresce e arriva sempre qualcuno di nuovo: domani c'è di nuovo qualcosa da vedere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Insel wächst und immer kommt jemand Neues: Morgen gibt es wieder etwas zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your island grows and someone new keeps arriving: tomorrow there's always something to see."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La isla crece y siempre llega alguien nuevo: mañana habrá otra vez algo que ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'île grandit et quelqu'un de nouveau arrive toujours : demain, il y aura encore quelque chose à voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'isola cresce e arriva sempre qualcuno di nuovo: domani c'è di nuovo qualcosa da vedere."
          }
        }
      }
    },
    "L'isola era ancora troppo piccola per tutti" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Insel war noch zu klein für alle"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The island was still too small for everyone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La isla era todavía demasiado pequeña para todos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'île était encore trop petite pour tout le monde"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'isola era ancora troppo piccola per tutti"
          }
        }
      }
    },
    "L'unico abete che in autunno diventa d'oro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die einzige Tanne, die im Herbst golden wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The only fir that turns gold in autumn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El único abeto que en otoño se vuelve de oro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le seul sapin qui devient doré en automne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'unico abete che in autunno diventa d'oro."
          }
        }
      }
    },
    "L'unicorno del mare." : {
      "extractionState" : "manual",
      "localizations" : {
