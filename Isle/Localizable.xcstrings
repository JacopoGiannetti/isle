    "Nessun animale da sola, ma rende l'isola più bella": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun animale da sola, ma rende l'isola più bella"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No animals on its own, but it makes the island more beautiful"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún animal por sí sola, pero hace la isla más hermosa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun animal à elle seule, mais elle rend l'île plus belle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lockt allein keine Tiere an, macht die Insel aber schöner"
          }
        }
      }
    },
    "Nessuno l'ha mai visto due volte nello stesso posto.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno l'ha mai visto due volte nello stesso posto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one has ever seen it twice in the same place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie lo ha visto dos veces en el mismo sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne l'a jamais vu deux fois au même endroit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand hat es je zweimal am selben Ort gesehen."
          }
        }
      }
    },
    "Nessuno sa da dove venga la sua luce.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno sa da dove venga la sua luce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one knows where its light comes from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie sabe de dónde viene su luz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne sait d'où vient sa lumière."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand weiß, woher sein Licht kommt."
          }
        }
      }
    },
    "Nessuno sa dove vada di giorno. Di notte cammina tra il Ciliegio d'oro e l'Albero di luce, senza lasciare impronte.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno sa dove vada di giorno. Di notte cammina tra il Ciliegio d'oro e l'Albero di luce, senza lasciare impronte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one knows where it goes by day. At night it walks between the Golden Cherry Tree and the Light Tree, without leaving footprints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie sabe adónde va de día. De noche camina entre el Cerezo de oro y el Árbol de luz, sin dejar huellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne sait où il va le jour. La nuit il marche entre le Cerisier d'or et l'Arbre de lumière, sans laisser d'empreintes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand weiß, wohin es am Tag geht. Nachts läuft es zwischen dem goldenen Kirschbaum und dem Lichtbaum, ohne Spuren zu hinterlassen."
          }
        }
      }
    },
