    "Ancora nessuno. Pianta fiori e alberi: i primi visitatori arrivano presto.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuno. Pianta fiori e alberi: i primi visitatori arrivano presto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No one yet. Plant flowers and trees: the first visitors come soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía nadie. Planta flores y árboles: los primeros visitantes llegan pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne encore. Plante des fleurs et des arbres : les premiers visiteurs arrivent vite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch niemand. Pflanze Blumen und Bäume: die ersten Gäste kommen bald."
          }
        }
      }
    },
