            "value" : "Plana sul fiume e pesca senza bagnarsi."
          }
        }
      }
    },
    "Plana tra i ventagli del ginkgo dorato. Controluce sembra una foglia anche lui." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er gleitet zwischen den Fächern des goldenen Ginkgos. Im Gegenlicht sieht er selbst aus wie ein Blatt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It glides among the fans of the golden ginkgo. Against the light, it looks like a leaf too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planea entre los abanicos del ginkgo dorado. A contraluz, él también parece una hoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plane entre les éventails du ginkgo doré. À contre-jour, il ressemble lui aussi à une feuille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plana tra i ventagli del ginkgo dorato. Controluce sembra una foglia anche lui."
          }
        }
      }
    },
