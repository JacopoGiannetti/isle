            "value": "Tiene una cría: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A un petit : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat ein Junges: %@"
          }
        }
      }
    },
    "Ha una piuma blu che ruba lo sguardo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha una piuma blu che ruba lo sguardo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It has a blue feather that steals your gaze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene una pluma azul que se lleva la mirada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a une plume bleue qui prend tout le regard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat eine blaue Feder, die den Blick stiehlt."
          }
        }
      }
    },
    "Hai %d semi per cominciare. Pianta il primo e guarda cosa succede.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai %d semi per cominciare. Pianta il primo e guarda cosa succede."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %d seeds to start. Plant the first one and see what happens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %d semillas para empezar. Planta la primera y mira qué pasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as %d graines pour commencer. Plante la première et regarde ce qui se passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %d Samen zum Start. Pflanze den ersten und sieh, was geschieht."
          }
        }
      }
    },
    "Hai %d semi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai %d semi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %d seeds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %d semillas."
          }
        },
        "fr": {
          "stringUnit": {
