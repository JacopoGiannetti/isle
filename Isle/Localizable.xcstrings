          }
        }
      }
    },
    "Tocca un albero, un fiore o un laghetto: sale qui in alto. Poi toccalo lassù e scegli dove rimetterlo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un albero, un fiore o un laghetto: sale qui in alto. Poi toccalo lassù e scegli dove rimetterlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a tree, a flower or a pond: it rises up here. Then tap it up there and choose where to put it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un árbol, una flor o un estanque: sube aquí arriba. Luego tócalo allá y elige dónde volver a ponerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un arbre, une fleur ou un étang : il monte ici. Puis touche-le là-haut et choisis où le replacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe einen Baum, eine Blume oder einen Teich: er steigt hier hinauf. Dann tippe ihn dort oben und wähle, wohin du ihn zurücklegst."
          }
        }
      }
    },
    "Tocca un elemento per rimetterlo sull'isola": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un elemento per rimetterlo sull'isola"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap an item to put it back on the island"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un elemento para volver a ponerlo en la isla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche un élément pour le remettre sur l'île"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe ein Element, um es auf die Insel zurückzulegen"
