    "Vede poco, ma sente benissimo. Ed è molto sensibile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht schlecht, aber hört wunderbar. Und es ist sehr sensibel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It can't see much, but hears wonderfully. And it's very sensitive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve poco, pero oye de maravilla. Y es muy sensible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il voit mal, mais entend très bien. Et il est très sensible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vede poco, ma sente benissimo. Ed è molto sensibile."
          }
        }
      }
    },
    "Vede tutto per prima. E lo dice a tutti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sieht alles als Erste. Und erzählt es allen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sees everything first. And tells everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo ve todo la primera. Y se lo cuenta a todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle voit tout la première. Et le dit à tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vede tutto per prima. E lo dice a tutti."
          }
        }
      }
    },
    "Veglia sull'Albero di luce per tutta la notte. Non ulula quasi mai: gli basta guardare la luna." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wacht die ganze Nacht über den Lichtbaum. Er heult fast nie: ihm genügt es, den Mond anzusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It watches over the Light Tree all night long. It hardly ever howls: looking at the moon is enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela el Árbol de luz toda la noche. Casi nunca aúlla: le basta con mirar la luna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il veille sur l'Arbre de lumière toute la nuit. Il ne hurle presque jamais : regarder la lune lui suffit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veglia sull'Albero di luce per tutta la notte. Non ulula quasi mai: gli basta guardare la luna."
          }
        }
      }
    },
    "Veglia sull'Albero di luce viola per tutta la notte. Non ulula quasi mai: gli basta guardare la luna." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht die ganze Nacht über den violetten Lichtbaum. Heult fast nie: der Mond anzuschauen genügt ihm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It watches over the Violet Light Tree all night. It almost never howls: looking at the moon is enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vela el Árbol de luz violeta toda la noche. Casi nunca aúlla: le basta mirar la luna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il veille sur l'Arbre de lumière violette toute la nuit. Il ne hurle presque jamais : il lui suffit de regarder la lune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veglia sull'Albero di luce viola per tutta la notte. Non ulula quasi mai: gli basta guardare la luna."
          }
        }
      }
    },
    "Veli verdi e viola nel cielo fino alle %@. Guarda bene tra le nuvole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grüne und violette Schleier am Himmel bis %@. Schau genau zwischen die Wolken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green and violet veils in the sky until %@. Look closely among the clouds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velos verdes y violetas en el cielo hasta las %@. Mira bien entre las nubes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des voiles verts et violets dans le ciel jusqu'à %@. Regarde bien entre les nuages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veli verdi e viola nel cielo fino alle %@. Guarda bene tra le nuvole."
          }
        }
      }
    },
    "Veli verdi e viola ondeggiano nel cielo. Succede di rado." : {
