    "Grappoli fino a terra, e api ovunque.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grappoli fino a terra, e api ovunque."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clusters down to the ground, and bees everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Racimos hasta el suelo, y abejas por todas partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des grappes jusqu'à terre, et des abeilles partout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trauben bis zum Boden, und Bienen überall."
          }
        }
      }
    },
    "Grappoli viola che profumano tutta l'isola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grappoli viola che profumano tutta l'isola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Violet clusters that scent the whole island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Racimos morados que perfuman toda la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des grappes violettes qui parfument toute l'île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Violette Trauben, die die ganze Insel duften lassen."
          }
        }
      }
    },
