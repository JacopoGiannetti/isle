    "Dopo qualche giorno la motivazione spariva" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach ein paar Tagen war die Motivation weg"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a few days, my motivation faded"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A los pocos días la motivación desaparecía"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au bout de quelques jours, la motivation disparaissait"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo qualche giorno la motivazione spariva"
          }
        }
      }
    },
    "Dopo un giorno senza risposta arriva la tempesta: nuvole, pioggia, poi vento. Col vento alcuni animali se ne vanno e il Sentiero si ferma." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Tag ohne Antwort kommt der Sturm: Wolken, Regen, dann Wind. Beim Wind gehen manche Tiere fort und der Pfad bleibt stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a day without an answer, the storm comes: clouds, rain, then wind. With the wind, some animals leave and the Path stops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras un día sin respuesta llega la tormenta: nubes, lluvia y luego viento. Con el viento algunos animales se van y el Sendero se detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un jour sans réponse, la tempête arrive : nuages, pluie, puis vent. Avec le vent, certains animaux s'en vont et le Sentier s'arrête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un giorno senza risposta arriva la tempesta: nuvole, pioggia, poi vento. Col vento alcuni animali se ne vanno e il Sentiero si ferma."
          }
        }
      }
    },
    "Dopo una settimana senza segnarlo arriva la tempesta: nuvole, pioggia, poi vento. Col vento alcuni animali se ne vanno e il Sentiero si ferma." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einer Woche ohne Eintrag kommt der Sturm: Wolken, Regen, dann Wind. Beim Wind gehen manche Tiere fort und der Pfad bleibt stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a week without marking it, the storm comes: clouds, rain, then wind. With the wind, some animals leave and the Path stops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras una semana sin marcarlo llega la tormenta: nubes, lluvia y luego viento. Con el viento algunos animales se van y el Sendero se detiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après une semaine sans le noter, la tempête arrive : nuages, pluie, puis vent. Avec le vent, certains animaux s'en vont et le Sentier s'arrête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo una settimana senza segnarlo arriva la tempesta: nuvole, pioggia, poi vento. Col vento alcuni animali se ne vanno e il Sentiero si ferma."
          }
        }
      }
    },
    "Dorme a pancia in su, tenendosi per mano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft auf dem Rücken, Hand in Hand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps belly-up, holding hands."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme panza arriba, tomada de la mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle dort sur le dos, en se tenant la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme a pancia in su, tenendosi per mano."
          }
        }
      }
    },
    "Dorme accanto alla lava e si scalda la corazza. Di notte brilla come un braciere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft neben der Lava und wärmt seinen Panzer. Nachts glüht er wie ein Kohlebecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps by the lava and warms its armor. At night it glows like a brazier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme junto a la lava y se calienta la coraza. De noche brilla como un brasero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort près de la lave et réchauffe sa carapace. La nuit, il brille comme un brasero."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme accanto alla lava e si scalda la corazza. Di notte brilla come un braciere."
          }
        }
      }
    },
    "Dorme acciambellata vicino alla lanterna, avvolta nelle sue code. Quando si sveglia, la fiamma si fa più calda." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft zusammengerollt bei der Laterne, eingehüllt in seine Schwänze. Wenn er aufwacht, wird die Flamme wärmer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps curled up by the lantern, wrapped in its tails. When it wakes, the flame grows warmer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme acurrucado junto a la linterna, envuelto en sus colas. Cuando se despierta, la llama se vuelve más cálida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort roulé en boule près de la lanterne, enveloppé dans ses queues. Quand il se réveille, la flamme devient plus chaude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme acciambellata vicino alla lanterna, avvolta nelle sue code. Quando si sveglia, la fiamma si fa più calda."
          }
        }
      }
    },
    "dorme accoccolato" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "schläft zusammengerollt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sleeping curled up"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "duerme acurrucado"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dors en boule"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dorme accoccolato"
          }
        }
      }
    },
    "Dorme di giorno nel cavo di un albero. Di notte vola senza fare il minimo rumore." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schläft am Tag in einer Baumhöhle. Nachts fliegt sie ohne das kleinste Geräusch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps by day in the hollow of a tree. At night it flies without the slightest sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme de día en el hueco de un árbol. De noche vuela sin hacer el menor ruido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort le jour dans le creux d'un arbre. La nuit il vole sans le moindre bruit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme di giorno nel cavo di un albero. Di notte vola senza fare il minimo rumore."
          }
        }
      }
    },
    "Dorme di giorno. Di notte vede tutto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schläft am Tag. Nachts sieht sie alles."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps by day. At night it sees everything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme de día. De noche lo ve todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort le jour. La nuit, il voit tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme di giorno. Di notte vede tutto."
          }
        }
      }
    },
    "Dorme nel nido gigante della felce millenaria. Cresce un po' ogni notte." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es schläft im Riesennest des Urfarns. Es wächst jede Nacht ein bisschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps in the giant nest of the ancient fern. It grows a little every night."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme en el nido gigante del helecho milenario. Crece un poco cada noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort dans le nid géant de la fougère millénaire. Il grandit un peu chaque nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme nel nido gigante della felce millenaria. Cresce un po' ogni notte."
          }
        }
      }
    },
    "Dorme nel Tronco fiorito quasi tutto il giorno. Di notte esce a cercare nocciole, poi torna a dormire." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schläft fast den ganzen Tag im blühenden Stamm. Nachts kommt er heraus, sucht Haselnüsse, dann schläft er wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps in the Flowering Log almost all day. At night it comes out to look for hazelnuts, then goes back to sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme en el Tronco en flor casi todo el día. De noche sale a buscar avellanas, luego vuelve a dormir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort dans le Tronc en fleurs presque toute la journée. La nuit il sort chercher des noisettes, puis il se recouche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme nel Tronco fiorito quasi tutto il giorno. Di notte esce a cercare nocciole, poi torna a dormire."
          }
        }
      }
    },
    "Dorme nella grotta di quarzo e la sua corazza fa lucine sulle pareti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft in der Quarzhöhle, und sein Panzer wirft kleine Lichter an die Wände."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps in the quartz cave and its armor casts little lights on the walls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme en la cueva de cuarzo y su coraza hace lucecitas en las paredes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort dans la grotte de quartz et sa carapace fait de petites lumières sur les parois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme nella grotta di quarzo e la sua corazza fa lucine sulle pareti."
          }
        }
      }
    },
    "Dorme nella grotta tutto il pomeriggio. Quando cammina fa tremare i sassi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft den ganzen Nachmittag in der Höhle. Wenn er läuft, zittern die Steine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps in the cave all afternoon. When it walks, the stones tremble."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme en la cueva toda la tarde. Cuando camina, hace temblar las piedras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort dans la grotte tout l'après-midi. Quand il marche, les cailloux tremblent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme nella grotta tutto il pomeriggio. Quando cammina fa tremare i sassi."
          }
        }
      }
    },
    "Dorme otto mesi l'anno, e poi recupera tutto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es schläft acht Monate im Jahr und holt dann alles nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps eight months a year, then makes up for it all."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme ocho meses al año, y luego lo recupera todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort huit mois par an, puis rattrape tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme otto mesi l'anno, e poi recupera tutto."
          }
        }
      }
    },
    "Dorme sette mesi l'anno, arrotolato come una ciambella." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schläft sieben Monate im Jahr, zusammengerollt wie ein Donut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps seven months a year, curled up like a donut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme siete meses al año, enrollado como una rosquilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort sept mois par an, enroulé comme un beignet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme sette mesi l'anno, arrotolato come una ciambella."
          }
        }
      }
    },
    "Dorme sotto l'abete millenario, dove non nevica mai. Racconta storie dell'era glaciale." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es schläft unter der tausendjährigen Tanne, wo es nie schneit. Es erzählt Geschichten aus der Eiszeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps under the ancient fir, where it never snows. It tells stories of the Ice Age."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme bajo el abeto milenario, donde nunca nieva. Cuenta historias de la era glacial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort sous le sapin millénaire, où il ne neige jamais. Il raconte des histoires de l'ère glaciaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme sotto l'abete millenario, dove non nevica mai. Racconta storie dell'era glaciale."
          }
        }
      }
    },
    "Dorme sul muschio stellato e di notte brilla un pochino. Fischia ancora più piano degli altri." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft auf dem Sternmoos und leuchtet nachts ein bisschen. Er pfeift noch leiser als die anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps on the starry moss and glows a little at night. It whistles even more softly than the others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme sobre el musgo estrellado y de noche brilla un poquito. Silba aún más bajito que los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort sur la mousse étoilée et brille un peu la nuit. Il siffle encore plus doucement que les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme sul muschio stellato e di notte brilla un pochino. Fischia ancora più piano degli altri."
          }
        }
      }
    },
    "Dorme sul muschio stellato e ne prende la luce." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft auf dem Sternmoos und nimmt sein Licht auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps on the starry moss and takes in its light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme sobre el musgo estrellado y toma su luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort sur la mousse étoilée et prend sa lumière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme sul muschio stellato e ne prende la luce."
          }
        }
      }
    },
    "Dorme sulla ninfea più grande e la affonda un po'. Ha cent'anni e non ha fretta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft auf der größten Seerose und drückt sie ein bisschen unter. Er ist hundert Jahre alt und hat keine Eile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps on the biggest water lily and sinks it a little. It's a hundred years old and in no hurry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme sobre el nenúfar más grande y lo hunde un poco. Tiene cien años y no tiene prisa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort sur le plus grand nénuphar et l'enfonce un peu. Il a cent ans et n'est pas pressé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme sulla ninfea più grande e la affonda un po'. Ha cent'anni e non ha fretta."
          }
        }
      }
    },
    "Dorme sulla rupe quasi tutto il giorno. Al tramonto ruggisce, e lo si sente da tutta l'isola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schläft fast den ganzen Tag auf dem Felsen. Bei Sonnenuntergang brüllt er, und die ganze Insel hört ihn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sleeps on the rock nearly all day. At sunset it roars, and the whole island can hear it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duerme en la roca casi todo el día. Al atardecer ruge, y se le oye desde toda la isla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dort sur le rocher presque toute la journée. Au coucher du soleil, il rugit, et toute l'île l'entend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dorme sulla rupe quasi tutto il giorno. Al tramonto ruggisce, e lo si sente da tutta l'isola."
          }
        }
      }
    },
