    "Canta anche quando fa un freddo terribile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie singt, auch wenn es schrecklich kalt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings even when it's terribly cold."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta incluso cuando hace un frío terrible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante même quand il fait un froid terrible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta anche quando fa un freddo terribile."
          }
        }
      }
    },
    "Canta canzoni che durano ore." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt Lieder, die Stunden dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings songs that last for hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta canciones que duran horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle chante des chansons qui durent des heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta canzoni che durano ore."
          }
        }
      }
    },
    "Canta dal ramo più alto del melo, prima che sorga il sole. Becca le mele cadute." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie singt vom höchsten Ast des Apfelbaums, bevor die Sonne aufgeht. Sie pickt an Fallobst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings from the highest branch of the apple tree before the sun rises. It pecks at fallen apples."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta desde la rama más alta del manzano, antes de que salga el sol. Picotea las manzanas caídas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante depuis la plus haute branche du pommier, avant le lever du soleil. Il picore les pommes tombées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta dal ramo più alto del melo, prima che sorga il sole. Becca le mele cadute."
          }
        }
      }
    },
    "Canta dentro l'iceberg blu, e il ghiaccio fa da eco." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt im blauen Eisberg, und das Eis gibt das Echo zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings inside the blue iceberg, and the ice echoes back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta dentro del iceberg azul, y el hielo le hace eco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante dans l'iceberg bleu, et la glace lui fait écho."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta dentro l'iceberg blu, e il ghiaccio fa da eco."
          }
        }
      }
    },
    "Canta di sera, a squarciagola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
