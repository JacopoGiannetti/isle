          "stringUnit": {
            "state": "translated",
            "value": "It swims on its back and plays with pebbles. It slides down the bank just for the pleasure of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de espaldas y juega con las piedras. Se desliza por la orilla solo por el gusto de hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle nage sur le dos et joue avec les cailloux. Elle glisse de la rive juste pour le plaisir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwimmt auf dem Rücken und spielt mit Steinen. Rutscht nur zum Spaß das Ufer hinab."
          }
        }
      }
    },
    "Nuota tra le ninfee rosa, colorata come un ventaglio. Si liscia le piume con una cura infinita.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuota tra le ninfee rosa, colorata come un ventaglio. Si liscia le piume con una cura infinita."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It swims among the pink lilies, colored like a fan. It preens its feathers with infinite care."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada entre los nenúfares rosa, pintada como un abanico. Se alisa las plumas con un cuidado infinito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle nage parmi les nénuphars roses, colorée comme un éventail. Elle lisse ses plumes avec un soin infini."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwimmt zwischen den rosa Seerosen, bunt wie ein Fächer. Putzt die Federn mit unendlicher Sorgfalt."
          }
        }
      }
    },
    "Nuota tra le nuvole, lentissima, cantando a voce bassa.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuota tra le nuvole, lentissima, cantando a voce bassa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It swims among the clouds, very slowly, singing under its breath."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada entre las nubes, lentísima, cantando en voz baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle nage parmi les nuages, tout doucement, en chantant à voix basse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwimmt ganz langsam zwischen den Wolken und singt leise vor sich hin."
          }
        }
      }
    },
