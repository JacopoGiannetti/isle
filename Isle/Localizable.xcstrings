    "Il cielo sopra la tua isola si sta coprendo. Rispondi e torna il sole.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cielo sopra la tua isola si sta coprendo. Rispondi e torna il sole."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky over your island is clouding over. Answer, and the sun comes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo sobre tu isla se está cubriendo. Responde y vuelve el sol."
          }
        },
