    "Gira intorno al cumulo di neve azzurra. Nella neve blu è quasi invisibile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er streift um die blaue Schneewehe. Im blauen Schnee ist er fast unsichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It circles the blue snowdrift. In the blue snow it's almost invisible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da vueltas alrededor del montón de nieve azul. En la nieve azul es casi invisible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tourne autour de la congère bleue. Dans la neige bleue, il est presque invisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira intorno al cumulo di neve azzurra. Nella neve blu è quasi invisibile."
          }
        }
      }
    },
    "Gira intorno al pollaio e alle pecore. Si sdraia solo quando sono tutti al loro posto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kreist um den Hühnerstall und die Schafe. Er legt sich erst hin, wenn alle an ihrem Platz sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It circles the henhouse and the sheep. It only lies down when everyone is in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da vueltas alrededor del gallinero y de las ovejas. Solo se tumba cuando todos están en su sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tourne autour du poulailler et des moutons. Il ne se couche que quand tout le monde est à sa place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira intorno al pollaio e alle pecore. Si sdraia solo quando sono tutti al loro posto."
          }
        }
      }
    },
    "Gira intorno all'iceberg cantando. Fa le bolle a forma di anello per giocare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt singend um den Eisberg. Zum Spielen bläst er Blasenringe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It circles the iceberg, singing. It blows ring-shaped bubbles just for fun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da vueltas alrededor del iceberg cantando. Hace burbujas en forma de anillo para jugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tourne autour de l'iceberg en chantant. Il fait des bulles en forme d'anneau pour jouer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira intorno all'iceberg cantando. Fa le bolle a forma di anello per giocare."
          }
        }
      }
    },
    "Gira la testa per seguire il sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er dreht den Kopf, um der Sonne zu folgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It turns its head to follow the sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la cabeza para seguir al sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tourne la tête pour suivre le soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la testa per seguire il sole."
          }
        }
      }
    },
    "Gira lentissima intorno al cerchio delle fate, sempre nello stesso verso. Al mattino il suo giro è disegnato di luce." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kreist ganz langsam um den Feenring, immer in dieselbe Richtung. Am Morgen ist ihr Weg aus Licht gezeichnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It circles the fairy ring very slowly, always the same way. In the morning its path is drawn in light."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira lentísima alrededor del círculo de las hadas, siempre en el mismo sentido. Por la mañana su giro está dibujado de luz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle tourne tout doucement autour du cercle des fées, toujours dans le même sens. Le matin, son tour est dessiné de lumière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira lentissima intorno al cerchio delle fate, sempre nello stesso verso. Al mattino il suo giro è disegnato di luce."
          }
        }
      }
    },
    "Gira per il bosco in cerca di bacche e miele. Quando fa freddo dorme per settimane intere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streift durch den Wald auf der Suche nach Beeren und Honig. Wenn es kalt ist, schläft er wochenlang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It wanders the woods looking for berries and honey. When it's cold it sleeps for whole weeks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre el bosque en busca de bayas y miel. Cuando hace frío duerme semanas enteras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il parcourt le bois à la recherche de baies et de miel. Quand il fait froid, il dort des semaines entières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira per il bosco in cerca di bacche e miele. Quando fa freddo dorme per settimane intere."
          }
        }
      }
    },
    "Gira piano e fa la farina per tutta l'isola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie dreht sich langsam und mahlt Mehl für die ganze Insel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It turns slowly and makes flour for the whole island."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira despacio y hace la harina para toda la isla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tourne doucement et fait la farine pour toute l'île."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira piano e fa la farina per tutta l'isola."
          }
        }
      }
    },
