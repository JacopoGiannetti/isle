    "Riposa vicino al buco turchese. Quando apre gli occhi, sembra stupita di tutto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ruht am türkisen Eisloch. Wenn sie die Augen öffnet, staunt sie über alles."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rests by the turquoise hole. When it opens its eyes, it looks amazed by everything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa junto al agujero turquesa. Cuando abre los ojos, parece asombrada de todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se repose près du trou turquoise. Quand il ouvre les yeux, il a l'air émerveillé par tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposa vicino al buco turchese. Quando apre gli occhi, sembra stupita di tutto."
          }
        }
      }
    },
