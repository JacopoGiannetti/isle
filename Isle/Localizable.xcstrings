    "Salta via con un balzo e una macchia bianca.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta via con un balzo e una macchia bianca."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It bounds away in a leap and a flash of white."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salta lejos de un brinco y una mancha blanca."
          }
        },
        "fr": {
