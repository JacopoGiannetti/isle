    "Divide i frutti della marula con tutta la banda. Si fa pulire il pelo e ricambia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er teilt die Marulafrüchte mit der ganzen Bande. Er lässt sich das Fell putzen und revanchiert sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It shares the marula fruit with the whole gang. It gets its fur groomed and returns the favor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reparte los frutos de la marula con toda la banda. Se deja limpiar el pelo y devuelve el favor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il partage les fruits de la marula avec toute la bande. Il se fait toiletter et rend la pareille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Divide i frutti della marula con tutta la banda. Si fa pulire il pelo e ricambia."
          }
        }
      }
    },
