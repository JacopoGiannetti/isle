    "Galoppa nel campo di grano e poi si ferma a brucare. Scuote la criniera quando è contento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es galoppiert durch das Weizenfeld und bleibt dann zum Grasen stehen. Wenn es froh ist, schüttelt es die Mähne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gallops through the wheat field, then stops to graze. It shakes its mane when it's happy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galopa por el campo de trigo y luego se para a pastar. Sacude la crin cuando está contento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il galope dans le champ de blé puis s'arrête pour brouter. Il secoue sa crinière quand il est content."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galoppa nel campo di grano e poi si ferma a brucare. Scuote la criniera quando è contento."
          }
        }
      }
    },
    "Galoppa nel grano d'oro e quasi non si vede. La criniera bianca vola nel vento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er galoppiert durch den Goldweizen und ist kaum zu sehen. Die weiße Mähne weht im Wind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gallops through the golden wheat and almost disappears. Its white mane flies in the wind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galopa por el trigo de oro y casi no se ve. La crin blanca vuela al viento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il galope dans le blé d'or et on le voit à peine. Sa crinière blanche vole au vent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galoppa nel grano d'oro e quasi non si vede. La criniera bianca vola nel vento."
          }
        }
      }
    },
