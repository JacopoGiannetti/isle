      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hundert Tage, um ihn zu finden. Jede Münze ist ein Wunsch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hundred days to find it. Every coin is a wish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cien días para encontrarla. Cada moneda es un deseo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cent jours pour la trouver. Chaque pièce est un vœu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cento giorni per trovarla. Ogni moneta è un desiderio."
          }
        }
