    "Beve il nettare dei fiori del ciliegio, a testa in giù. Sta sempre in coppia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er trinkt kopfüber den Nektar der Kirschblüten. Er ist immer zu zweit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It drinks nectar from the cherry blossoms, upside down. It's always in pairs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe el néctar de las flores del cerezo, cabeza abajo. Siempre va en pareja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il boit le nectar des fleurs du cerisier, la tête en bas. Il est toujours en couple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beve il nettare dei fiori del ciliegio, a testa in giù. Sta sempre in coppia."
          }
        }
      }
    },
    "Beve solo acqua limpida come il cristallo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinkt nur Wasser, klar wie Kristall."
