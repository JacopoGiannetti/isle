    "Uno stagno magico: è lui che tiene l'isola sospesa nel cielo e fa nascere la vita, anche quella più strana.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno stagno magico: è lui che tiene l'isola sospesa nel cielo e fa nascere la vita, anche quella più strana."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A magic pond: it's what holds the island in the sky and brings life, even the strangest kind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estanque mágico: es él quien sostiene la isla en el cielo y hace nacer la vida, también la más extraña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un étang magique : c'est lui qui tient l'île suspendue dans le ciel et fait naître la vie, même la plus étrange."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein magischer Teich: er hält die Insel im Himmel und lässt Leben entstehen, auch das seltsamste."
          }
        }
      }
    },
    "Va a caccia dove saltella la sua cena.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va a caccia dove saltella la sua cena."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It hunts where its dinner hops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Va de caza donde saltalea su cena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle chasse là où sautille son dîner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jagt dort, wo ihr Abendessen hüpft."
          }
        }
      }
    },
    "Va bene. L'isola ti aspetta domani.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Va bene. L'isola ti aspetta domani."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's alright. Your island will wait for you tomorrow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale. Tu isla te espera mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D'accord. Ton île t'attendra demain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut. Die Insel wartet morgen auf dich."
          }
        }
      }
    },
