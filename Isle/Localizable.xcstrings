    "Si muove come se il tempo fosse lento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt sich, als wäre die Zeit langsam."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It moves as if time were slow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mueve como si el tiempo fuera lento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se déplace comme si le temps était lent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si muove come se il tempo fosse lento."
          }
        }
      }
    },
    "Si muove nell'ombra più fitta, senza un rumore. Ti osserva a lungo prima di farsi vedere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt sich im dichtesten Schatten, ohne ein Geräusch. Beobachtet dich lange, bevor es sich zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It moves in the thickest shade, without a sound. It watches you for a long time before showing itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mueve en la sombra más densa, sin un ruido. Te observa largo rato antes de dejarse ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se déplace dans l'ombre la plus dense, sans un bruit. Elle t'observe longtemps avant de se montrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si muove nell'ombra più fitta, senza un rumore. Ti osserva a lungo prima di farsi vedere."
          }
        }
      }
    },
    "Si muove spruzzando acqua, all'indietro. Si nasconde nella conchiglia quando ha paura." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bewegt sich rückwärts, indem er Wasser spritzt. Wenn er Angst hat, versteckt er sich in seinem Gehäuse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It moves backwards by squirting water. It hides in its shell when it's scared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mueve hacia atrás echando chorros de agua. Se esconde en su concha cuando tiene miedo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle avance à reculons en crachant de l'eau. Elle se cache dans sa coquille quand elle a peur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si muove spruzzando acqua, all'indietro. Si nasconde nella conchiglia quando ha paura."
          }
        }
      }
    },
    "Si nasconde nell'erba rossa e spunta all'improvviso. Gli piace fare gli scherzi." : {
