        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiriamo"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's breathe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respiremos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respirons"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass uns atmen"
          }
        }
      }
    },
    "Resta fermo nell'acqua bassa anche per un'ora. Poi scatta col becco, e non sbaglia quasi mai.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta fermo nell'acqua bassa anche per un'ora. Poi scatta col becco, e non sbaglia quasi mai."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays still in the shallows for a whole hour. Then it strikes with its beak, and it almost never misses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda quieto en el agua baja hasta una hora. Luego dispara con el pico, y casi nunca falla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il reste immobile dans l'eau basse pendant une heure. Puis il frappe du bec, et il ne rate presque jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt eine ganze Stunde still im seichten Wasser. Dann schnellt der Schnabel, und er trifft fast immer."
          }
        }
      }
    },
    "Resta sospesa davanti ai fiori battendo le ali velocissime. Beve il nettare con una proboscide lunga quanto lei.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta sospesa davanti ai fiori battendo le ali velocissime. Beve il nettare con una proboscide lunga quanto lei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It hangs in front of the flowers, beating its wings very fast. It drinks the nectar with a tongue as long as itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda suspendida frente a las flores batiendo las alas rapidísimo. Bebe el néctar con una trompa tan larga como ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle reste suspendue devant les fleurs en battant des ailes très vite. Elle boit le nectar avec une trompe aussi longue qu'elle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwebt vor den Blumen und schlägt die Flügel ganz schnell. Trinkt den Nektar mit einem Rüssel so lang wie sie selbst."
          }
        }
      }
    },
