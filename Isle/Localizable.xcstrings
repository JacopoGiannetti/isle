    "Corre a zig zag e infila il naso dappertutto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es rennt im Zickzack und steckt die Nase überall hinein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs in zigzags and pokes its nose everywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre en zigzag y mete la nariz en todas partes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court en zigzag et fourre son nez partout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre a zig zag e infila il naso dappertutto."
          }
        }
      }
    },
    "Corre a zig zag nel grano, più veloce del vento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er rennt im Zickzack durch den Weizen, schneller als der Wind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It zigzags through the wheat, faster than the wind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre en zigzag por el trigo, más rápida que el viento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court en zigzag dans le blé, plus vite que le vent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre a zig zag nel grano, più veloce del vento."
          }
        }
      }
    },
    "Corre come uno struzzo, ma più veloce." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er rennt wie ein Strauß, nur schneller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs like an ostrich, but faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre como un avestruz, pero más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court comme une autruche, mais plus vite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre come uno struzzo, ma più veloce."
          }
        }
      }
    },
    "Corre con la coda dritta come un'antenna." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es rennt mit kerzengeradem Schwanz, wie eine Antenne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs with its tail straight up like an antenna."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre con la cola tiesa como una antena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court la queue dressée comme une antenne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre con la coda dritta come un'antenna."
          }
        }
      }
    },
    "Corre dietro alla gallina pigolando. Quando ha sonno, si infila sotto le sue ali." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es läuft piepsend hinter dem Huhn her. Wenn es müde ist, kriecht es unter seine Flügel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs after the hen, cheeping. When it's sleepy, it tucks itself under her wings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre detrás de la gallina piando. Cuando tiene sueño, se mete bajo sus alas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court derrière la poule en piaillant. Quand il a sommeil, il se glisse sous ses ailes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre dietro alla gallina pigolando. Quando ha sonno, si infila sotto le sue ali."
          }
        }
      }
    },
    "Corre intorno al tronco d'opale e le sue piume cambiano colore. Nessuno sa dire di che colore sia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er rennt um den Opalstamm, und seine Federn wechseln die Farbe. Niemand kann sagen, welche Farbe er hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs around the opal log and its feathers change color. No one can say what color it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre alrededor del tronco de ópalo y sus plumas cambian de color. Nadie sabe decir de qué color es."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court autour du tronc d'opale et ses plumes changent de couleur. Personne ne sait dire de quelle couleur il est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre intorno al tronco d'opale e le sue piume cambiano colore. Nessuno sa dire di che colore sia."
          }
        }
      }
    },
    "Corre nei campi solo per il gusto di correre." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es rennt über die Felder, nur aus Freude am Rennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs through the fields just for the joy of running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre por los campos solo por el gusto de correr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court dans les champs juste pour le plaisir de courir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre nei campi solo per il gusto di correre."
          }
        }
      }
    },
    "Corre nel grano tra i papaveri e si ferma di colpo, con le orecchie dritte." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er rennt zwischen dem Mohn durch den Weizen und bleibt plötzlich stehen, die Ohren gespitzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs through the wheat among the poppies and stops suddenly, ears up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre por el trigo entre las amapolas y se para de golpe, con las orejas tiesas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court dans le blé parmi les coquelicots et s'arrête net, les oreilles dressées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre nel grano tra i papaveri e si ferma di colpo, con le orecchie dritte."
          }
        }
      }
    },
    "Corre solo quando c'è la luna, e lascia impronte che brillano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er läuft nur, wenn der Mond scheint, und hinterlässt leuchtende Spuren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only runs when the moon is out, and leaves glowing tracks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo corre cuando hay luna, y deja huellas que brillan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne court que quand la lune est là, et laisse des traces qui brillent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre solo quando c'è la luna, e lascia impronte che brillano."
          }
        }
      }
    },
    "Corre su e giù per i tronchi tutto il giorno. Nasconde ghiande ovunque e ne ritrova solo la metà." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rennt den ganzen Tag die Stämme hinauf und hinunter. Versteckt überall Eicheln und findet nur die Hälfte wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs up and down the trunks all day. It hides acorns everywhere and only finds half of them again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre arriba y abajo por los troncos todo el día. Esconde bellotas por todas partes y solo encuentra la mitad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court de haut en bas le long des troncs toute la journée. Il cache des glands partout et n'en retrouve que la moitié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre su e giù per i tronchi tutto il giorno. Nasconde ghiande ovunque e ne ritrova solo la metà."
          }
        }
      }
    },
    "Corre sulla prateria a tutta velocità. Poi si ferma di colpo e si guarda intorno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er rennt mit voller Geschwindigkeit über die Steppe. Dann bleibt er plötzlich stehen und schaut sich um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It races across the grassland at full speed. Then it stops suddenly and looks around."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre por la pradera a toda velocidad. Luego se para de golpe y mira a su alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle court dans la prairie à toute vitesse. Puis elle s'arrête net et regarde autour d'elle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre sulla prateria a tutta velocità. Poi si ferma di colpo e si guarda intorno."
          }
        }
      }
    },
    "Corre sulla tundra con il branco. Al tramonto ulula, e tutta l'isola ascolta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er läuft mit dem Rudel über die Tundra. Bei Sonnenuntergang heult er, und die ganze Insel hört zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs across the tundra with the pack. At sunset it howls, and the whole island listens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre por la tundra con la manada. Al atardecer aúlla, y toda la isla escucha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court sur la toundra avec la meute. Au coucher du soleil, il hurle, et toute l'île écoute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre sulla tundra con il branco. Al tramonto ulula, e tutta l'isola ascolta."
          }
        }
      }
    },
    "Corre tra i fiori d'aurora e la coda lascia una scia colorata nel cielo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er läuft zwischen den Polarlichtblumen, und sein Schwanz zieht eine bunte Spur über den Himmel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It runs among the aurora flowers, and its tail leaves a colored trail in the sky."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre entre las flores de aurora y su cola deja una estela de colores en el cielo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court parmi les fleurs d'aurore, et sa queue laisse une traînée colorée dans le ciel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre tra i fiori d'aurora e la coda lascia una scia colorata nel cielo."
          }
        }
      }
    },
    "Corre tra le felci a caccia di insetti. Non sta fermo nemmeno quando dorme." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er flitzt auf Insektenjagd durch die Farne. Nicht mal im Schlaf hält er still."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It darts through the ferns hunting insects. It can't keep still, even in its sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre entre los helechos cazando insectos. No se está quieto ni cuando duerme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court entre les fougères à la chasse aux insectes. Il ne tient pas en place, même en dormant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre tra le felci a caccia di insetti. Non sta fermo nemmeno quando dorme."
          }
        }
      }
    },
    "Corre tra le felci d'ambra, sempre di fretta. Al sole sembra fatto di miele." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er flitzt zwischen den Bernsteinfarnen herum, immer in Eile. In der Sonne sieht er aus wie aus Honig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It darts among the amber ferns, always in a hurry. In the sun it looks made of honey."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre entre los helechos de ámbar, siempre con prisa. Al sol parece hecho de miel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court entre les fougères d'ambre, toujours pressé. Au soleil, on dirait qu'il est fait de miel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre tra le felci d'ambra, sempre di fretta. Al sole sembra fatto di miele."
          }
        }
      }
    },
    "Corre tra le radici dell'abete e fa scorta di semi per l'inverno. Se lo guardi, si ferma e muove i baffi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie huscht zwischen den Wurzeln der Tanne und legt Samen für den Winter an. Wenn du sie ansiehst, bleibt sie stehen und wackelt mit den Schnurrhaaren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It scurries among the fir's roots and stores seeds for winter. If you look at it, it stops and twitches its whiskers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corretea entre las raíces del abeto y guarda semillas para el invierno. Si lo miras, se para y mueve los bigotes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il court entre les racines du sapin et fait des réserves de graines pour l'hiver. Si tu le regardes, il s'arrête et remue ses moustaches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corre tra le radici dell'abete e fa scorta di semi per l'inverno. Se lo guardi, si ferma e muove i baffi."
          }
        }
      }
    },
