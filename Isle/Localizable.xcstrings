    "Conta le pecore tutto il giorno. Non si addormenta mai." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zählt den ganzen Tag Schafe. Er schläft nie ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It counts sheep all day. It never falls asleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta ovejas todo el día. Nunca se duerme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il compte les moutons toute la journée. Il ne s'endort jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta le pecore tutto il giorno. Non si addormenta mai."
          }
        }
      }
    },
