            "state" : "translated",
            "value" : "It pecks the star apples and makes them ring like little bells."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picotea las manzanas de las estrellas y las hace sonar como campanillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle picore les pommes des étoiles et les fait sonner comme des clochettes."
