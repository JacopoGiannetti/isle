    "Cento giorni per piantarla. Cento milioni di anni per crescerla." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hundert Tage, um ihn zu pflanzen. Hundert Millionen Jahre, um ihn großzuziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hundred days to plant it. A hundred million years to grow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cien días para plantarlo. Cien millones de años para que crezca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cent jours pour la planter. Cent millions d'années pour la faire pousser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cento giorni per piantarla. Cento milioni di anni per crescerla."
          }
        }
      }
    },
