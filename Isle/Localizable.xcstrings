    "Entra ed esce dalle casette della betulla come se fossero tutte sue. Il suo verso fa \"up-up-up\".": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra ed esce dalle casette della betulla come se fossero tutte sue. Il suo verso fa \"up-up-up\"."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It comes and goes from the birch's little houses as if they were all its own. Its call goes \"up-up-up\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra y sale de las casitas del abedul como si fueran todas suyas. Su canto hace \"up-up-up\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle entre et sort des petites maisons du bouleau comme si elles étaient toutes à elle. Son cri fait « up-up-up »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt und geht in den Häuschen der Birke, als gehörten sie alle ihr. Ihr Ruf klingt «up-up-up»."
          }
        }
      }
    },
    "Era un cratere. Ora è uno stagno.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Era un cratere. Ora è uno stagno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was a crater. Now it's a pond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Era un cráter. Ahora es un estanque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était un cratère. Maintenant c'est un étang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es war ein Krater. Jetzt ist es ein Teich."
          }
        }
      }
    },
