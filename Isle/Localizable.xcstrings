    "Torna ogni primavera nello stesso nido." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Frühling kehrt sie ins selbe Nest zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every spring it comes back to the same nest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada primavera vuelve al mismo nido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque printemps, elle revient au même nid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna ogni primavera nello stesso nido."
          }
        }
      }
    },
    "Torna sempre nello stesso nido." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehrt immer ins selbe Nest zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It always comes back to the same nest."
          }
        },
        "es" : {
