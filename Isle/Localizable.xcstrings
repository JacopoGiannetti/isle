    "Enorme, ma per i lamponi diventa delicatissimo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesig, aber bei Moltebeeren wird er ganz sanft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huge, but with cloudberries it turns oh so gentle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enorme, pero con las moras se vuelve delicadísimo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Énorme, mais pour les plaquebières il devient tout délicat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enorme, ma per i lamponi diventa delicatissimo."
          }
        }
      }
    },
    "Entra ed esce dalle casette della betulla come se fossero tutte sue. Il suo verso fa \"up-up-up\"." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommt und geht in den Häuschen der Birke, als gehörten sie alle ihr. Ihr Ruf klingt «up-up-up»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It comes and goes from the birch's little houses as if they were all its own. Its call goes \"up-up-up\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra y sale de las casitas del abedul como si fueran todas suyas. Su canto hace \"up-up-up\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle entre et sort des petites maisons du bouleau comme si elles étaient toutes à elle. Son cri fait « up-up-up »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entra ed esce dalle casette della betulla come se fossero tutte sue. Il suo verso fa \"up-up-up\"."
          }
        }
      }
    },
