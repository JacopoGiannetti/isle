    "Torri, finestrelle e corridoi: un vero castello." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Türme, Fensterchen und Gänge: ein echtes Schloss."
