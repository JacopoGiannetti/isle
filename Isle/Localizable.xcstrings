            "value" : "It sings in the evening, at the top of its lungs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta por la tarde, a grito pelado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle chante le soir, à tue-tête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta di sera, a squarciagola."
          }
