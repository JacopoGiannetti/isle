    "Basta segnare «Fatto» per far tornare il sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe einfach auf „Erledigt“, damit die Sonne zurückkommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just mark \"Done\" to bring the sun back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta marcar «Hecho» para que vuelva el sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suffit de toucher « C'est fait » pour faire revenir le soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta segnare «Fatto» per far tornare il sole."
          }
        }
      }
    },
    "Basta una risposta per far tornare il sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Antwort genügt, damit die Sonne zurückkommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One answer is enough to bring the sun back."
          }
        },
        "es" : {
