          "stringUnit" : {
            "state" : "translated",
            "value" : "Il porte bonheur, si c'est toi qui le trouves."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta fortuna, se lo trovi tu."
          }
