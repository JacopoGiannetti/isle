    "C'è da quando è nata l'isola" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist da, seit die Insel geboren wurde"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's been here since the island was born"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está desde que nació la isla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est là depuis la naissance de l'île"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è da quando è nata l'isola"
          }
        }
      }
    },
    "C'è il temporale sulla tua isola. Rispondi: il cielo si apre subito." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über deiner Insel liegt ein Gewitter. Antworte: der Himmel öffnet sich sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's a storm on your island. Answer: the sky clears at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una tormenta en tu isla. Responde: el cielo se abre enseguida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a un orage sur ton île. Réponds : le ciel s'ouvre tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è il temporale sulla tua isola. Rispondi: il cielo si apre subito."
          }
        }
      }
    },
    "C'è l'aurora sulla tua isola" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über deiner Insel liegt ein Polarlicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's an aurora over your island"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay aurora en tu isla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a une aurore sur ton île"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'è l'aurora sulla tua isola"
          }
        }
      }
    },
    "Caccia solo dove sente zampettare sotto la neve." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er jagt nur, wo er unter dem Schnee Trippeln hört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only hunts where it hears little feet under the snow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo caza donde oye corretear bajo la nieve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne chasse que là où il entend trottiner sous la neige."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caccia solo dove sente zampettare sotto la neve."
          }
        }
      }
    },
    "Cade un meteorite sull'isola e i giorni di fila ripartono da zero. Il cratere col tempo diventa uno stagno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Meteorit fällt auf die Insel, und deine Serie beginnt bei null. Mit der Zeit wird der Krater zum Teich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meteorite falls on the island and your streak starts over from zero. In time, the crater becomes a pond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cae un meteorito en la isla y la racha vuelve a cero. Con el tiempo, el cráter se convierte en un estanque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une météorite tombe sur l'île et ta série repart de zéro. Avec le temps, le cratère devient un étang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cade un meteorite sull'isola e i giorni di fila ripartono da zero. Il cratere col tempo diventa uno stagno."
          }
        }
      }
    },
    "Cade un meteorite sull'isola e i giorni puliti ripartono da zero. Il cratere col tempo diventa uno stagno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Meteorit fällt auf die Insel, und die sauberen Tage beginnen bei null. Mit der Zeit wird der Krater zum Teich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A meteorite falls on the island and the clean days start over from zero. In time, the crater becomes a pond."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cae un meteorito en la isla y los días limpios vuelven a cero. Con el tiempo, el cráter se convierte en un estanque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une météorite tombe sur l'île et les jours sans accroc repartent de zéro. Avec le temps, le cratère devient un étang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cade un meteorite sull'isola e i giorni puliti ripartono da zero. Il cratere col tempo diventa uno stagno."
          }
        }
      }
    },
