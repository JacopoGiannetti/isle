    "Piante, animali e giorni andranno persi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piante, animali e giorni andranno persi."
          }
        },
        "en": {
