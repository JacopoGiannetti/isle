    "Infila il becco ricurvo nei fiori dell'aloe. Si ferma a mezz'aria come un colibrì." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steckt seinen gebogenen Schnabel in die Aloeblüten. Er schwebt in der Luft wie ein Kolibri."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It dips its curved beak into the aloe flowers. It hovers in mid-air like a hummingbird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mete el pico curvo en las flores del aloe. Se queda suspendido en el aire como un colibrí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plonge son bec courbé dans les fleurs d'aloès. Il fait du surplace comme un colibri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Infila il becco ricurvo nei fiori dell'aloe. Si ferma a mezz'aria come un colibrì."
          }
        }
      }
    },
