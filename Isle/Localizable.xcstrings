    "Scava gallerie lunghissime con tante uscite. Esce solo di notte e conosce ogni sentiero a memoria." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gräbt sehr lange Gänge mit vielen Ausgängen. Kommt nur nachts heraus und kennt jeden Pfad auswendig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It digs very long tunnels with many exits. It only comes out at night and knows every path by heart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cava galerías larguísimas con muchas salidas. Sale solo de noche y conoce cada sendero de memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il creuse de très longs tunnels avec plein de sorties. Il ne sort que la nuit et connaît chaque sentier par cœur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scava gallerie lunghissime con tante uscite. Esce solo di notte e conosce ogni sentiero a memoria."
          }
        }
      }
    },
    "Scava gallerie lunghissime." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gräbt sehr lange Gänge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It digs very long tunnels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cava galerías larguísimas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il creuse de très longs tunnels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scava gallerie lunghissime."
          }
        }
      }
    },
    "Scava gallerie nella balla di fieno e sbuca da un buco all'altro. Fa un balletto quando è contento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gräbt Gänge in den Heuballen und taucht mal aus einem, mal aus dem anderen Loch auf. Wenn es froh ist, tanzt es ein bisschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It digs tunnels in the hay bale and pops out of one hole after another. It does a little dance when it's happy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excava túneles en la paca de heno y asoma por un agujero y por otro. Hace un bailecito cuando está contento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il creuse des galeries dans la botte de foin et surgit d'un trou à l'autre. Il fait une petite danse quand il est content."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scava gallerie nella balla di fieno e sbuca da un buco all'altro. Fa un balletto quando è contento."
          }
        }
      }
    },
    "Scava gallerie sotto la neve, tra i licheni. Non sta fermo un secondo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er gräbt Gänge unter dem Schnee, zwischen den Flechten. Er hält keine Sekunde still."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It digs tunnels under the snow, among the lichens. It never sits still for a second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excava túneles bajo la nieve, entre los líquenes. No se está quieto ni un segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il creuse des galeries sous la neige, parmi les lichens. Il ne tient pas en place une seconde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scava gallerie sotto la neve, tra i licheni. Non sta fermo un secondo."
          }
        }
      }
    },
    "Scava nel termitaio-castello tutta la notte. Di giorno dorme nella sua tana." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gräbt die ganze Nacht im Termitenpalast. Tagsüber schläft es in seinem Bau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It digs in the termite castle all night. By day, it sleeps in its burrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excava en el termitero castillo toda la noche. De día duerme en su madriguera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il creuse dans le château de termites toute la nuit. Le jour, il dort dans son terrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scava nel termitaio-castello tutta la notte. Di giorno dorme nella sua tana."
          }
        }
      }
    },
    "Scava nella neve per trovare le foglie. Corre a balzi lunghissimi, quasi in piedi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er gräbt im Schnee nach Blättern. Er rennt mit riesigen Sprüngen, fast aufrecht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It digs in the snow to find leaves. It runs in huge leaps, almost standing up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escarba en la nieve para encontrar hojas. Corre a saltos larguísimos, casi de pie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il creuse la neige pour trouver des feuilles. Il court à très grands bonds, presque debout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scava nella neve per trovare le foglie. Corre a balzi lunghissimi, quasi in piedi."
          }
        }
      }
    },
    "Scava sotto le carote e ne porta via una alla volta. Ha la tana sotto un sasso." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie gräbt unter den Karotten und trägt sie eine nach der anderen weg. Ihr Bau ist unter einem Stein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It digs under the carrots and carries them off one at a time. Its burrow is under a stone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escarba bajo las zanahorias y se lleva una cada vez. Tiene la madriguera bajo una piedra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il creuse sous les carottes et les emporte une par une. Son terrier est sous une pierre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scava sotto le carote e ne porta via una alla volta. Ha la tana sotto un sasso."
          }
        }
      }
    },
    "Scegli il tuo" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
