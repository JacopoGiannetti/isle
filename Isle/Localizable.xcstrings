    "Rumina davanti alla stalla e scaccia le mosche con la coda. Fa muu solo quando ha voglia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie käut vor dem Stall wieder und verscheucht die Fliegen mit dem Schwanz. Sie macht nur Muh, wenn sie Lust hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It chews the cud in front of the barn and swats flies with its tail. It only moos when it feels like it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumia delante del establo y espanta las moscas con la cola. Solo hace muu cuando le apetece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle rumine devant l'étable et chasse les mouches avec sa queue. Elle ne fait meuh que quand elle en a envie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rumina davanti alla stalla e scaccia le mosche con la coda. Fa muu solo quando ha voglia."
          }
        }
      }
    },
