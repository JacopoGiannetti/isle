          }
        }
      }
    },
    "Si posa in cima al bonsai millenario all'alba. Quando apre le ali, il giardino si scalda." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Tagesanbruch setzt er sich auf den tausendjährigen Bonsai. Wenn er die Flügel öffnet, wird der Garten warm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It perches on top of the thousand-year bonsai at dawn. When it opens its wings, the garden warms up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa en lo alto del bonsái milenario al amanecer. Cuando abre las alas, el jardín se calienta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se pose au sommet du bonsaï millénaire à l'aube. Quand il ouvre les ailes, le jardin se réchauffe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa in cima al bonsai millenario all'alba. Quando apre le ali, il giardino si scalda."
          }
        }
      }
    },
    "Si posa in cima al kopje e lancia il suo richiamo. Pesca nella pozza con un colpo solo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er landet oben auf dem Kopje und stößt seinen Ruf aus. In der Wasserstelle fischt er mit einem einzigen Griff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It perches on top of the kopje and gives its call. It fishes in the waterhole in a single swoop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa en lo alto del kopje y lanza su grito. Pesca en la charca de un solo golpe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se pose au sommet du kopje et lance son cri. Il pêche dans le point d'eau d'un seul coup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa in cima al kopje e lancia il suo richiamo. Pesca nella pozza con un colpo solo."
          }
        }
      }
    },
    "Si posa in cima alla scogliera dei nidi. Vola basso sul ghiaccio, velocissimo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
