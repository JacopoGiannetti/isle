    },
    "Ogni \"sì\" ti dà un seme da piantare.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni \"sì\" ti dà un seme da piantare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every \"yes\" gives you a seed to plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada \"sí\" te da una semilla para plantar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque « oui » te donne une graine à planter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes „Ja“ gibt dir einen Samen zum Pflanzen."
          }
        }
      }
    },
    "Ogni abitudine ha il suo habitat.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni abitudine ha il suo habitat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every habit has its habitat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hábito tiene su hábitat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque habitude a son habitat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Gewohnheit hat ihren Lebensraum."
          }
        }
      }
    },
    "Ogni giorno": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Tag"
          }
        }
      }
    },
    "Ogni giorno in cui ce la fai, la tua isola cresce.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giorno in cui ce la fai, la tua isola cresce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day you make it, your island grows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día que lo logras, tu isla crece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour où tu y arrives, ton île grandit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Tag, an dem du es schaffst, wächst deine Insel."
          }
        }
      }
    },
    "Ogni pianta attira certi animali. Nel Sentiero vedi quali.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni pianta attira certi animali. Nel Sentiero vedi quali."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each plant attracts certain animals. You can see which on the Path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada planta atrae a ciertos animales. En el Sendero ves cuáles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque plante attire certains animaux. Sur le Sentier, tu vois lesquels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Pflanze lockt bestimmte Tiere an. Auf dem Pfad siehst du, welche."
          }
        }
      }
    },
    "Ogni quanto?": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni quanto?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How often?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cada cuánto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les combien ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie oft?"
          }
        }
      }
    },
    "Ogni tanto un seme sboccia in una variante rara. È l'unico modo per attirare gli animali rari: chissà chi arriverà.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tanto un seme sboccia in una variante rara. È l'unico modo per attirare gli animali rari: chissà chi arriverà."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now and then a seed blooms into a rare variant. It's the only way to lure rare animals: who knows who will come."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez en cuando una semilla florece en una variante rara. Es la única forma de atraer a los animales raros: quién sabe quién llegará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfois une graine s'ouvre en une variante rare. C'est la seule façon d'attirer les animaux rares : on ne sait jamais qui viendra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab und zu blüht ein Samen zu einer seltenen Variante. Nur so lockst du die seltenen Tiere an: wer weiß, wer kommt."
          }
        }
      }
    },
    "Ogni volta che lo fai vale %@ giorni di cammino. A fine settimana, se hai raggiunto l'obiettivo, sull'isola esce l'arcobaleno.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volta che lo fai vale %@ giorni di cammino. A fine settimana, se hai raggiunto l'obiettivo, sull'isola esce l'arcobaleno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time you do it counts as %@ days of walking. At the end of the week, if you've reached the goal, a rainbow appears on the island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que lo haces vale %@ días de camino. A fin de semana, si has llegado al objetivo, en la isla sale el arcoíris."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fois que tu le fais, ça compte pour %@ jours de marche. En fin de semaine, si tu as atteint l'objectif, l'arc-en-ciel paraît sur l'île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal zählt als %@ Tage Weg. Am Ende der Woche, wenn du das Ziel erreicht hast, erscheint ein Regenbogen auf der Insel."
          }
        }
      }
    },
    "Olivia": {
