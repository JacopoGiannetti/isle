    "Spazza la neve con le zanne per trovare l'erba della tundra. Si muove piano, come una collina." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es fegt den Schnee mit den Stoßzähnen weg, um das Tundragras zu finden. Es bewegt sich langsam, wie ein Hügel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sweeps the snow away with its tusks to find the tundra grass. It moves slowly, like a hill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barre la nieve con los colmillos para encontrar la hierba de la tundra. Se mueve despacio, como una colina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il balaie la neige avec ses défenses pour trouver l'herbe de la toundra. Il avance lentement, comme une colline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazza la neve con le zanne per trovare l'erba della tundra. Si muove piano, come una collina."
          }
        }
      }
    },
