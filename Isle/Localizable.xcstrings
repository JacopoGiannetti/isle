    "Nuvole grigie e luce morbida. Niente di cui preoccuparsi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuvole grigie e luce morbida. Niente di cui preoccuparsi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grey clouds and soft light. Nothing to worry about."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nubes grises y luz suave. Nada de qué preocuparse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuages gris et lumière douce. Rien à craindre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Graue Wolken und weiches Licht. Nichts, worum du dir Sorgen machen musst."
          }
        }
      }
    },
    "Nuvoloso": {
      "extractionState": "manual",
      "localizations": {
