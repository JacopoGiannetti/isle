    "Beve solo l'acqua che sgorga dalla terra." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinkt nur das Wasser, das aus der Erde quillt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It drinks only the water that springs from the earth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe solo el agua que brota de la tierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne boit que l'eau qui jaillit de la terre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beve solo l'acqua che sgorga dalla terra."
          }
        }
      }
    },
    "Beve tra le ninfee blu e le sue strisce brillano nell'acqua." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es trinkt zwischen den blauen Seerosen, und seine Streifen glänzen im Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It drinks among the blue lilies, and its stripes shine in the water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe entre los nenúfares azules y sus rayas brillan en el agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il boit parmi les nénuphars bleus et ses rayures brillent dans l'eau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beve tra le ninfee blu e le sue strisce brillano nell'acqua."
          }
        }
      }
    },
