    "Saltella sotto gli abeti in cerca di semi. Canta anche durante le bufere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hüpft unter den Tannen und sucht Samen. Sie singt sogar im Schneesturm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It hops under the firs looking for seeds. It sings even in snowstorms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brinca bajo los abetos buscando semillas. Canta incluso durante las ventiscas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sautille sous les sapins en quête de graines. Il chante même pendant les tempêtes de neige."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltella sotto gli abeti in cerca di semi. Canta anche durante le bufere."
          }
        }
      }
    },
    "Saltella sui rami del pino con la nuvola. Chiama le altre gazze con un verso allegro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hüpft über die Äste der Kiefer mit der Wolke. Mit einem fröhlichen Ruf ruft sie die anderen Elstern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It hops along the branches of the pine with the cloud. It calls the other magpies with a cheerful cry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta por las ramas del pino con nube. Llama a los demás rabilargos con un grito alegre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle sautille sur les branches du pin au nuage. Elle appelle les autres pies avec un cri joyeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltella sui rami del pino con la nuvola. Chiama le altre gazze con un verso allegro."
          }
        }
      }
    },
    "Saltella tra i rami del melo delle stelle e fa tin tin. Becca le mele finché non suonano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hüpft durch die Äste des Sternenapfelbaums und macht ting ting. Sie pickt an den Äpfeln, bis sie klingen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It hops among the branches of the star apple tree going ting ting. It pecks the apples until they ring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta entre las ramas del manzano de las estrellas y hace tin tin. Picotea las manzanas hasta que suenan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle sautille dans les branches du pommier des étoiles et fait ting ting. Elle picore les pommes jusqu'à ce qu'elles sonnent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltella tra i rami del melo delle stelle e fa tin tin. Becca le mele finché non suonano."
          }
        }
      }
    },
