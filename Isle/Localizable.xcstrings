    },
    "Succede. Cadrà un meteorite sull'isola e i giorni puliti ripartiranno da zero. Il cratere, col tempo, diventerà uno stagno.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Succede. Cadrà un meteorite sull'isola e i giorni puliti ripartiranno da zero. Il cratere, col tempo, diventerà uno stagno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It happens. A meteorite will fall on the island and the clean days will start over from zero. The crater, in time, will become a pond."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa. Caerá un meteorito en la isla y los días limpios volverán a cero. El cráter, con el tiempo, se convertirá en un estanque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça arrive. Une météorite va tomber sur l'île et les jours sans accroc repartiront de zéro. Le cratère, avec le temps, deviendra un étang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es passiert. Ein Meteorit fällt auf die Insel, und die sauberen Tage beginnen bei null. Der Krater wird mit der Zeit zum Teich."
          }
        }
      }
    },
