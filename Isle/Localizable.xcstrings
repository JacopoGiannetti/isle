    "Metà dei fiori vola via e qualche albero secca." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hälfte der Blumen fliegt fort und ein paar Bäume verdorren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half the flowers blow away and a few trees wither."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mitad de las flores sale volando y algunos árboles se secan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La moitié des fleurs s'envole et quelques arbres se dessèchent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metà dei fiori vola via e qualche albero secca."
          }
        }
      }
    },
    "Mette la vela verso la lava e si scalda. Più vecchio dei dinosauri, e lo sa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er dreht sein Segel zur Lava und wärmt sich. Älter als die Dinosaurier, und er weiß es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It turns its sail toward the lava to warm up. Older than the dinosaurs, and it knows it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone la vela hacia la lava y se calienta. Más viejo que los dinosaurios, y lo sabe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tourne sa voile vers la lave et se réchauffe. Plus vieux que les dinosaures, et il le sait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette la vela verso la lava e si scalda. Più vecchio dei dinosauri, e lo sa."
          }
        }
      }
    },
    "Mette le placche al sole per scaldarsi. Mangia piano, e tanto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er hält seine Platten in die Sonne, um sich zu wärmen. Er frisst langsam, und viel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It turns its plates to the sun to warm up. It eats slowly, and a lot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone las placas al sol para calentarse. Come despacio, y mucho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il met ses plaques au soleil pour se réchauffer. Il mange lentement, et beaucoup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette le placche al sole per scaldarsi. Mangia piano, e tanto."
          }
        }
      }
    },
    "Mezzo uccello e mezzo dinosauro, con i denti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halb Vogel, halb Dinosaurier, mit Zähnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Half bird, half dinosaur, with teeth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitad pájaro y mitad dinosaurio, con dientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moitié oiseau, moitié dinosaure, avec des dents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezzo uccello e mezzo dinosauro, con i denti."
          }
        }
      }
    },
    "Mi impegno a far crescere la mia isola, un giorno alla volta. Anche nei giorni difficili." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich verspreche, meine Insel wachsen zu lassen, Tag für Tag. Auch an schweren Tagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promise to grow my island, one day at a time. Even on the hard days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me comprometo a hacer crecer mi isla, un día a la vez. También en los días difíciles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je m'engage à faire grandir mon île, un jour à la fois. Même les jours difficiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi impegno a far crescere la mia isola, un giorno alla volta. Anche nei giorni difficili."
          }
        }
      }
    },
