    "Galleggia nel geyser a pancia in su e rompe le conchiglie con un sasso." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er treibt auf dem Rücken im Geysir und knackt Muscheln mit einem Stein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It floats belly-up in the geyser and cracks shells with a stone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flota en el géiser panza arriba y rompe las conchas con una piedra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle flotte sur le dos dans le geyser et casse des coquillages avec un caillou."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galleggia nel geyser a pancia in su e rompe le conchiglie con un sasso."
          }
        }
      }
    },
    "Galleggia piano nella laguna, girando su se stessa. Le altre ammoniti la seguono." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er treibt langsam in der Lagune und dreht sich um sich selbst. Die anderen Ammoniten folgen ihm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It floats slowly in the lagoon, turning in circles. The other ammonites follow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flota despacio en la laguna, girando sobre sí misma. Las demás amonitas la siguen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle flotte doucement dans le lagon en tournant sur elle-même. Les autres ammonites la suivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galleggia piano nella laguna, girando su se stessa. Le altre ammoniti la seguono."
          }
        }
      }
    },
