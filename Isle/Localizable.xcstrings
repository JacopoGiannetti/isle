        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tok tok tok. Den ganzen Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap tap tap. All day long."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toc toc toc. Todo el día."
          }
        },
        "fr" : {
