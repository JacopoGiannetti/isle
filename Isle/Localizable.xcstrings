    "Raccoglie ghiande e le nasconde sotto l'Abete d'argento. Imita i versi degli altri uccelli, per scherzo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccoglie ghiande e le nasconde sotto l'Abete d'argento. Imita i versi degli altri uccelli, per scherzo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It gathers acorns and hides them under the Silver Fir. It imitates the calls of other birds, for a joke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recoge bellotas y las esconde bajo el Abeto de plata. Imita los cantos de los otros pájaros, por broma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ramasse des glands et les cache sous le Sapin d'argent. Elle imite les cris des autres oiseaux, pour rire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammelt Eicheln und versteckt sie unter der Silbertanne. Ahmt zum Spaß die Rufe der anderen Vögel nach."
          }
        }
      }
    },
