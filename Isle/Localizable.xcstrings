        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only comes close where the night is lit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se acerca donde la noche está iluminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s'approche que là où la nuit est éclairée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si avvicina solo dove la notte è illuminata."
          }
        }
      }
    },
