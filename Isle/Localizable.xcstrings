    "Canta solo quando sta per piovere. Non sbaglia mai." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt nur, wenn es gleich regnet. Er irrt sich nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only sings when it's about to rain. It's never wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo canta cuando va a llover. Nunca se equivoca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne chante que quand il va pleuvoir. Elle ne se trompe jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta solo quando sta per piovere. Non sbaglia mai."
          }
        }
      }
    },
    "Canta solo vicino a un albero dalla corteccia bianca come la neve." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Singt nur neben einem Baum mit Rinde weiß wie Schnee."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only sings near a tree with bark as white as snow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta solo cerca de un árbol de corteza blanca como la nieve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne chante que près d'un arbre à l'écorce blanche comme la neige."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta solo vicino a un albero dalla corteccia bianca come la neve."
          }
        }
      }
    },
    "Canta sott'acqua vicino al buco coi pesci. I baffi si muovono come antenne." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie singt unter Wasser beim Eisloch mit Fischen. Ihre Schnurrhaare bewegen sich wie Antennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings underwater by the fishing hole. Its whiskers move like antennae."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta bajo el agua junto al agujero con peces. Sus bigotes se mueven como antenas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante sous l'eau près du trou aux poissons. Ses moustaches bougent comme des antennes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta sott'acqua vicino al buco coi pesci. I baffi si muovono come antenne."
          }
        }
      }
    },
    "Canta sotto la magnolia in fiore con la sua cresta a elmo. Il coro è sempre stonato." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt mit seinem Helmkamm unter der blühenden Magnolie. Der Chor singt immer schief."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings under the blooming magnolia with its helmet crest. The choir is always out of tune."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta bajo la magnolia en flor con su cresta de casco. El coro siempre desafina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante sous le magnolia en fleurs avec sa crête en casque. Le chœur chante toujours faux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta sotto la magnolia in fiore con la sua cresta a elmo. Il coro è sempre stonato."
          }
        }
      }
    },
    "Canta tra i fiori di mezzanotte un fischio solo, sempre uguale." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischen den Mitternachtsblumen singt sie einen einzigen Pfiff, immer denselben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Among the midnight flowers, it sings a single whistle, always the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta entre las flores de medianoche un solo silbido, siempre igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmi les fleurs de minuit, il chante un seul sifflement, toujours le même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta tra i fiori di mezzanotte un fischio solo, sempre uguale."
          }
        }
      }
    },
    "Canta tra le azalee bianche, e non lo trovi mai." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt zwischen den weißen Azaleen, und man findet ihn nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings among the white azaleas, and you never find it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta entre las azaleas blancas, y nunca lo encuentras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle chante dans les azalées blanches, et on ne la trouve jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta tra le azalee bianche, e non lo trovi mai."
          }
        }
      }
    },
    "Canta tra le azalee bianche. Se ti avvicini, smette e ti guarda." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt zwischen den weißen Azaleen. Wenn du näher kommst, hört er auf und schaut dich an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings among the white azaleas. If you get close, it stops and looks at you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta entre las azaleas blancas. Si te acercas, se calla y te mira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle chante dans les azalées blanches. Si tu t'approches, elle s'arrête et te regarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta tra le azalee bianche. Se ti avvicini, smette e ti guarda."
          }
        }
      }
    },
    "Canta tra le foglie d'oro del salice." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt zwischen den goldenen Blättern der Weide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings among the willow's golden leaves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta entre las hojas de oro del sauce."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante parmi les feuilles d'or du saule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta tra le foglie d'oro del salice."
          }
        }
      }
    },
    "Canta tra le foglie dorate del salice nano. Il berrettino rosso brilla al sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt zwischen den goldenen Blättern der Zwergweide. Sein rotes Mützchen leuchtet in der Sonne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings among the golden leaves of the dwarf willow. Its little red cap shines in the sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta entre las hojas doradas del sauce enano. Su gorrito rojo brilla al sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante parmi les feuilles dorées du saule nain. Son petit bonnet rouge brille au soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta tra le foglie dorate del salice nano. Il berrettino rosso brilla al sole."
          }
        }
      }
    },
    "Canta tra le mele d'oro del melo dorato. Quando canta, tutti si fermano ad ascoltare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt zwischen den goldenen Äpfeln des goldenen Apfelbaums. Wenn er singt, bleiben alle stehen und hören zu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings among the golden apples of the golden apple tree. When it sings, everyone stops to listen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta entre las manzanas de oro del manzano dorado. Cuando canta, todos se paran a escuchar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante parmi les pommes d'or du pommier doré. Quand il chante, tout le monde s'arrête pour écouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta tra le mele d'oro del melo dorato. Quando canta, tutti si fermano ad ascoltare."
          }
        }
      }
    },
    "Canta tra le mele d'oro, e sembra d'oro anche lui." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er singt zwischen den goldenen Äpfeln und wirkt selbst wie aus Gold."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings among the golden apples, and looks golden too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta entre las manzanas de oro, y él también parece de oro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il chante parmi les pommes d'or, et il semble en or lui aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta tra le mele d'oro, e sembra d'oro anche lui."
          }
        }
      }
    },
