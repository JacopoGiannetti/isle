            "state": "translated",
            "value": "One answer a day, at the hour you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una respuesta al día, a la hora que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse par jour, à l'heure que tu choisis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Antwort am Tag, zur Stunde, die du wählst."
          }
        }
