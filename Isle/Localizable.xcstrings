    "Chi lo fa ogni giorno e chi qualche volta a settimana cresce alla stessa velocità." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ob jeden Tag oder ein paar Mal pro Woche: du wächst gleich schnell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether you do it every day or a few times a week, you grow at the same pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien lo hace cada día y quien lo hace unas veces por semana crecen al mismo ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que tu le fasses chaque jour ou quelques fois par semaine, tu grandis au même rythme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi lo fa ogni giorno e chi qualche volta a settimana cresce alla stessa velocità."
          }
        }
      }
    },
