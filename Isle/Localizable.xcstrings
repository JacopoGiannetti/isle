    "Rosicchia i rami di salice per costruire la sua diga. Lavora di notte e fa un baccano incredibile.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosicchia i rami di salice per costruire la sua diga. Lavora di notte e fa un baccano incredibile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It gnaws willow branches to build its dam. It works at night and makes an incredible racket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Roe las ramas de sauce para construir su presa. Trabaja de noche y arma un jaleo increíble."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ronge les branches de saule pour construire son barrage. Il travaille la nuit et fait un bruit du tonnerre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagt Weidenzweige, um seinen Damm zu bauen. Arbeitet nachts und macht einen unglaublichen Lärm."
          }
        }
      }
    },
    "Rosso ovunque, e qualcuno che le assaggia.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosso ovunque, e qualcuno che le assaggia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red everywhere, and someone tasting them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rojo por todas partes, y alguien que las prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du rouge partout, et quelqu'un qui les goûte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rot überall, und jemand, der sie probiert."
          }
        }
      }
    },
