    "Sta ferma su una zampa sola per ore." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht stundenlang still auf einem Bein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stands still on one leg for hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda quieta sobre una pata durante horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle reste immobile sur une patte pendant des heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta ferma su una zampa sola per ore."
          }
        }
      }
    },
    "Sta immerso nel fiume con solo gli occhi fuori. Di notte esce a mangiare l'erba." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es liegt im Fluss, nur die Augen schauen heraus. Nachts kommt es heraus, um Gras zu fressen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays in the river with only its eyes peeking out. At night it comes out to eat the grass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda sumergido en el río con solo los ojos fuera. De noche sale a comer hierba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste plongé dans le fleuve, seuls les yeux dépassent. La nuit, il sort manger l'herbe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta immerso nel fiume con solo gli occhi fuori. Di notte esce a mangiare l'erba."
          }
        }
      }
    },
    "Sta immobile accanto alla sequoia rossa. Se non si muove, non lo vedi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht reglos neben dem roten Mammutbaum. Wenn er sich nicht bewegt, siehst du ihn nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stands still beside the red sequoia. If it doesn't move, you can't see it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda inmóvil junto a la secuoya roja. Si no se mueve, no lo ves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste immobile près du séquoia rouge. S'il ne bouge pas, tu ne le vois pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta immobile accanto alla sequoia rossa. Se non si muove, non lo vedi."
          }
        }
      }
    },
    "Sta immobile tra i fiori di loto e aspetta un pesce. Quando vola, piega il collo a esse." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht reglos zwischen den Lotusblüten und wartet auf einen Fisch. Im Flug biegt er den Hals zu einem S."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stands still among the lotus flowers, waiting for a fish. When it flies, it bends its neck into an S."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda inmóvil entre las flores de loto esperando un pez. Cuando vuela, dobla el cuello en forma de ese."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle reste immobile parmi les lotus et attend un poisson. Quand elle vole, elle plie son cou en S."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta immobile tra i fiori di loto e aspetta un pesce. Quando vola, piega il collo a esse."
          }
        }
      }
    },
    "Sta in piedi a fare la guardia per tutti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es steht aufrecht und hält Wache für alle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stands tall and keeps watch for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pone de pie para vigilar por todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se tient debout et monte la garde pour tous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta in piedi a fare la guardia per tutti."
          }
        }
      }
    },
    "sta nuotando" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "schwimmt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "swimming"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "está nadando"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "est en train de nager"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sta nuotando"
          }
        }
      }
    },
    "Sta seduto accanto alla lanterna e guarda il giardino. Non ha mai fretta di andare via." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sitzt neben der Laterne und schaut in den Garten. Er hat es nie eilig zu gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sits next to the lantern and watches the garden. It's never in a hurry to leave."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sienta junto al farol y mira el jardín. Nunca tiene prisa por irse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste assis près de la lanterne et regarde le jardin. Il n'est jamais pressé de partir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta seduto accanto alla lanterna e guarda il giardino. Non ha mai fretta di andare via."
          }
        }
      }
    },
    "Sta seduto sul bordo della fontana dei desideri con la corona in testa. Aspetta, non si sa chi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sitzt mit der Krone auf dem Kopf am Rand des Wunschbrunnens. Er wartet, man weiß nicht, auf wen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sits on the edge of the wishing fountain with its crown on. It's waiting, though nobody knows for whom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está sentado en el borde de la fuente de los deseos con la corona puesta. Espera, no se sabe a quién."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est assis au bord de la fontaine aux vœux, la couronne sur la tête. Il attend, on ne sait pas qui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta seduto sul bordo della fontana dei desideri con la corona in testa. Aspetta, non si sa chi."
          }
        }
      }
    },
    "Sta su una zampa nel lago rosa. Gli altri fenicotteri lo guardano con invidia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht auf einem Bein im rosa See. Die anderen Flamingos schauen ihn neidisch an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stands on one leg in the pink lake. The other flamingos look at it with envy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda sobre una pata en el lago rosa. Los demás flamencos lo miran con envidia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se tient sur une patte dans le lac rose. Les autres flamants le regardent avec envie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta su una zampa nel lago rosa. Gli altri fenicotteri lo guardano con invidia."
          }
        }
      }
    },
    "Sta su una zampa sola nel lago salato. Mangia a testa in giù, filtrando l'acqua." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht auf einem Bein im Salzsee. Er frisst kopfüber und filtert das Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stands on one leg in the salt lake. It eats upside down, filtering the water."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda sobre una sola pata en el lago salado. Come cabeza abajo, filtrando el agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se tient sur une patte dans le lac salé. Il mange la tête en bas, en filtrant l'eau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta su una zampa sola nel lago salato. Mangia a testa in giù, filtrando l'acqua."
          }
        }
      }
    },
    "Sta sul fondo del ruscello, ferma come un sasso. Esce solo di notte, a passeggiare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er liegt am Grund des Bachs, still wie ein Stein. Nur nachts kommt er heraus, um spazieren zu gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lies on the bottom of the stream, still as a stone. It only comes out at night for a walk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en el fondo del arroyo, quieta como una piedra. Solo sale de noche, a pasear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle reste au fond du ruisseau, immobile comme une pierre. Elle ne sort que la nuit, pour se promener."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta sul fondo del ruscello, ferma come un sasso. Esce solo di notte, a passeggiare."
          }
        }
      }
    },
    "Sta sul sasso più caldo della sorgente a prendere il sole. Quando canta sembra una campanella." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzt auf dem wärmsten Stein der Quelle und sonnt sich. Wenn sie singt, klingt sie wie ein Glöckchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sits on the warmest rock of the spring, sunning itself. When it sings it sounds like a little bell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en la piedra más caliente del manantial tomando el sol. Cuando canta parece una campanita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle est sur la pierre la plus chaude de la source, à prendre le soleil. Quand elle chante, on dirait une clochette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta sul sasso più caldo della sorgente a prendere il sole. Quando canta sembra una campanella."
          }
        }
      }
    },
    "Sta sulla banchisa con la colonia, tutti stretti. Fanno a turno per stare al centro, al caldo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht mit der Kolonie auf dem Packeis, alle eng aneinander. Sie wechseln sich ab, um in der warmen Mitte zu stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stands on the pack ice with the colony, all huddled close. They take turns in the warm middle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está en la banquisa con la colonia, todos apretados. Se turnan para estar en el centro, al calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se tient sur la banquise avec la colonie, tous serrés. Ils se relaient pour être au centre, au chaud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta sulla banchisa con la colonia, tutti stretti. Fanno a turno per stare al centro, al caldo."
          }
        }
      }
    },
    "Sta tra i sassi tiepidi della sorgente. Esce solo dopo la pioggia, quando tutto luccica." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt zwischen den warmen Steinen der Quelle. Kommt nur nach dem Regen heraus, wenn alles glitzert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays among the warm stones of the spring. It only comes out after the rain, when everything glints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está entre las piedras tibias del manantial. Sale solo después de la lluvia, cuando todo brilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle reste parmi les pierres tièdes de la source. Elle ne sort qu'après la pluie, quand tout brille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta tra i sassi tiepidi della sorgente. Esce solo dopo la pioggia, quando tutto luccica."
          }
        }
      }
    },
    "Sta vicino al mulino ad acqua e guarda la ruota che gira. Non si stanca mai di guardarla." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er steht bei der Wassermühle und schaut dem Rad beim Drehen zu. Er wird nie müde, ihm zuzusehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stands by the watermill and watches the wheel turn. It never gets tired of watching it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda junto al molino de agua mirando cómo gira la rueda. Nunca se cansa de mirarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste près du moulin à eau et regarde la roue tourner. Il ne se lasse jamais de la regarder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta vicino al mulino ad acqua e guarda la ruota che gira. Non si stanca mai di guardarla."
          }
        }
      }
    },
    "Sta vicino all'inukshuk con il suo gruppo. Se arriva un pericolo, fanno un cerchio con le corna fuori." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bleibt mit seiner Herde beim Inukshuk. Droht Gefahr, bilden sie einen Kreis, die Hörner nach außen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays near the inukshuk with its herd. If danger comes, they form a circle, horns facing out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está cerca del inukshuk con su grupo. Si llega un peligro, hacen un círculo con los cuernos hacia fuera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste près de l'inukshuk avec son groupe. Si un danger arrive, ils font un cercle, cornes tournées vers l'extérieur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta vicino all'inukshuk con il suo gruppo. Se arriva un pericolo, fanno un cerchio con le corna fuori."
          }
        }
      }
    },
