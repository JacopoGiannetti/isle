            "state" : "translated",
            "value" : "It rests in the shade of the Ancient Oak. When it walks, the other animals stop to watch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa a la sombra del Roble milenario. Cuando camina, los demás animales se paran a mirarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
