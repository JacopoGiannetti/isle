    "Sonnecchia sull'iceberg con la grotta. Quando sbadiglia sembra che sorrida." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er döst auf dem Eisberg mit Höhle. Wenn er gähnt, sieht es aus, als würde er lächeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It dozes on the cave iceberg. When it yawns, it looks like it's smiling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormita sobre el iceberg con cueva. Cuando bosteza parece que sonríe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il somnole sur l'iceberg à la grotte. Quand il bâille, on dirait qu'il sourit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnecchia sull'iceberg con la grotta. Quando sbadiglia sembra che sorrida."
          }
        }
      }
    },
    "Sonnecchia tra il bambù di giada, che lo fa brillare di verde. Si sveglia solo per mangiare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er döst im Jadebambus, der ihn grün schimmern lässt. Er wacht nur zum Fressen auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It dozes in the jade bamboo, which makes it glow green. It only wakes up to eat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dormita entre el bambú de jade, que lo hace brillar de verde. Solo se despierta para comer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il somnole dans le bambou de jade, qui le fait briller de vert. Il ne se réveille que pour manger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnecchia tra il bambù di giada, che lo fa brillare di verde. Si sveglia solo per mangiare."
          }
        }
      }
    },
