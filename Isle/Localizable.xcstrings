    "Ascolta la neve con la testa piegata, poi salta e ci si tuffa dentro. Dorme arrotolata nella coda." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er lauscht mit schiefem Kopf in den Schnee, dann springt er und taucht hinein. Er schläft in seinen Schwanz gerollt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It listens to the snow with its head tilted, then leaps and dives right in. It sleeps curled up in its tail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha la nieve con la cabeza ladeada, luego salta y se zambulle dentro. Duerme enroscado en su cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il écoute la neige, la tête penchée, puis bondit et plonge dedans. Il dort enroulé dans sa queue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta la neve con la testa piegata, poi salta e ci si tuffa dentro. Dorme arrotolata nella coda."
          }
        }
      }
    },
    "Asinelli" : {
      "extractionState" : "manual",
