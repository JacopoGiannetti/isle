    "Se salti un giorno" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Tag auslässt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you skip a day"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te saltas un día"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu sautes un jour"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se salti un giorno"
          }
        }
      }
