    "Il cielo si accende d'arancio e di viola. Dura poco.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cielo si accende d'arancio e di viola. Dura poco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky catches fire in orange and violet. It doesn't last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo se enciende de naranja y violeta. Dura poco."
          }
        },
