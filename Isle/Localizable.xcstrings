    "Stabilire in anticipo quando agire aumenta molto le probabilità di raggiungere un obiettivo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorher festzulegen, wann man handelt, erhöht die Chance deutlich, ein Ziel zu erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deciding in advance when to act greatly increases the chances of reaching a goal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decidir de antemano cuándo actuar aumenta mucho las probabilidades de alcanzar un objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décider à l'avance quand agir augmente nettement les chances d'atteindre un objectif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stabilire in anticipo quando agire aumenta molto le probabilità di raggiungere un obiettivo."
          }
        }
      }
    },
