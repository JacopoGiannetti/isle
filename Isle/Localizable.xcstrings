    "Cammina sotto il larice d'autunno sulle zampe grandi come piatti. Gli piace la neve." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er läuft unter der Herbstlärche auf Pfoten so groß wie Teller. Er mag den Schnee."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It walks under the autumn larch on paws as big as plates. It likes the snow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camina bajo el alerce de otoño con patas grandes como platos. Le gusta la nieve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il marche sous le mélèze d'automne sur des pattes grandes comme des assiettes. Il aime la neige."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cammina sotto il larice d'autunno sulle zampe grandi come piatti. Gli piace la neve."
          }
        }
      }
    },
    "Cammina sotto la felce millenaria quando c'è la luna. Ogni passo è un tuono gentile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er geht unter dem Urfarn spazieren, wenn der Mond scheint. Jeder Schritt ist ein sanfter Donner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It walks beneath the ancient fern when the moon is out. Every step is a gentle thunder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camina bajo el helecho milenario cuando hay luna. Cada paso es un trueno amable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il marche sous la fougère millénaire quand la lune est là. Chaque pas est un tonnerre tout doux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cammina sotto la felce millenaria quando c'è la luna. Ogni passo è un tuono gentile."
          }
        }
      }
    },
    "Cammina sui sassi e muove la coda a tempo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie läuft über die Steine und wippt im Takt mit dem Schwanz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It walks on the stones and wags its tail in time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camina sobre las piedras y mueve la cola al compás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle marche sur les pierres et remue la queue en rythme."
          }
