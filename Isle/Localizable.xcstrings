            "state" : "translated",
            "value" : "Kühl im Sommer, warm im Winter. Wer einen Panzer hat, schläft hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cool in summer, warm in winter. The armored ones sleep here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fresca en verano, tibia en invierno. Quien tiene coraza duerme aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fraîche l'été, tiède l'hiver. Ceux qui ont une carapace y dorment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fresca d'estate, tiepida d'inverno. Chi ha la corazza ci dorme."
          }
        }
      }
    },
