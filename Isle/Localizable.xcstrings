    "Ruba i frutti della marula e li mangia sul ramo più alto. Avvisa gli altri con versi diversi per ogni pericolo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie stibitzt Marulafrüchte und frisst sie auf dem höchsten Ast. Sie warnt die anderen mit einem eigenen Ruf für jede Gefahr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It steals marula fruit and eats it on the highest branch. It warns the others with a different call for every danger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roba los frutos de la marula y se los come en la rama más alta. Avisa a los demás con un grito distinto para cada peligro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vole les fruits de la marula et les mange sur la plus haute branche. Il prévient les autres avec un cri différent pour chaque danger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruba i frutti della marula e li mangia sul ramo più alto. Avvisa gli altri con versi diversi per ogni pericolo."
          }
        }
      }
    },
    "Ruba i frutti e poi fa finta di niente." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie stibitzt Früchte und tut dann ganz unschuldig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It steals fruit, then acts like nothing happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roba la fruta y luego se hace el despistado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vole les fruits puis fait comme si de rien n'était."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruba i frutti e poi fa finta di niente."
          }
        }
      }
    },
    "Ruba tutto quello che luccica, poi lo nasconde nel mulino." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie stiehlt alles, was glänzt, und versteckt es in der Mühle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It steals everything that shines, then hides it in the mill."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roba todo lo que brilla y luego lo esconde en el molino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle vole tout ce qui brille, puis le cache dans le moulin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruba tutto quello che luccica, poi lo nasconde nel mulino."
          }
        }
      }
    },
