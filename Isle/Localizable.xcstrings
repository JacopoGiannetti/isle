    "Picchietta i tronchi per trovare insetti e per farsi sentire. Scava il nido da solo, un colpo alla volta.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Picchietta i tronchi per trovare insetti e per farsi sentire. Scava il nido da solo, un colpo alla volta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It taps the trunks to find insects and to make itself heard. It digs its nest alone, one knock at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Golpetea los troncos para encontrar insectos y para que lo oigan. Cava el nido solo, un golpe cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tapote les troncs pour trouver des insectes et pour se faire entendre. Il creuse son nid tout seul, un coup à la fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klopft an die Stämme, um Insekten zu finden und sich Gehör zu verschaffen. Gräbt das Nest allein, Schlag für Schlag."
          }
        }
      }
    },
    "Picchio": {
      "extractionState": "manual",
      "localizations": {
