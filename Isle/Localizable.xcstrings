    },
    "Corre su e giù per i tronchi tutto il giorno. Nasconde ghiande ovunque e ne ritrova solo la metà.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre su e giù per i tronchi tutto il giorno. Nasconde ghiande ovunque e ne ritrova solo la metà."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It runs up and down the trunks all day. It hides acorns everywhere and only finds half of them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre arriba y abajo por los troncos todo el día. Esconde bellotas por todas partes y solo encuentra la mitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il court de haut en bas le long des troncs toute la journée. Il cache des glands partout et n'en retrouve que la moitié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rennt den ganzen Tag die Stämme hinauf und hinunter. Versteckt überall Eicheln und findet nur die Hälfte wieder."
          }
        }
      }
    },
    "Corteccia": {
