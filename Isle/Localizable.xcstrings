    "Aspetta al guado senza muoversi per ore. Poi fa un inchino a chi passa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wartet stundenlang reglos an der Furt. Dann verbeugt er sich vor jedem, der vorbeikommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It waits at the ford without moving for hours. Then it bows to whoever passes by."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera en el vado sin moverse durante horas. Luego hace una reverencia a quien pasa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il attend au gué sans bouger pendant des heures. Puis il fait une révérence à qui passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta al guado senza muoversi per ore. Poi fa un inchino a chi passa."
          }
        }
      }
    },
    "Aspetta i pesci nel fiume, immobile. Poi si asciuga la vela al sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wartet reglos im Fluss auf Fische. Dann trocknet er sein Segel in der Sonne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It waits for fish in the river, perfectly still. Then it dries its sail in the sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a los peces en el río, inmóvil. Luego se seca la vela al sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il attend les poissons dans la rivière, immobile. Puis il fait sécher sa voile au soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta i pesci nel fiume, immobile. Poi si asciuga la vela al sole."
          }
        }
      }
    },
    "Aspetta i pesci sotto la cascata con una pazienza infinita. Poi si asciuga al sole e si addormenta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wartet mit unendlicher Geduld unter dem Wasserfall auf Fische. Dann trocknet er in der Sonne und schläft ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It waits for fish under the waterfall with endless patience. Then it dries off in the sun and falls asleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera a los peces bajo la cascada con una paciencia infinita. Luego se seca al sol y se queda dormido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il attend les poissons sous la cascade avec une patience infinie. Puis il se sèche au soleil et s'endort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta i pesci sotto la cascata con una pazienza infinita. Poi si asciuga al sole e si addormenta."
          }
        }
      }
    },
    "Aspetta immobile sul ramo sopra la pozza. Poi si tuffa e torna su con un pesciolino." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wartet reglos auf dem Ast über der Wasserstelle. Dann taucht er hinab und kommt mit einem Fischlein zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It waits perfectly still on the branch above the waterhole. Then it dives and comes back up with a little fish."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera inmóvil en la rama sobre la charca. Luego se zambulle y vuelve con un pececito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il attend immobile sur la branche au-dessus du point d'eau. Puis il plonge et remonte avec un petit poisson."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta immobile sul ramo sopra la pozza. Poi si tuffa e torna su con un pesciolino."
          }
        }
      }
    },
    "Aspetta immobile. Poi, zac." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet regungslos. Dann — zack."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It waits, perfectly still. Then — snap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera inmóvil. Luego, zas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il attend, immobile. Puis, zac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta immobile. Poi, zac."
          }
        }
      }
    },
    "Aspetta su un ramo sopra la cascata, immobile. Poi si tuffa come un lampo turchese." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf einem Ast über dem Wasserfall, ganz still. Dann stürzt sie sich hinab wie ein türkiser Blitz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It waits on a branch above the waterfall, perfectly still. Then it dives like a turquoise flash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera en una rama sobre la cascada, inmóvil. Luego se zambulle como un relámpago turquesa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il attend sur une branche au-dessus de la cascade, immobile. Puis il plonge comme un éclair turquoise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta su un ramo sopra la cascata, immobile. Poi si tuffa come un lampo turchese."
          }
        }
      }
    },
    "Aspetta vicino al pozzo che qualcuno tiri su l'acqua. Raglia forte, poi fa finta di niente." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wartet am Brunnen, bis jemand Wasser hochzieht. Es iaht laut und tut dann, als wäre nichts gewesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It waits by the well for someone to draw water. It brays loudly, then acts like nothing happened."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espera junto al pozo a que alguien saque agua. Rebuzna fuerte y luego disimula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il attend près du puits que quelqu'un remonte de l'eau. Il brait fort, puis fait comme si de rien n'était."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspetta vicino al pozzo che qualcuno tiri su l'acqua. Raglia forte, poi fa finta di niente."
          }
        }
      }
    },
