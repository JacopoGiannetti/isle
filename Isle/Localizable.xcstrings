          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter den ersten Blumen der Erde. Davor gab es nur Grün."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Among the first flowers on Earth. Before, there was only green."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre las primeras flores de la Tierra. Antes solo había verde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmi les premières fleurs de la Terre. Avant, il n'y avait que du vert."
