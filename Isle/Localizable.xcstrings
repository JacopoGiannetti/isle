    "Volteggia intorno al ginkgo d'oro. Usa la paletta della coda per sterzare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kreist um den goldenen Ginkgo. Mit der Schaufel am Schwanz lenkt er."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swoops around the golden ginkgo. It uses the paddle on its tail to steer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revolotea alrededor del ginkgo dorado. Usa la paleta de la cola para girar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il virevolte autour du ginkgo doré. Il se sert de la palette de sa queue pour tourner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volteggia intorno al ginkgo d'oro. Usa la paletta della coda per sterzare."
