    "Quando lo fai tocchi «Fatto», a qualsiasi ora." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du es tust, tippst du auf „Erledigt“, zu jeder Uhrzeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you do it, tap \"Done\", at any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando lo hagas, toca «Hecho», a cualquier hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu le fais, touche « C'est fait », à n'importe quelle heure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando lo fai tocchi «Fatto», a qualsiasi ora."
          }
