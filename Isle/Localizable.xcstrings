    "Si copre di fiori del baobab invece che di polvere. Profuma sempre." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bedeckt sich mit Baobabblüten statt mit Staub. Er duftet immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It covers itself in baobab flowers instead of dust. It always smells lovely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cubre de flores de baobab en vez de polvo. Siempre huele de maravilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se couvre de fleurs de baobab au lieu de poussière. Il sent toujours bon."
