    "Pesca nel lago tutti insieme, in cerchio. Porta i pesci nella borsa sotto il becco." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fischt mit allen anderen zusammen im See, im Kreis. Die Fische trägt er im Beutel unter dem Schnabel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fishes in the lake with all the others, in a circle. It carries the fish in the pouch under its beak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca en el lago con todos los demás, en círculo. Lleva los peces en la bolsa bajo el pico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pêche dans le lac avec tous les autres, en cercle. Il porte les poissons dans la poche sous son bec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca nel lago tutti insieme, in cerchio. Porta i pesci nella borsa sotto il becco."
          }
        }
      }
    },
    "Pesca nel ruscello camminando adagio. Quando è contenta, apre le ali e balla." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fischt langsam schreitend im Bach. Wenn er froh ist, breitet er die Flügel aus und tanzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fishes in the stream, walking slowly. When it's happy, it opens its wings and dances."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca en el arroyo caminando despacio. Cuando está contenta, abre las alas y baila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle pêche dans le ruisseau en marchant lentement. Quand elle est contente, elle ouvre les ailes et danse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca nel ruscello camminando adagio. Quando è contenta, apre le ali e balla."
          }
        }
      }
    },
    "Pesca nelle rapide con il suo artiglio. Lascia sempre un pesce per gli altri." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fischt mit seiner Kralle in den Stromschnellen. Er lässt immer einen Fisch für die anderen übrig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fishes in the rapids with its claw. It always leaves a fish for the others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca en los rápidos con su garra. Siempre deja un pez para los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pêche dans les rapides avec sa griffe. Il laisse toujours un poisson pour les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca nelle rapide con il suo artiglio. Lascia sempre un pesce per gli altri."
          }
        }
      }
    },
    "Pesca sotto il ponte, poi si asciuga le ali al sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fischt unter der Brücke und trocknet dann seine Flügel in der Sonne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fishes under the bridge, then dries its wings in the sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca bajo el puente y luego se seca las alas al sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pêche sous le pont, puis sèche ses ailes au soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca sotto il ponte, poi si asciuga le ali al sole."
          }
        }
      }
    },
    "Pesca tra le lastre di ghiaccio con tuffi velocissimi. Difende il nido da chiunque." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie fischt zwischen den Eisschollen mit blitzschnellen Sturzflügen. Sie verteidigt ihr Nest gegen jeden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fishes between the ice sheets with lightning-fast dives. It defends its nest from anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca entre las placas de hielo con zambullidas rapidísimas. Defiende su nido de quien sea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle pêche entre les plaques de glace en plongeant très vite. Elle défend son nid contre tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesca tra le lastre di ghiaccio con tuffi velocissimi. Difende il nido da chiunque."
          }
        }
      }
    },
