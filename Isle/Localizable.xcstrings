    "Nella schermata delle isole, tieni premuta l'isola e accendi o spegni Modalità dura." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte auf dem Inselbildschirm die Insel gedrückt und schalte den Strengen Modus ein oder aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the islands screen, press and hold the island and turn Hard mode on or off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la pantalla de las islas, mantén pulsada la isla y activa o desactiva el Modo duro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l'écran des îles, appuie longuement sur l'île et active ou désactive le Mode strict."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella schermata delle isole, tieni premuta l'isola e accendi o spegni Modalità dura."
          }
        }
      }
    },
    "Nera e gialla, esce quando l'aria è umida." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwarz und gelb, kommt er raus wenn die Luft feucht ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Black and yellow, it comes out when the air is damp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negra y amarilla, sale cuando el aire está húmedo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noire et jaune, elle sort quand l'air est humide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nera e gialla, esce quando l'aria è umida."
          }
        }
      }
    },
