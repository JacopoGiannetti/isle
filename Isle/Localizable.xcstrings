          "stringUnit" : {
            "state" : "translated",
            "value" : "Burbujea despacio y calienta toda la isla. Mejor mirarla de lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bouillonne doucement et réchauffe toute l'île. À regarder de loin."
