    "Viaggia gratis sulla schiena dei giganti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er reist gratis auf dem Rücken der Riesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rides for free on the backs of giants."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaja gratis a lomos de los gigantes."
          }
        },
