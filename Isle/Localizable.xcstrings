    "Petali d'oro. Chiama lo spirito della foresta.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Petali d'oro. Chiama lo spirito della foresta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Golden petals. It calls the forest spirit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pétalos de oro. Llama al espíritu del bosque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pétales d'or. Il appelle l'esprit de la forêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Goldene Blüten. Sie rufen den Waldgeist."
          }
        }
      }
    },
    "Petali rosa che cadono piano. Uno su dieci nasce bianco.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Petali rosa che cadono piano. Uno su dieci nasce bianco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pink petals that fall slowly. One in ten is born white."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pétalos rosa que caen despacio. Uno de cada diez nace blanco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pétales roses qui tombent tout doucement. Un sur dix naît blanc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosa Blüten, die langsam fallen. Eine von zehn wird weiß geboren."
          }
        }
      }
    },
    "Petali rosa scendono dal cielo, piano, da chissà dove.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Petali rosa scendono dal cielo, piano, da chissà dove."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pink petals fall from the sky, slowly, from who knows where."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pétalos rosa caen del cielo, despacio, de quién sabe dónde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des pétales roses descendent du ciel, tout doucement, on ne sait d'où."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosa Blüten fallen langsam vom Himmel, von wer weiß woher."
          }
        }
      }
    },
