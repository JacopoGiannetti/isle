    "Io, %@, mi impegno a far crescere la mia isola, un giorno alla volta. Anche nei giorni difficili." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich, %@, verspreche, meine Insel wachsen zu lassen, Tag für Tag. Auch an schweren Tagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I, %@, promise to grow my island, one day at a time. Even on the hard days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yo, %@, me comprometo a hacer crecer mi isla, un día a la vez. También en los días difíciles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moi, %@, je m'engage à faire grandir mon île, un jour à la fois. Même les jours difficiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Io, %@, mi impegno a far crescere la mia isola, un giorno alla volta. Anche nei giorni difficili."
          }
        }
      }
    },
