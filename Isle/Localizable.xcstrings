    "Becca i lamponi artici e cammina sulla neve con le zampe pelose, come con le ciabatte." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es pickt Moltebeeren und läuft mit seinen flauschigen Füßen über den Schnee, wie in Hausschuhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It pecks at cloudberries and walks on the snow with fluffy feet, like slippers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picotea las moras árticas y camina sobre la nieve con sus patas peludas, como en zapatillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il picore les plaquebières et marche sur la neige avec ses pattes poilues, comme en chaussons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Becca i lamponi artici e cammina sulla neve con le zampe pelose, come con le ciabatte."
          }
        }
      }
    },
    "Becca i lamponi dorati e fa un verso che sembra una risatina." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es pickt die goldenen Moltebeeren und macht einen Laut wie ein Kichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It pecks at the golden cloudberries and makes a sound like a giggle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picotea las moras árticas doradas y hace un sonido que parece una risita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il picore les plaquebières dorées et pousse un cri qui ressemble à un petit rire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Becca i lamponi dorati e fa un verso che sembra una risatina."
          }
        }
      }
    },
    "Becca i semi del pino nuvola e li nasconde nella corteccia. Non ne perde neanche uno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie pickt die Samen der Wolkenkiefer und versteckt sie in der Rinde. Sie verliert keinen einzigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It pecks seeds from the cloud pine and hides them in the bark. It never loses a single one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Picotea las semillas del pino nube y las esconde en la corteza. No pierde ni una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle picore les graines du pin nuage et les cache dans l'écorce. Elle n'en perd pas une seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Becca i semi del pino nuvola e li nasconde nella corteccia. Non ne perde neanche uno."
          }
        }
      }
    },
    "Becca le mele delle stelle e le fa suonare come campanelli." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
