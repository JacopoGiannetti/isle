    "Allunga il collo fino alle nuvole per assaggiarle. Dice che sanno di pioggia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er streckt den Hals bis zu den Wolken, um sie zu kosten. Er sagt, sie schmecken nach Regen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stretches its neck up to the clouds to taste them. It says they taste like rain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estira el cuello hasta las nubes para probarlas. Dice que saben a lluvia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tend le cou jusqu'aux nuages pour les goûter. Il dit qu'ils ont un goût de pluie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allunga il collo fino alle nuvole per assaggiarle. Dice che sanno di pioggia."
          }
        }
      }
    },
    "Allunga il collo verso il cielo e raccoglie le stelle dal baobab. Al mattino le rimette a posto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie streckt den Hals zum Himmel und pflückt die Sterne vom Baobab. Am Morgen hängt sie sie wieder zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stretches its neck to the sky and picks the stars from the baobab. In the morning, it puts them back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estira el cuello hacia el cielo y recoge las estrellas del baobab. Por la mañana las vuelve a poner en su sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle tend le cou vers le ciel et cueille les étoiles du baobab. Le matin, elle les remet en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allunga il collo verso il cielo e raccoglie le stelle dal baobab. Al mattino le rimette a posto."
          }
        }
