    "Ce l'hai fatta. Sulla tua isola sta per nascere qualcosa.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce l'hai fatta. Sulla tua isola sta per nascere qualcosa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You did it. Something is about to bloom on your island."
          }
