    "Ogni 7 giorni di fila, un seme bonus dorato." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle 7 Tage am Stück ein goldener Bonus-Samen."
          }
        },
        "en" : {
          "stringUnit" : {
