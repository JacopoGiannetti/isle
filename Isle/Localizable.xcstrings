    "Raccoglie fili di muschio e li mette al sole ad asciugare. Fischia per avvisare gli altri." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sammelt Moosfäden und legt sie zum Trocknen in die Sonne. Er pfeift, um die anderen zu warnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gathers strands of moss and lays them in the sun to dry. It whistles to warn the others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge hebras de musgo y las pone a secar al sol. Silba para avisar a los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ramasse des brins de mousse et les met à sécher au soleil. Il siffle pour prévenir les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccoglie fili di muschio e li mette al sole ad asciugare. Fischia per avvisare gli altri."
          }
        }
      }
    },
    "Raccoglie ghiande e le nasconde sotto l'Abete d'argento. Imita i versi degli altri uccelli, per scherzo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammelt Eicheln und versteckt sie unter der Silbertanne. Ahmt zum Spaß die Rufe der anderen Vögel nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gathers acorns and hides them under the Silver Fir. It imitates the calls of other birds, for a joke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge bellotas y las esconde bajo el Abeto de plata. Imita los cantos de los otros pájaros, por broma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ramasse des glands et les cache sous le Sapin d'argent. Elle imite les cris des autres oiseaux, pour rire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccoglie ghiande e le nasconde sotto l'Abete d'argento. Imita i versi degli altri uccelli, per scherzo."
          }
        }
      }
    },
    "Raccoglie i gattini del salice e li porta nella tana. Poi va in letargo per mesi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sammelt die Kätzchen der Weide und trägt sie in seinen Bau. Dann hält es monatelang Winterschlaf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gathers the willow's catkins and carries them to its burrow. Then it hibernates for months."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge los amentos del sauce y los lleva a su madriguera. Luego hiberna durante meses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ramasse les chatons du saule et les porte dans son terrier. Puis il hiberne pendant des mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccoglie i gattini del salice e li porta nella tana. Poi va in letargo per mesi."
          }
        }
      }
    },
    "Raccoglie le pigne giganti dell'araucaria. Gioca con lo stegosauro, ma vince sempre lui." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sammelt die Riesenzapfen der Araukarie. Er spielt mit dem Stegosaurus, aber gewinnen tut immer er."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gathers the araucaria's giant cones. It plays with the stegosaurus, but it always wins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge las piñas gigantes de la araucaria. Juega con el estegosaurio, pero siempre gana él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ramasse les pommes de pin géantes de l'araucaria. Il joue avec le stégosaure, mais c'est toujours lui qui gagne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccoglie le pigne giganti dell'araucaria. Gioca con lo stegosauro, ma vince sempre lui."
          }
        }
      }
    },
