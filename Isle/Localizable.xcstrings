    "Si posa su un fiore solo per pochi secondi, poi cambia idea. Al mattino apre le ali al sole per scaldarsi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt sich nur ein paar Sekunden auf eine Blume, dann ändert sie ihre Meinung. Am Morgen öffnet sie die Flügel zur Sonne, um sich zu wärmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lands on a flower for only a few seconds, then changes its mind. In the morning it opens its wings to the sun to warm up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa en una flor solo unos segundos, luego cambia de idea. Por la mañana abre las alas al sol para calentarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se pose sur une fleur quelques secondes seulement, puis elle change d'avis. Le matin elle ouvre ses ailes au soleil pour se réchauffer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa su un fiore solo per pochi secondi, poi cambia idea. Al mattino apre le ali al sole per scaldarsi."
          }
        }
      }
    },
    "Si posa sul cristallo d'ambra e guarda l'isola dall'alto. Quando apre le ali fa ombra a tutti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sitzt auf dem Bernsteinkristall und blickt von oben auf die Insel. Wenn er die Flügel ausbreitet, spendet er allen Schatten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It perches on the amber crystal and watches the island from above. When it spreads its wings, it shades everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa sobre el cristal de ámbar y mira la isla desde arriba. Cuando abre las alas, da sombra a todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se pose sur le cristal d'ambre et regarde l'île d'en haut. Quand il ouvre ses ailes, il fait de l'ombre à tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa sul cristallo d'ambra e guarda l'isola dall'alto. Quando apre le ali fa ombra a tutti."
          }
        }
      }
    },
    "Si posa sul ponte rosso al tramonto. Fa un verso basso e dolce, come una domanda." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er setzt sich bei Sonnenuntergang auf die rote Brücke. Er ruft tief und sanft, wie eine Frage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It perches on the red bridge at sunset. It makes a low, sweet call, like a question."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa en el puente rojo al atardecer. Hace un sonido grave y dulce, como una pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se pose sur le pont rouge au coucher du soleil. Elle pousse un cri grave et doux, comme une question."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa sul ponte rosso al tramonto. Fa un verso basso e dolce, come una domanda."
          }
        }
      }
    },
    "Si posa sull'ulivo carico di olive e guarda tutti con aria severa. Muove la testa su e giù." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sitzt auf dem Olivenbaum voller Oliven und schaut alle streng an. Er nickt mit dem Kopf auf und ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It perches on the olive-laden tree and looks at everyone sternly. It bobs its head up and down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa en el olivo cargado de aceitunas y mira a todos con aire severo. Mueve la cabeza arriba y abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se pose sur l'olivier chargé d'olives et regarde tout le monde d'un air sévère. Elle hoche la tête de haut en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa sull'ulivo carico di olive e guarda tutti con aria severa. Muove la testa su e giù."
          }
        }
      }
    },
    "Si posa sulla punta dell'abete, accanto alla stella. Conta le stelle vere, una per una, fino all'alba." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt sich auf die Spitze der Tanne, neben den Stern. Zählt die echten Sterne, einen nach dem anderen, bis zur Dämmerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It perches on the tip of the fir, next to the star. It counts the real stars, one by one, until dawn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa en la punta del abeto, junto a la estrella. Cuenta las estrellas de verdad, una a una, hasta el alba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se pose au sommet du sapin, à côté de l'étoile. Elle compte les vraies étoiles, une par une, jusqu'à l'aube."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa sulla punta dell'abete, accanto alla stella. Conta le stelle vere, una per una, fino all'alba."
          }
        }
      }
    },
    "Si posa sulle pale del mulino e gira con loro. Nasconde le cose che luccicano sotto il tetto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie setzt sich auf die Flügel der Windmühle und dreht sich mit. Glänzendes versteckt sie unter dem Dach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It perches on the windmill's sails and turns with them. It hides shiny things under the roof."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa en las aspas del molino y gira con ellas. Esconde las cosas que brillan bajo el tejado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se pose sur les ailes du moulin et tourne avec elles. Elle cache ce qui brille sous le toit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa sulle pale del mulino e gira con loro. Nasconde le cose che luccicano sotto il tetto."
          }
        }
      }
    },
    "Si posa sulle punte dell'abete di cristallo e brilla insieme alle stelle." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sitzt auf den Spitzen der Kristalltanne und leuchtet mit den Sternen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It perches on the tips of the crystal fir and shines along with the stars."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se posa en las puntas del abeto de cristal y brilla junto a las estrellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se pose sur les pointes du sapin de cristal et brille avec les étoiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si posa sulle punte dell'abete di cristallo e brilla insieme alle stelle."
          }
        }
      }
    },
    "Si pulisce le piume per ore. Al tramonto corre a perdifiato intorno al tronco." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er putzt stundenlang seine Federn. Bei Sonnenuntergang rennt er atemlos um den Stamm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It cleans its feathers for hours. At sunset it races around the log until it's out of breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se limpia las plumas durante horas. Al atardecer corre sin aliento alrededor del tronco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lisse ses plumes pendant des heures. Au coucher du soleil, il court à perdre haleine autour du tronc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pulisce le piume per ore. Al tramonto corre a perdifiato intorno al tronco."
          }
        }
      }
    },
    "Si riempie, si piega e fa toc. Poi ricomincia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er füllt sich, kippt und macht tock. Dann geht es von vorn los."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It fills up, tips over and goes tock. Then it starts again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se llena, se inclina y hace toc. Luego vuelve a empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se remplit, bascule et fait toc. Puis elle recommence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si riempie, si piega e fa toc. Poi ricomincia."
          }
        }
      }
    },
    "Si riposa sotto i fiori del baobab." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ruht sich unter den Baobabblüten aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rests under the baobab flowers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa bajo las flores del baobab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se repose sous les fleurs du baobab."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si riposa sotto i fiori del baobab."
          }
        }
      }
    },
    "Si rotola nel bagno di fango e poi si addormenta. Russa forte per essere così piccolo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wälzt sich im Schlammbad und schläft dann ein. Für so ein Kleines schnarcht es ganz schön laut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rolls in the mud bath and then falls asleep. It snores loudly for someone so small."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se revuelca en el baño de barro y luego se duerme. Ronca fuerte para ser tan pequeño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se roule dans le bain de boue puis s'endort. Il ronfle fort pour un si petit animal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rotola nel bagno di fango e poi si addormenta. Russa forte per essere così piccolo."
          }
        }
      }
    },
    "Si rotola nel fango rosso e diventa rosa per un po'." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wälzt sich im roten Schlamm und ist danach eine Weile rosa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rolls in the red mud and turns pink for a while."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se revuelca en el barro rojo y se vuelve rosa un rato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se roule dans la boue rouge et devient rose pour un moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rotola nel fango rosso e diventa rosa per un po'."
          }
        }
      }
    },
    "Si rotola nel fango solo se qualcuno gli pulisce la schiena." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wälzt sich nur im Schlamm, wenn ihm jemand den Rücken putzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only rolls in the mud if someone cleans its back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se revuelca en el barro si alguien le limpia la espalda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne se roule dans la boue que si quelqu'un lui nettoie le dos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rotola nel fango solo se qualcuno gli pulisce la schiena."
          }
        }
      }
    },
    "Si rotola nel fango vicino ai pomodori. Grugnisce contento quando trova qualcosa da mangiare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es suhlt sich im Schlamm bei den Tomaten. Es grunzt zufrieden, wenn es etwas zu fressen findet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rolls in the mud near the tomatoes. It grunts happily when it finds something to eat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se revuelca en el barro cerca de los tomates. Gruñe contento cuando encuentra algo de comer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se roule dans la boue près des tomates. Il grogne de joie quand il trouve quelque chose à manger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rotola nel fango vicino ai pomodori. Grugnisce contento quando trova qualcosa da mangiare."
          }
        }
      }
    },
    "Si rotola nella pozza di fango per stare fresco. La bufaga gli fa compagnia sulla schiena." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wälzt sich im Schlammloch, um kühl zu bleiben. Der Madenhacker leistet ihm auf dem Rücken Gesellschaft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rolls in the mud pool to stay cool. The oxpecker keeps it company on its back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se revuelca en la charca de barro para estar fresco. El picabueyes le hace compañía en la espalda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se roule dans la mare de boue pour rester au frais. Le pique-bœuf lui tient compagnie sur le dos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rotola nella pozza di fango per stare fresco. La bufaga gli fa compagnia sulla schiena."
          }
        }
      }
    },
    "Si sa pochissimo" : {
      "extractionState" : "manual",
      "localizations" : {
