    "Appare dove la notte ha un albero che brilla.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Appare dove la notte ha un albero che brilla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It appears where the night has a tree that glows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece donde la noche tiene un árbol que brilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il apparaît là où la nuit a un arbre qui brille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint dort, wo die Nacht einen leuchtenden Baum hat."
          }
        }
      }
    },
    "Apre le pigne d'oro con il becco incrociato, una squama alla volta. Arriva in coppia e canta mentre lavora.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre le pigne d'oro con il becco incrociato, una squama alla volta. Arriva in coppia e canta mentre lavora."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It opens the golden cones with its crossed beak, one scale at a time. It arrives as a pair and sings while it works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre las piñas de oro con el pico cruzado, una escama cada vez. Llega en pareja y canta mientras trabaja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ouvre les pommes d'or avec son bec croisé, une écaille à la fois. Il arrive à deux et chante en travaillant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie öffnet die goldenen Zapfen mit dem gekreuzten Schnabel, Schuppe für Schuppe. Sie kommt als Paar und singt bei der Arbeit."
          }
        }
      }
    },
    "Apri il Sentiero": {
