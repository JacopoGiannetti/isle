    "Dicono porti fortuna a chi lo vede.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicono porti fortuna a chi lo vede."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They say it brings luck to whoever sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicen que trae suerte a quien lo ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On dit qu'il porte bonheur à qui le voit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Man sagt, es bringe Glück dem, der es sieht."
          }
        }
      }
    },
    "Dietro l'acqua si apre una grotta segreta.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dietro l'acqua si apre una grotta segreta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Behind the water, a secret cave opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detrás del agua se abre una cueva secreta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Derrière l'eau s'ouvre une grotte secrète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinter dem Wasser öffnet sich eine geheime Höhle."
          }
        }
      }
    },
    "Diventa albero domani": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diventa albero domani"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes a tree tomorrow"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se convierte en árbol mañana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devient un arbre demain"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird morgen zum Baum"
          }
        }
      }
    },
