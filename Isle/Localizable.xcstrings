    "Guarda l'aurora dal ramo più basso. Gira la testa quasi tutta intorno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schaut vom untersten Ast aufs Polarlicht. Er dreht den Kopf fast ganz herum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It watches the aurora from the lowest branch. It turns its head almost all the way around."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira la aurora desde la rama más baja. Gira la cabeza casi del todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle regarde l'aurore depuis la branche la plus basse. Sa tête fait presque un tour complet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda l'aurora dal ramo più basso. Gira la testa quasi tutta intorno."
          }
        }
      }
    },
    "Guarda la Via Lattea dal baobab. Quando chiude gli occhi si vedono le palpebre rosa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schaut vom Baobab aus auf die Milchstraße. Wenn er die Augen schließt, sieht man seine rosa Lider."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gazes at the Milky Way from the baobab. When it closes its eyes, you can see its pink eyelids."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira la Vía Láctea desde el baobab. Cuando cierra los ojos se ven sus párpados rosas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il regarde la Voie lactée depuis le baobab. Quand il ferme les yeux, on voit ses paupières roses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la Via Lattea dal baobab. Quando chiude gli occhi si vedono le palpebre rosa."
          }
        }
      }
    },
