    "Razzola intorno alla balla di fieno in cerca di semi. Chiacchiera con tutte le altre, tutto il giorno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es scharrt um den Heuballen herum nach Samen. Den ganzen Tag gackert es mit allen anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It scratches around the hay bale looking for seeds. It chats with all the others, all day long."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escarba alrededor de la paca de heno buscando semillas. Charla con todas las demás, todo el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle gratte autour de la botte de foin à la recherche de graines. Elle bavarde avec toutes les autres, toute la journée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razzola intorno alla balla di fieno in cerca di semi. Chiacchiera con tutte le altre, tutto il giorno."
          }
        }
      }
    },
    "Razzola vicino alla balla di fieno dorata. Le sue piume sembrano pelo, morbide come una nuvola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es scharrt neben dem goldenen Heuballen. Seine Federn sehen aus wie Fell, weich wie eine Wolke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It scratches around near the golden hay bale. Its feathers look like fur, soft as a cloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escarba cerca de la paca de heno dorada. Sus plumas parecen pelo, suaves como una nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle gratte près de la botte de foin dorée. Ses plumes ressemblent à du poil, douces comme un nuage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razzola vicino alla balla di fieno dorata. Le sue piume sembrano pelo, morbide come una nuvola."
          }
        }
      }
    },
    "Razzola, chiacchiera, e ogni tanto fa un uovo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es scharrt, gackert und legt ab und zu ein Ei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It scratches around, chatters, and now and then lays an egg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escarba, charla y de vez en cuando pone un huevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle gratte la terre, bavarde, et de temps en temps pond un œuf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razzola, chiacchiera, e ogni tanto fa un uovo."
          }
        }
      }
    },
