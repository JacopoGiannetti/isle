    },
    "Non vola, ma corre più veloce di un'auto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kann nicht fliegen, aber rennt schneller als ein Auto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It can't fly, but it runs faster than a car."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No vuela, pero corre más rápido que un coche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne vole pas, mais court plus vite qu'une voiture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non vola, ma corre più veloce di un'auto."
          }
        }
      }
    },
