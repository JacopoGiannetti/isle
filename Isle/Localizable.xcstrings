    "Apre la coda solo quando nessuno lo guarda. O così dice." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schlägt sein Rad nur, wenn keiner hinsieht. Sagt er jedenfalls."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only opens its tail when nobody's looking. Or so it says."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo abre la cola cuando nadie lo mira. O eso dice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'ouvre sa queue que quand personne ne regarde. Du moins, c'est ce qu'il dit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la coda solo quando nessuno lo guarda. O così dice."
          }
        }
      }
    },
    "Apre la coda tra le ortensie rosa, e sembra un ventaglio di pizzo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schlägt sein Rad zwischen den rosa Hortensien und sieht aus wie ein Spitzenfächer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It opens its tail among the pink hydrangeas, like a lace fan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la cola entre las hortensias rosas, y parece un abanico de encaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ouvre sa queue parmi les hortensias roses, et on dirait un éventail de dentelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la coda tra le ortensie rosa, e sembra un ventaglio di pizzo."
          }
        }
      }
    },
    "Apre la cresta come un ventaglio quando è contenta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er spreizt die Haube wie einen Fächer, wenn er zufrieden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It opens its crest like a fan when it's happy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la cresta como un abanico cuando está contenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ouvre sa huppe comme un éventail quand elle est contente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre la cresta come un ventaglio quando è contenta."
          }
        }
      }
    },
    "Apre le pigne d'oro con il becco incrociato, una squama alla volta. Arriva in coppia e canta mentre lavora." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie öffnet die goldenen Zapfen mit dem gekreuzten Schnabel, Schuppe für Schuppe. Sie kommt als Paar und singt bei der Arbeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It opens the golden cones with its crossed beak, one scale at a time. It arrives as a pair and sings while it works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre las piñas de oro con el pico cruzado, una escama cada vez. Llega en pareja y canta mientras trabaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ouvre les pommes d'or avec son bec croisé, une écaille à la fois. Il arrive à deux et chante en travaillant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre le pigne d'oro con il becco incrociato, una squama alla volta. Arriva in coppia e canta mentre lavora."
          }
        }
      }
    },
