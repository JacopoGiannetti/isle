    "Riposa sul portico della casa del tè. Gli piace annusare il tè, ma non lo beve." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ruht auf der Veranda des Teehauses. Er riecht gern am Tee, trinkt ihn aber nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rests on the porch of the tea house. It likes to sniff the tea, but it doesn't drink it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa en el porche de la casa de té. Le gusta oler el té, pero no se lo bebe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se repose sous le porche de la maison de thé. Il aime renifler le thé, mais il ne le boit pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposa sul portico della casa del tè. Gli piace annusare il tè, ma non lo beve."
          }
        }
      }
    },
    "Riposa sulle ninfee giganti col collo arrotolato. Si sveglia solo per i fiori." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ruht mit eingerolltem Hals auf den Riesenseerosen. Er wacht nur für die Blüten auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rests on the giant water lilies with its neck curled up. It only wakes up for the flowers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa sobre los nenúfares gigantes con el cuello enrollado. Solo se despierta por las flores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se repose sur les nénuphars géants, le cou enroulé. Il ne se réveille que pour les fleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposa sulle ninfee giganti col collo arrotolato. Si sveglia solo per i fiori."
          }
        }
      }
    },
