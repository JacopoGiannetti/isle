    "Dopo la pioggia, un arcobaleno dietro l'isola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la pioggia, un arcobaleno dietro l'isola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the rain, a rainbow behind the island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la lluvia, un arcoíris detrás de la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la pluie, un arc-en-ciel derrière l'île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Regen ein Regenbogen hinter der Insel."
          }
        }
      }
    },
    "Dorme di giorno nel cavo di un albero. Di notte vola senza fare il minimo rumore.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorme di giorno nel cavo di un albero. Di notte vola senza fare il minimo rumore."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sleeps by day in the hollow of a tree. At night it flies without the slightest sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duerme de día en el hueco de un árbol. De noche vuela sin hacer el menor ruido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dort le jour dans le creux d'un arbre. La nuit il vole sans le moindre bruit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schläft am Tag in einer Baumhöhle. Nachts fliegt sie ohne das kleinste Geräusch."
          }
        }
      }
    },
    "Dorme di giorno. Di notte vede tutto.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorme di giorno. Di notte vede tutto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sleeps by day. At night it sees everything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duerme de día. De noche lo ve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dort le jour. La nuit, il voit tout."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schläft am Tag. Nachts sieht sie alles."
          }
        }
      }
    },
    "Dorme nel Tronco fiorito quasi tutto il giorno. Di notte esce a cercare nocciole, poi torna a dormire.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorme nel Tronco fiorito quasi tutto il giorno. Di notte esce a cercare nocciole, poi torna a dormire."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sleeps in the Flowering Log almost all day. At night it comes out to look for hazelnuts, then goes back to sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Duerme en el Tronco en flor casi todo el día. De noche sale a buscar avellanas, luego vuelve a dormir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dort dans le Tronc en fleurs presque toute la journée. La nuit il sort chercher des noisettes, puis il se recouche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schläft fast den ganzen Tag im blühenden Stamm. Nachts kommt er heraus, sucht Haselnüsse, dann schläft er wieder."
          }
        }
      }
    },
    "Dove vuoi piantare %@?": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove vuoi piantare %@?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where do you want to plant %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde quieres plantar %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où veux-tu planter %@ ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo möchtest du %@ pflanzen?"
          }
        }
      }
    },
    "Elegante come un'ombra.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegante come un'ombra."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegant as a shadow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegante como una sombra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élégant comme une ombre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegant wie ein Schatten."
          }
        }
      }
    },
    "Elegante, attento a ogni rumore.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegante, attento a ogni rumore."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegant, alert to every sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegante, atento a cada ruido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élégant, attentif au moindre bruit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegant, auf jedes Geräusch achtend."
          }
        }
      }
    },
