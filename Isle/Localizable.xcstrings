    "Non ruba le uova: le cova. Lo hanno capito tardi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er stiehlt keine Eier: Er brütet sie aus. Das hat man erst spät verstanden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It doesn't steal eggs: it sits on them. Nobody figured that out until later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No roba los huevos: los incuba. Se dieron cuenta tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne vole pas les œufs : il les couve. On l'a compris tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ruba le uova: le cova. Lo hanno capito tardi."
          }
        }
      }
    },
    "Non sono sull'isola e non contano. Tornano quando ritrovano quello che cercavano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind nicht auf der Insel und zählen nicht. Sie kehren zurück, wenn sie finden, was sie suchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They're not on the island and they don't count. They return when they find what they were looking for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No están en la isla y no cuentan. Vuelven cuando encuentran lo que buscaban."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils ne sont pas sur l'île et ils ne comptent pas. Ils reviennent quand ils retrouvent ce qu'ils cherchaient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono sull'isola e non contano. Tornano quando ritrovano quello che cercavano."
          }
        }
      }
    },
    "Non sta ferma un secondo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt keine Sekunde still."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It doesn't stay still for a second."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se está quieta ni un segundo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne tient pas en place une seconde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sta ferma un secondo."
          }
        }
      }
    },
    "Non vedevo i progressi" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe keine Fortschritte gesehen"
