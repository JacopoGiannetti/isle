    "Le api hanno trovato casa, e c'è profumo di miele.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le api hanno trovato casa, e c'è profumo di miele."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bees have found a home, and it smells of honey."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las abejas han encontrado casa, y hay perfume de miel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abeilles ont trouvé une maison, et ça sent le miel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bienen haben ein Zuhause gefunden, und es duftet nach Honig."
          }
        }
      }
    },
    "Le notifiche sono spente: niente promemoria e niente avvisi quando arriva qualcuno.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono spente: niente promemoria e niente avvisi quando arriva qualcuno."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off: no reminders and no alerts when someone arrives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están apagadas: sin recordatorios ni avisos cuando llega alguien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont coupées : pas de rappel, pas d'alerte quand quelqu'un arrive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen sind aus: keine Erinnerungen und keine Hinweise, wenn jemand ankommt."
          }
        }
      }
    },
    "Le piante che cercava non bastavano più": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le piante che cercava non bastavano più"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plants it was looking for were no longer enough"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantas que buscaba ya no bastaban"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les plantes qu'il cherchait ne suffisaient plus"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pflanzen, die es suchte, reichten nicht mehr"
          }
        }
      }
    },
    "Le sue abitudini le scoprirai quando arriverà sulla tua isola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue abitudini le scoprirai quando arriverà sulla tua isola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll discover its habits when it arrives on your island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus hábitos los descubrirás cuando llegue a tu isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu découvriras ses habitudes quand il arrivera sur ton île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Gewohnheiten entdeckst du, wenn es auf deiner Insel ankommt."
          }
        }
      }
    },
    "Le sue ali hanno il colore del cielo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue ali hanno il colore del cielo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its wings are the color of the sky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus alas tienen el color del cielo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ailes ont la couleur du ciel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Flügel haben die Farbe des Himmels."
          }
        }
      }
    },
    "Le sue corna sembrano rami.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue corna sembrano rami."
