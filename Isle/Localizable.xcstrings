    "Raro come la neve ad agosto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selten wie Schnee im August."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rare as snow in August."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raro como la nieve en agosto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rare comme la neige en août."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raro come la neve ad agosto."
          }
        }
      }
    },
    "Raro, fiero, bellissimo." : {
      "extractionState" : "manual",
