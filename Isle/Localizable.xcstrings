    "Porta fortuna, checché se ne dica." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bringt Glück, egal was man sagt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It brings luck, whatever people say."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da buena suerte, digan lo que digan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il porte bonheur, quoi qu'on en dise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta fortuna, checché se ne dica."
          }
        }
      }
    },
    "Porta fortuna, dicono." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringt Glück, sagt man."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It brings luck, they say."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae suerte, dicen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça porte bonheur, paraît-il."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta fortuna, dicono."
          }
