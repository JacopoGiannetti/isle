    "Se ci urli dentro, risponde." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du hineinrufst, antwortet er."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you shout into it, it answers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si gritas dentro, responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu cries dedans, il répond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ci urli dentro, risponde."
          }
        }
      }
    },
    "Se è qualcosa che fai qualche volta a settimana, l'isola si regola da sola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du es ein paar Mal pro Woche tust, stellt sich die Insel von allein ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it's something you do a few times a week, the island adjusts on its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si es algo que haces algunas veces a la semana, la isla se regula sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si c'est quelque chose que tu fais quelques fois par semaine, l'île s'ajuste toute seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è qualcosa che fai qualche volta a settimana, l'isola si regola da sola."
          }
        }
      }
    },
    "Se fai più del previsto, ogni volta in più vale un seme bonus, fino a 2 a settimana." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du mehr machst als geplant, ist jedes zusätzliche Mal einen Bonus-Samen wert, bis zu 2 pro Woche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you do more than planned, each extra time is worth a bonus seed, up to 2 a week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si haces más de lo previsto, cada vez de más vale una semilla extra, hasta 2 por semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu fais plus que prévu, chaque fois en plus vaut une graine bonus, jusqu'à 2 par semaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se fai più del previsto, ogni volta in più vale un seme bonus, fino a 2 a settimana."
          }
        }
      }
    },
