          }
        }
      }
    },
    "Corazzato da capo a coda, ma senza martello." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gepanzert von Kopf bis Schwanz, aber ohne Hammer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Armored from head to tail, but no hammer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acorazado de la cabeza a la cola, pero sin martillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuirassé de la tête à la queue, mais sans marteau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corazzato da capo a coda, ma senza martello."
          }
        }
      }
    },
