    "Nuota in cerchio nel lago dell'aurora, e l'acqua cambia colore al suo passaggio." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt im Kreis im Polarlichtsee, und das Wasser wechselt die Farbe, wo er vorbeikommt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims in circles in the aurora lake, and the water changes color as it passes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en círculos en el lago de la aurora, y el agua cambia de color a su paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage en rond dans le lac de l'aurore, et l'eau change de couleur sur son passage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota in cerchio nel lago dell'aurora, e l'acqua cambia colore al suo passaggio."
          }
        }
      }
    },
    "Nuota in cerchio nella laguna smeraldo. Quando salta lascia una scia verde." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt im Kreis durch die Smaragdlagune. Wenn er springt, hinterlässt er eine grüne Spur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims in circles in the emerald lagoon. When it jumps, it leaves a green trail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en círculos en la laguna esmeralda. Cuando salta, deja una estela verde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nage en rond dans le lagon émeraude. Quand il saute, il laisse un sillage vert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota in cerchio nella laguna smeraldo. Quando salta lascia una scia verde."
          }
        }
      }
    },
    "Nuota intorno alla casetta dello stagno e controlla chi arriva. Se non gli piaci, te lo dice." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schwimmt um das Teichhäuschen und prüft, wer kommt. Wenn sie dich nicht mag, sagt sie es dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims around the little pond house and checks who's coming. If it doesn't like you, it tells you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada alrededor de la casita del estanque y vigila quién llega. Si no le gustas, te lo dice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage autour de la cabane de la mare et surveille qui arrive. Si tu ne lui plais pas, elle te le dit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota intorno alla casetta dello stagno e controlla chi arriva. Se non gli piaci, te lo dice."
          }
        }
      }
    },
    "Nuota nel fiordo con il corno che spunta dall'acqua. A volte incrocia il corno con un amico." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt im Fjord, das Horn ragt aus dem Wasser. Manchmal kreuzt er sein Horn mit einem Freund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims in the fjord with its horn poking out of the water. Sometimes it crosses horns with a friend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en el fiordo con el cuerno asomando del agua. A veces cruza el cuerno con un amigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nage dans le fjord, la corne hors de l'eau. Parfois, il croise sa corne avec celle d'un ami."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota nel fiordo con il corno che spunta dall'acqua. A volte incrocia il corno con un amico."
          }
        }
      }
    },
    "Nuota nel fiordo di cristallo. Il corno brilla come un ghiacciolo al sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt im Kristallfjord. Sein Horn glänzt wie ein Eiszapfen in der Sonne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims in the crystal fjord. Its horn sparkles like an icicle in the sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en el fiordo de cristal. Su cuerno brilla como un carámbano al sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nage dans le fjord de cristal. Sa corne brille comme un glaçon au soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota nel fiordo di cristallo. Il corno brilla come un ghiacciolo al sole."
          }
        }
      }
    },
    "Nuota nel laghetto d'oro e tutte le altre carpe la seguono. Brilla anche sott'acqua." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt im goldenen Teich, und alle anderen Koi folgen ihm. Er glänzt sogar unter Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims in the golden pond and all the other koi follow it. It shines even underwater."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en el estanque dorado y todas las demás carpas la siguen. Brilla incluso bajo el agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage dans le bassin doré et toutes les autres carpes la suivent. Elle brille même sous l'eau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota nel laghetto d'oro e tutte le altre carpe la seguono. Brilla anche sott'acqua."
          }
        }
      }
    },
    "Nuota nel lago e il lago si accende." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt im See, und der See leuchtet auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims in the lake and the lake lights up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en el lago y el lago se enciende."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage dans le lac et le lac s'illumine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota nel lago e il lago si accende."
          }
        }
      }
    },
    "Nuota nello specchio della luna e ne esce asciutto. Quando sbadiglia esce una nuvoletta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt im Mondspiegel und kommt trocken heraus. Wenn er gähnt, kommt ein Wölkchen heraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims in the moon mirror and comes out dry. When it yawns, a little cloud comes out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en el espejo de la luna y sale seco. Cuando bosteza, sale una nubecita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nage dans le miroir de lune et en sort sec. Quand il bâille, un petit nuage s'échappe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota nello specchio della luna e ne esce asciutto. Quando sbadiglia esce una nuvoletta."
          }
        }
      }
    },
    "Nuota nello stagno in fila con le altre. Mette la testa sott'acqua e la coda in su." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schwimmt mit den anderen in einer Reihe im Teich. Sie steckt den Kopf unter Wasser und den Schwanz nach oben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims in the pond in a line with the others. It puts its head underwater and its tail up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada en el estanque en fila con las demás. Mete la cabeza bajo el agua y la cola hacia arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage dans la mare en file avec les autres. Elle met la tête sous l'eau et la queue en l'air."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota nello stagno in fila con le altre. Mette la testa sott'acqua e la coda in su."
          }
        }
      }
    },
    "Nuota piano nel laghetto e viene a galla quando qualcuno si affaccia. Apre la bocca per salutare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schwimmt langsam im Teich und kommt hoch, wenn sich jemand darüberbeugt. Er öffnet das Maul zum Gruß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims slowly in the pond and comes up when someone leans over. It opens its mouth to say hello."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada despacio en el estanque y sale a la superficie cuando alguien se asoma. Abre la boca para saludar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage doucement dans le bassin et remonte quand quelqu'un se penche. Elle ouvre la bouche pour dire bonjour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota piano nel laghetto e viene a galla quando qualcuno si affaccia. Apre la bocca per salutare."
          }
        }
      }
    },
    "Nuota sul dorso e gioca con i sassi. Scivola giù dalla riva solo per il gusto di farlo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwimmt auf dem Rücken und spielt mit Steinen. Rutscht nur zum Spaß das Ufer hinab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims on its back and plays with pebbles. It slides down the bank just for the pleasure of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de espaldas y juega con las piedras. Se desliza por la orilla solo por el gusto de hacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage sur le dos et joue avec les cailloux. Elle glisse de la rive juste pour le plaisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota sul dorso e gioca con i sassi. Scivola giù dalla riva solo per il gusto di farlo."
          }
        }
      }
    },
    "Nuota tra i fiori della tundra con le altre oche. Fa un baccano allegro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schwimmt mit den anderen Gänsen zwischen den Tundrablumen. Sie macht fröhlichen Lärm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims among the tundra flowers with the other geese. It makes a cheerful racket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada entre las flores de la tundra con los otros ánsares. Arma un alboroto alegre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage parmi les fleurs de la toundra avec les autres oies. Elle fait un joyeux vacarme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota tra i fiori della tundra con le altre oche. Fa un baccano allegro."
          }
        }
      }
    },
    "Nuota tra le ninfee come una barchetta d'oro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schwimmt zwischen den Seerosen wie ein goldenes Bötchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims among the water lilies like a little golden boat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada entre los nenúfares como una barquita de oro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage parmi les nénuphars comme une petite barque d'or."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota tra le ninfee come una barchetta d'oro."
          }
        }
      }
    },
    "Nuota tra le ninfee dello stagno. Le altre anatre la seguono come una regina." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schwimmt zwischen den Seerosen im Teich. Die anderen Enten folgen ihr wie einer Königin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims among the water lilies in the pond. The other ducks follow it like a queen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada entre los nenúfares del estanque. Los demás patos la siguen como a una reina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage parmi les nénuphars de la mare. Les autres canards la suivent comme une reine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota tra le ninfee dello stagno. Le altre anatre la seguono come una regina."
          }
        }
      }
    },
    "Nuota tra le ninfee rosa, colorata come un ventaglio. Si liscia le piume con una cura infinita." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwimmt zwischen den rosa Seerosen, bunt wie ein Fächer. Putzt die Federn mit unendlicher Sorgfalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims among the pink lilies, colored like a fan. It preens its feathers with infinite care."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada entre los nenúfares rosa, pintada como un abanico. Se alisa las plumas con un cuidado infinito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage parmi les nénuphars roses, colorée comme un éventail. Elle lisse ses plumes avec un soin infini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota tra le ninfee rosa, colorata come un ventaglio. Si liscia le piume con una cura infinita."
          }
        }
      }
    },
    "Nuota tra le nuvole, lentissima, cantando a voce bassa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwimmt ganz langsam zwischen den Wolken und singt leise vor sich hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims among the clouds, very slowly, singing under its breath."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada entre las nubes, lentísima, cantando en voz baja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle nage parmi les nuages, tout doucement, en chantant à voix basse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota tra le nuvole, lentissima, cantando a voce bassa."
          }
        }
      }
    },
    "Nuota vicino alla ruota del mulino e rosicchia le canne. Si asciuga al sole sulla riva." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schwimmt beim Mühlrad und nagt an den Halmen. Am Ufer trocknet sie sich in der Sonne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It swims near the mill wheel and gnaws on reeds. It dries off in the sun on the bank."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada cerca de la rueda del molino y roe las cañas. Se seca al sol en la orilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nage près de la roue du moulin et ronge les roseaux. Il se sèche au soleil sur la rive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuota vicino alla ruota del mulino e rosicchia le canne. Si asciuga al sole sulla riva."
          }
        }
      }
    },
