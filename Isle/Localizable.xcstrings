        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant de fruits que les branches plient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così tanti frutti che i rami si piegano."
          }
        }
