        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three roofs, one on top of the other. Nobody knows who built it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres tejados, uno encima de otro. Nadie sabe quién la construyó."
