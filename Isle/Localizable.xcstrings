    "Isole, risposte, piante e animali spariscono da questo iPhone e da iCloud. Non si può annullare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inseln, Antworten, Pflanzen und Tiere verschwinden von diesem iPhone und aus iCloud. Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Islands, answers, plants and animals disappear from this iPhone and from iCloud. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Islas, respuestas, plantas y animales desaparecen de este iPhone y de iCloud. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îles, réponses, plantes et animaux disparaissent de cet iPhone et d'iCloud. C'est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isole, risposte, piante e animali spariscono da questo iPhone e da iCloud. Non si può annullare."
          }
        }
      }
    },
