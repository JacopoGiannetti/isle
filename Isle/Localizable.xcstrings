    "Salta fuori dal fiordo e ricade con un tuffo enorme. Poi saluta con la coda." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er springt aus dem Fjord und fällt mit einem riesigen Platsch zurück. Dann winkt er mit der Schwanzflosse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It leaps out of the fjord and lands with a huge splash. Then it waves its tail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta fuera del fiordo y cae con un chapuzón enorme. Luego saluda con la cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle bondit hors du fjord et retombe dans un plongeon énorme. Puis elle salue avec sa queue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta fuori dal fiordo e ricade con un tuffo enorme. Poi saluta con la coda."
          }
        }
      }
    },
    "Salta fuori dalla laguna come un delfino. Gioca con le ammoniti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er springt wie ein Delfin aus der Lagune. Er spielt mit den Ammoniten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It leaps out of the lagoon like a dolphin. It plays with the ammonites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta fuera de la laguna como un delfín. Juega con las amonitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bondit hors du lagon comme un dauphin. Il joue avec les ammonites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta fuori dalla laguna come un delfino. Gioca con le ammoniti."
          }
        }
      }
    },
    "Salta per gioia, a molla, senza motivo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hüpft vor Freude, wie eine Sprungfeder, einfach so."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It leaps for joy, springy, for no reason at all."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta de alegría, como un muelle, sin motivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle bondit de joie, comme un ressort, sans raison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta per gioia, a molla, senza motivo."
          }
        }
      }
    },
    "Salta sotto la palma dorata come un riflesso." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
