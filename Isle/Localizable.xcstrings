    "Rami a gradini, come una scala verso il cielo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äste wie Stufen, eine Treppe in den Himmel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branches like steps, a staircase to the sky."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramas en escalones, como una escalera hacia el cielo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des branches en gradins, comme un escalier vers le ciel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rami a gradini, come una scala verso il cielo."
          }
        }
      }
    },
    "Rami che sfiorano terra. Di notte ci dorme qualcuno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äste, die den Boden streifen. Nachts schläft jemand darin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branches that brush the ground. At night someone sleeps there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ramas que rozan la tierra. De noche duerme alguien ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des branches qui frôlent la terre. La nuit, quelqu'un y dort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rami che sfiorano terra. Di notte ci dorme qualcuno."
          }
        }
      }
    },
