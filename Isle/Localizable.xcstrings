          }
        }
      }
    },
    "Arriva con l'arcobaleno e ne porta un pezzo sulla coda.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriva con l'arcobaleno e ne porta un pezzo sulla coda."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It arrives with the rainbow and wears a piece of it on its tail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega con el arcoíris y lleva un trozo en la cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il arrive avec l'arc-en-ciel et en porte un morceau sur la queue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kommt mit dem Regenbogen und trägt ein Stück davon auf dem Schwanz."
          }
        }
      }
    },
    "Arriva l'acqua, e con lei i cervi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriva l'acqua, e con lei i cervi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water arrives, and with it the deer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llega el agua, y con ella los ciervos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eau arrive, et avec elle les cerfs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wasser kommt, und mit ihm die Hirsche."
          }
        }
      }
    },
    "Arriva se hai": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
