    "Sabbia calda, felci e i primi cuccioli." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warmer Sand, Farne und die ersten Jungtiere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm sand, ferns and the first little ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arena cálida, helechos y las primeras crías."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sable chaud, fougères et les premiers petits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabbia calda, felci e i primi cuccioli."
          }
        }
      }
    },
    "Sacchi pieni davanti alla porta, e un po' di farina nell'aria." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volle Säcke vor der Tür und ein wenig Mehl in der Luft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full sacks in front of the door, and a little flour in the air."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sacos llenos delante de la puerta, y un poco de harina en el aire."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des sacs pleins devant la porte, et un peu de farine dans l'air."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sacchi pieni davanti alla porta, e un po' di farina nell'aria."
          }
        }
      }
    },
