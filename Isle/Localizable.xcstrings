    "Danza sopra i Funghi viola quando sorge la luna. Vive poche notti, e le passa tutte a volare.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Danza sopra i Funghi viola quando sorge la luna. Vive poche notti, e le passa tutte a volare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It dances above the Purple Mushrooms when the moon rises. It lives only a few nights, and spends them all in flight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Danza sobre los Hongos morados cuando sale la luna. Vive pocas noches, y las pasa todas volando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle danse au-dessus des Champignons violets quand la lune se lève. Elle ne vit que quelques nuits, et les passe toutes à voler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanzt über den violetten Pilzen, wenn der Mond aufgeht. Lebt nur wenige Nächte, und verbringt sie alle im Flug."
          }
        }
      }
    },
    "Decorazioni": {
      "extractionState": "manual",
      "localizations": {
