    "Caldo, lucente, e ogni tanto si muove." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm, glänzend, und ab und zu bewegt es sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm, shiny, and every now and then it moves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cálido, brillante, y de vez en cuando se mueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaud, brillant, et de temps en temps il bouge."
