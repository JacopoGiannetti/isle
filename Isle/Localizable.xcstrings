    "Stelle cadenti una dietro l'altra. Esprimi un desiderio.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle cadenti una dietro l'altra. Esprimi un desiderio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shooting stars one after another. Make a wish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrellas fugaces una detrás de otra. Pide un deseo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des étoiles filantes les unes derrière les autres. Fais un vœu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sternschnuppen, eine nach der anderen. Wünsch dir etwas."
          }
        }
      }
    },
    "Storia": {
      "extractionState": "manual",
