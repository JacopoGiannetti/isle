    "Veglia sull'Albero di luce viola per tutta la notte. Non ulula quasi mai: gli basta guardare la luna.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Veglia sull'Albero di luce viola per tutta la notte. Non ulula quasi mai: gli basta guardare la luna."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It watches over the Violet Light Tree all night. It almost never howls: looking at the moon is enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vela el Árbol de luz violeta toda la noche. Casi nunca aúlla: le basta mirar la luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il veille sur l'Arbre de lumière violette toute la nuit. Il ne hurle presque jamais : il lui suffit de regarder la lune."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht die ganze Nacht über den violetten Lichtbaum. Heult fast nie: der Mond anzuschauen genügt ihm."
          }
        }
      }
    },
    "Veli verdi e viola nel cielo fino alle %@. Guarda bene tra le nuvole.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Veli verdi e viola nel cielo fino alle %@. Guarda bene tra le nuvole."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green and violet veils in the sky until %@. Look closely among the clouds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velos verdes y violetas en el cielo hasta las %@. Mira bien entre las nubes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des voiles verts et violets dans le ciel jusqu'à %@. Regarde bien entre les nuages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grüne und violette Schleier am Himmel bis %@. Schau genau zwischen die Wolken."
          }
        }
      }
    },
    "Veli verdi e viola ondeggiano nel cielo. Succede di rado.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Veli verdi e viola ondeggiano nel cielo. Succede di rado."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green and violet veils ripple across the sky. It rarely happens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Velos verdes y violetas ondulan en el cielo. Sucede pocas veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des voiles verts et violets ondulent dans le ciel. Ça arrive rarement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grüne und violette Schleier wogen am Himmel. Das geschieht selten."
          }
        }
      }
    },
    "Verde come la luce della luna.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde come la luce della luna."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green as moonlight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde como la luz de la luna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vert comme la lumière de la lune."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grün wie Mondlicht."
          }
        }
      }
    },
    "Vicino all'acqua": {
      "extractionState": "manual",
      "localizations": {
        "it": {
