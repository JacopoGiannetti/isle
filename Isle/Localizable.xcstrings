            "value": "Has %d babies: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene %d crías: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A %d petits : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat %d Junge: %@"
          }
        }
      }
    },
    "Ha cominciato a piovere. Gli animali cercano riparo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha cominciato a piovere. Gli animali cercano riparo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's started raining. The animals are looking for shelter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha empezado a llover. Los animales buscan refugio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a commencé à pleuvoir. Les animaux cherchent un abri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hat angefangen zu regnen. Die Tiere suchen Schutz."
          }
        }
      }
    },
    "Ha la coda piena di stelle: quando corre, ne perde qualcuna.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha la coda piena di stelle: quando corre, ne perde qualcuna."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its tail is full of stars: when it runs, it loses a few."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene la cola llena de estrellas: cuando corre, pierde alguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a la queue pleine d'étoiles : quand elle court, elle en perd quelques-unes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schwanz ist voller Sterne: wenn sie läuft, verliert sie ein paar."
          }
        }
      }
    },
    "Ha un cucciolo: %@": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha un cucciolo: %@"
          }
        },
        "en": {
