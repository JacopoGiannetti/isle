    "Coralli, tartarughe, una balena." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korallen, Schildkröten, ein Wal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corals, turtles, a whale."
          }
        },
        "es" : {
