          "stringUnit" : {
            "state" : "translated",
            "value" : "Cammina sui sassi e muove la coda a tempo."
          }
        }
      }
    },
    "Cammina sui sassi rastrellati senza rovinare le righe. Muove la coda su e giù, su e giù." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie läuft über die geharkten Steine, ohne die Linien zu zerstören. Sie wippt mit dem Schwanz auf und ab, auf und ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It walks on the raked stones without spoiling the lines. It wags its tail up and down, up and down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camina sobre las piedras rastrilladas sin estropear las líneas. Mueve la cola arriba y abajo, arriba y abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle marche sur les pierres ratissées sans abîmer les lignes. Elle remue la queue de haut en bas, de haut en bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cammina sui sassi rastrellati senza rovinare le righe. Muove la coda su e giù, su e giù."
          }
        }
      }
    },
