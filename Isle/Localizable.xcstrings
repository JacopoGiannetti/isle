    "Il Diario elenca abitanti, piante e la storia dell'isola: tocca una notizia per vederla sull'isola. Il Calendario mostra le tue risposte, mese per mese." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tagebuch listet Bewohner, Pflanzen und die Geschichte der Insel: Tippe auf einen Eintrag, um ihn auf der Insel zu sehen. Der Kalender zeigt deine Antworten, Monat für Monat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Diary lists the island's residents, plants and story: tap an entry to see it on the island. The Calendar shows your answers, month by month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Diario recoge los habitantes, las plantas y la historia de la isla: toca una noticia para verla en la isla. El Calendario muestra tus respuestas, mes a mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Journal liste les habitants, les plantes et l'histoire de l'île : touche une nouvelle pour la voir sur l'île. Le Calendrier montre tes réponses, mois par mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Diario elenca abitanti, piante e la storia dell'isola: tocca una notizia per vederla sull'isola. Il Calendario mostra le tue risposte, mese per mese."
          }
        }
      }
    },
