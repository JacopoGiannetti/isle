    "Canta all'alba, prima di tutti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie singt im Morgengrauen, vor allen anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sings at dawn, before everyone else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canta al amanecer, antes que nadie."
          }
