          }
        }
      }
    },
    "Piove sull'isola e gli animali sono al riparo. Basta una risposta per fermare la pioggia.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piove sull'isola e gli animali sono al riparo. Basta una risposta per fermare la pioggia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's raining on the island and the animals are under shelter. One answer is enough to stop the rain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llueve en la isla y los animales están a cubierto. Basta una respuesta para parar la lluvia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pleut sur l'île et les animaux sont à l'abri. Une réponse suffit pour arrêter la pluie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es regnet auf der Insel, und die Tiere sind im Schutz. Eine Antwort genügt, um den Regen zu stoppen."
          }
        }
      }
    },
