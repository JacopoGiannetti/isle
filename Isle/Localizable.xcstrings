    "Compare e scompare tra le ombre della Betulla dorata. È più calmo degli altri conigli, e più curioso.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare e scompare tra le ombre della Betulla dorata. È più calmo degli altri conigli, e più curioso."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It appears and vanishes among the shadows of the Golden Birch. Calmer than the other rabbits, and more curious."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece y desaparece entre las sombras del Abedul dorado. Es más calmado que los otros conejos, y más curioso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il apparaît et disparaît parmi les ombres du Bouleau doré. Plus calme que les autres lapins, et plus curieux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint und verschwindet zwischen den Schatten der goldenen Birke. Ruhiger als die anderen Kaninchen, und neugieriger."
          }
        }
      }
    },
    "Comune": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
