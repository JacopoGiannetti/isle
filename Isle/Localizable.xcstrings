    "Si immerge nel geyser fino al naso e chiude gli occhi. Esce solo quando è tutto rosso in faccia." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er taucht bis zur Nase in den Geysir und schließt die Augen. Er kommt erst heraus, wenn sein Gesicht ganz rot ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sinks into the geyser up to its nose and closes its eyes. It only comes out when its face is all red."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mete en el géiser hasta la nariz y cierra los ojos. Solo sale cuando tiene la cara toda roja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'immerge dans le geyser jusqu'au nez et ferme les yeux. Il ne sort que quand il a le visage tout rouge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si immerge nel geyser fino al naso e chiude gli occhi. Esce solo quando è tutto rosso in faccia."
          }
        }
      }
    },
    "Si immerge nella sorgente turchese fino agli occhi. Esce sempre profumato." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er taucht bis zu den Augen in die Türkisquelle. Er kommt immer duftend heraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sinks into the turquoise spring up to its eyes. It always comes out smelling sweet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sumerge en el manantial turquesa hasta los ojos. Siempre sale perfumado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plonge dans la source turquoise jusqu'aux yeux. Il en sort toujours parfumé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si immerge nella sorgente turchese fino agli occhi. Esce sempre profumato."
          }
        }
      }
    },
    "Si inchina solo a un albero che fa luce, viola come il cielo prima dell'alba." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbeugt sich nur vor einem Baum, der leuchtet, violett wie der Himmel vor der Dämmerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It bows only to a tree that makes light, violet like the sky before dawn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inclina solo ante un árbol que hace luz, violeta como el cielo antes del alba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s'incline que devant un arbre qui fait de la lumière, violet comme le ciel avant l'aube."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si inchina solo a un albero che fa luce, viola come il cielo prima dell'alba."
          }
        }
      }
    },
    "Si inginocchia per mangiare l'erba. Quando corre, la coda sta dritta come una bandierina." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kniet sich hin, um Gras zu fressen. Wenn es rennt, steht der Schwanz hoch wie ein Fähnchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It kneels down to eat the grass. When it runs, its tail sticks up like a little flag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se arrodilla para comer hierba. Cuando corre, la cola se queda tiesa como una banderita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'agenouille pour manger l'herbe. Quand il court, sa queue se dresse comme un petit drapeau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si inginocchia per mangiare l'erba. Quando corre, la coda sta dritta come una bandierina."
          }
        }
      }
    },
    "Si lava la faccia come un gatto e dorme arrotolato nella coda." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wäscht sich das Gesicht wie eine Katze und schläft in seinen Schwanz gerollt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It washes its face like a cat and sleeps curled up in its tail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
