    "Il primo giorno non ci sono conseguenze: al massimo niente seme." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Tag hat keine Folgen: höchstens gibt es keinen Samen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first day has no consequences: at most, no seed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer día no hay consecuencias: como mucho, no hay semilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier jour n'a aucune conséquence : au pire, pas de graine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo giorno non ci sono conseguenze: al massimo niente seme."
          }
        }
      }
    },
    "Il primo giorno non conta: oggi niente seme, l'isola resta com'è." : {
