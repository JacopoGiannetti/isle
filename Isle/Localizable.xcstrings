    "Di giorno": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di giorno"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By day"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De día"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Tag"
          }
        }
      }
    },
    "Di giorno dorme arrotolato sotto le foglie. Al tramonto esce a cercare bacche, sbuffando piano.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di giorno dorme arrotolato sotto le foglie. Al tramonto esce a cercare bacche, sbuffando piano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By day it sleeps rolled up under the leaves. At dusk it comes out to look for berries, puffing softly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De día duerme enrollado bajo las hojas. Al atardecer sale a buscar bayas, resoplando bajito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour il dort en boule sous les feuilles. Au crépuscule il sort chercher des baies, en soufflant tout doucement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Tag schläft er zusammengerollt unter den Blättern. In der Dämmerung kommt er hervor, leise schnaufend, auf der Suche nach Beeren."
          }
        }
      }
    },
    "Di giorno dorme in un buco della quercia. Al tramonto apre la sua mantellina e plana da un ramo all'altro.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di giorno dorme in un buco della quercia. Al tramonto apre la sua mantellina e plana da un ramo all'altro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By day it sleeps in a hole in the oak. At dusk it opens its little cloak and glides from branch to branch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De día duerme en un hueco del roble. Al atardecer abre su capita y planea de rama en rama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour il dort dans un trou du chêne. Au crépuscule il ouvre sa petite cape et plane de branche en branche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Tag schläft er in einem Loch der Eiche. In der Dämmerung öffnet er sein kleines Mäntelchen und gleitet von Ast zu Ast."
          }
        }
      }
    },
    "Di notte": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di notte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By night"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De noche"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Nacht"
          }
        }
      }
    },
    "Di notte le sue pigne brillano.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di notte le sue pigne brillano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At night its cones glow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De noche sus piñas brillan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuit, ses pommes brillent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachts leuchten ihre Zapfen."
          }
        }
      }
    },
    "Di notte si accendono come lanterne.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di notte si accendono come lanterne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At night they light up like lanterns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De noche se encienden como linternas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuit, ils s'allument comme des lanternes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachts gehen sie an wie Laternen."
          }
        }
      }
    },
    "Di notte si posa sul ramo più alto del Salice d'argento. I suoi occhi d'oro vedono tutta l'isola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di notte si posa sul ramo più alto del Salice d'argento. I suoi occhi d'oro vedono tutta l'isola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At night it perches on the highest branch of the Silver Willow. Its golden eyes see the whole island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De noche se posa en la rama más alta del Sauce de plata. Sus ojos de oro ven toda la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuit elle se pose sur la plus haute branche du Saule d'argent. Ses yeux d'or voient toute l'île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachts setzt sie sich auf den höchsten Ast der Silberweide. Ihre goldenen Augen sehen die ganze Insel."
          }
        }
      }
    },
    "Di questa creatura si sa pochissimo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di questa creatura si sa pochissimo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very little is known about this creature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De esta criatura se sabe muy poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On sait très peu de chose sur cette créature."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über diese Kreatur weiß man sehr wenig."
          }
        }
      }
    },
