    },
    "Quando lo fai, tocca «Fatto», a qualsiasi ora: l'isola cresce subito." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du es tust, tippe auf „Erledigt“, zu jeder Uhrzeit: die Insel wächst sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you do it, tap \"Done\", at any time: the island grows right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando lo hagas, toca «Hecho», a cualquier hora: la isla crece al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand tu le fais, touche « C'est fait », à n'importe quelle heure : l'île grandit tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando lo fai, tocca «Fatto», a qualsiasi ora: l'isola cresce subito."
          }
        }
      }
    },
