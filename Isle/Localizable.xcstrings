    "Lunga come un bambino. Non ha fretta da trenta milioni di anni." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So lang wie ein Kind. Seit dreißig Millionen Jahren hat er es nicht eilig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As long as a child. It hasn't been in a hurry for thirty million years."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larga como un niño. No tiene prisa desde hace treinta millones de años."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longue comme un enfant. Elle n'est pas pressée depuis trente millions d'années."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunga come un bambino. Non ha fretta da trenta milioni di anni."
          }
        }
      }
    },
