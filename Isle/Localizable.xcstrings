    "Il lunedì l'isola è nuvolosa e ti diciamo com'è andata. Torna il sole appena lo rifai. Nessun danno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Montag ist die Insel bewölkt und wir sagen dir, wie es lief. Die Sonne kommt zurück, sobald du es wieder tust. Kein Schaden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Monday the island is cloudy and we tell you how it went. The sun comes back as soon as you do it again. No damage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El lunes la isla está nublada y te contamos cómo fue. El sol vuelve en cuanto lo repites. Sin daños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lundi, l'île est nuageuse et on te dit comment ça s'est passé. Le soleil revient dès que tu le refais. Aucun dégât."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il lunedì l'isola è nuvolosa e ti diciamo com'è andata. Torna il sole appena lo rifai. Nessun danno."
          }
        }
      }
    },
