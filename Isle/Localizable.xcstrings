    "Arrivano solo con certi fenomeni del meteo e se ne vanno quando il tempo cambia.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivano solo con certi fenomeni del meteo e se ne vanno quando il tempo cambia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They only come with certain kinds of weather, and leave when it changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo llegan con ciertos fenómenos del tiempo y se van cuando cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils n'arrivent qu'avec certains phénomènes météo, et s'en vont quand le temps change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommen nur bei bestimmtem Wetter und gehen, wenn es sich ändert."
          }
        }
      }
    },
