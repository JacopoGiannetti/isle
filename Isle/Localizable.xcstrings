    "Scorri in su per entrare": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri in su per entrare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up to enter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia arriba para entrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse vers le haut pour entrer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische nach oben, um einzutreten"
          }
        }
      }
    },
    "Se cedi adesso": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cedi adesso"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you give in now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cedes ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu cèdes maintenant"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du jetzt nachgibst"
          }
        }
      }
    },
    "Se la vedi, le notifiche funzionano.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se la vedi, le notifiche funzionano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you can see this, notifications are working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la ves, las notificaciones funcionan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu la vois, les notifications marchent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das siehst, funktionieren die Benachrichtigungen."
          }
        }
      }
    },
    "Se è qualcosa che fai qualche volta a settimana, l'isola si regola da sola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se è qualcosa che fai qualche volta a settimana, l'isola si regola da sola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it's something you do a few times a week, the island adjusts on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si es algo que haces algunas veces a la semana, la isla se regula sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si c'est quelque chose que tu fais quelques fois par semaine, l'île s'ajuste toute seule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du es ein paar Mal pro Woche tust, stellt sich die Insel von allein ein."
          }
        }
      }
    },
    "Seccato dalla tempesta · torna verde dopo tre risposte buone": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seccato dalla tempesta · torna verde dopo tre risposte buone"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dried by the storm · turns green again after three good answers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Secado por la tormenta · vuelve a ponerse verde después de tres respuestas buenas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desséché par la tempête · reverdit après trois bonnes réponses"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Sturm verdorrt · wird nach drei guten Antworten wieder grün"
          }
        }
      }
    },
    "Secchielli di legno raccolgono gocce dolci.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Secchielli di legno raccolgono gocce dolci."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little wooden buckets gather sweet drops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubitos de madera recogen gotas dulces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De petits seaux de bois recueillent des gouttes sucrées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleine Holzeimer sammeln süße Tropfen."
          }
        }
      }
    },
    "Segue chi lavora la terra, sperando in un vermetto. Canta anche d'inverno, quando gli altri tacciono.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segue chi lavora la terra, sperando in un vermetto. Canta anche d'inverno, quando gli altri tacciono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It follows whoever works the soil, hoping for a little worm. It sings even in winter, when the others fall silent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a quien trabaja la tierra, esperando un gusanito. Canta también en invierno, cuando los demás callan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suit celui qui travaille la terre, en espérant un petit ver. Il chante même en hiver, quand les autres se taisent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgt dem, der die Erde bearbeitet, in der Hoffnung auf ein Würmchen. Singt auch im Winter, wenn die anderen schweigen."
          }
        }
      }
    },
    "Segui il cerchio. %d respiri.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui il cerchio. %d respiri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the circle. %d breaths."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el círculo. %d respiraciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suis le cercle. %d respirations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge dem Kreis. %d Atemzüge."
          }
        }
      }
    },
    "Sei qui · giorno %d": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei qui · giorno %d"
          }
        },
        "en": {
