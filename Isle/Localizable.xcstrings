    "Costruisce solo dove l'acqua cade.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisce solo dove l'acqua cade."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It only builds where the water falls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye solo donde cae el agua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne construit que là où l'eau tombe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baut nur dort, wo das Wasser fällt."
          }
        }
      }
    },
    "Costruisce un nido enorme e lo sistema un po' ogni anno. Non canta: per salutare batte il becco.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisce un nido enorme e lo sistema un po' ogni anno. Non canta: per salutare batte il becco."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It builds an enormous nest and tidies it a little each year. It doesn't sing: to say hello, it clacks its beak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye un nido enorme y lo arregla un poco cada año. No canta: para saludar golpea el pico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle construit un nid énorme et le range un peu chaque année. Elle ne chante pas : pour dire bonjour, elle tape du bec."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baut ein riesiges Nest und richtet es jedes Jahr ein bisschen. Singt nicht: zum Grüßen klappert sie mit dem Schnabel."
          }
        }
      }
    },
