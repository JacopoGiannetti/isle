    "Riparte il volo tra le nuvole, come alla prima apertura.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riparte il volo tra le nuvole, come alla prima apertura."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flight among the clouds starts again, like the first time it opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve el vuelo entre las nubes, como en la primera apertura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vol entre les nuages reprend, comme à la première ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Flug zwischen den Wolken beginnt wieder, wie beim ersten Mal."
          }
        }
      }
    },
    "Riposa all'ombra della Quercia millenaria d'oro. Quando cammina, gli altri animali si fermano a guardarlo.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riposa all'ombra della Quercia millenaria d'oro. Quando cammina, gli altri animali si fermano a guardarlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It rests in the shade of the Golden Ancient Oak. When it walks, the other animals stop to watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descansa a la sombra del Roble milenario de oro. Cuando camina, los demás animales se paran a mirarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se repose à l'ombre du Chêne millénaire d'or. Quand il marche, les autres animaux s'arrêtent pour le regarder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruht im Schatten der goldenen tausendjährigen Eiche. Wenn er geht, bleiben die anderen Tiere stehen und schauen."
          }
        }
      }
    },
    "Rispondere \"sì\" fa cadere un meteorite. Rispondere \"no\" fa crescere l'isola.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondere \"sì\" fa cadere un meteorite. Rispondere \"no\" fa crescere l'isola."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering \"yes\" drops a meteorite. Answering \"no\" grows the island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responder \"sí\" hace caer un meteorito. Responder \"no\" hace crecer la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondre « oui » fait tomber un météore. Répondre « non » fait grandir l'île."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ja“ lässt einen Meteoriten fallen. „Nein“ lässt die Insel wachsen."
          }
        }
      }
    },
    "Rispondi e pianta il seme di oggi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi e pianta il seme di oggi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer and plant today's seed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde y planta la semilla de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponds et plante la graine d'aujourd'hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte und pflanze den Samen von heute."
          }
        }
      }
    },
    "Rivedi l'introduzione": {
      "extractionState": "manual",
      "localizations": {
