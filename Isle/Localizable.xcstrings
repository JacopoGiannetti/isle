    "Riposa sotto l'abete di cristallo. Quando muove le corna si sente un tintinnio." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ruht unter der Kristalltanne. Wenn es sein Geweih bewegt, hört man ein Klingeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rests under the crystal fir. When it moves its antlers, you hear a tinkling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa bajo el abeto de cristal. Cuando mueve la cornamenta se oye un tintineo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se repose sous le sapin de cristal. Quand il bouge ses bois, on entend un tintement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposa sotto l'abete di cristallo. Quando muove le corna si sente un tintinnio."
          }
        }
      }
    },
    "Riposa sotto l'albero della vita e racconta storie ai piccoli. Ricorda il nome di tutti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ruht unter dem Baum des Lebens und erzählt den Kleinen Geschichten. Er kennt jeden beim Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rests under the tree of life and tells stories to the little ones. It remembers everyone's name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descansa bajo el árbol de la vida y cuenta historias a los pequeños. Recuerda el nombre de todos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se repose sous l'arbre de vie et raconte des histoires aux petits. Il se souvient du nom de chacun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposa sotto l'albero della vita e racconta storie ai piccoli. Ricorda il nome di tutti."
          }
        }
      }
    },
