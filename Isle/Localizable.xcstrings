    "Non esce quasi mai, ma quando lo fa il glicine ronza di festa. Le altre api le fanno strada.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non esce quasi mai, ma quando lo fa il glicine ronza di festa. Le altre api le fanno strada."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "She almost never comes out, but when she does the wisteria hums with celebration. The other bees make way for her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi nunca sale, pero cuando lo hace la glicinia zumba de fiesta. Las otras abejas le abren paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne sort presque jamais, mais quand elle le fait la glycine bourdonne de fête. Les autres abeilles lui font la haie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommt fast nie heraus, aber wenn, summt der Blauregen vor Fest. Die anderen Bienen machen ihr Platz."
          }
        }
      }
    },
    "Non oggi": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non oggi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not today"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas aujourd'hui"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht heute"
          }
        }
      }
    },
    "Non sono sull'isola e non contano. Tornano quando ritrovano quello che cercavano.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono sull'isola e non contano. Tornano quando ritrovano quello che cercavano."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They're not on the island and they don't count. They return when they find what they were looking for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No están en la isla y no cuentan. Vuelven cuando encuentran lo que buscaban."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils ne sont pas sur l'île et ils ne comptent pas. Ils reviennent quand ils retrouvent ce qu'ils cherchaient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind nicht auf der Insel und zählen nicht. Sie kehren zurück, wenn sie finden, was sie suchten."
          }
        }
      }
    },
    "Non sta ferma un secondo.": {
      "extractionState": "manual",
