    "Salta sotto la palma dorata. Quando si ferma sembra una statua d'argento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie springt unter der goldenen Palme. Wenn sie stillsteht, sieht sie aus wie eine Silberstatue."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It leaps under the golden palm. When it stops, it looks like a silver statue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta bajo la palmera dorada. Cuando se para, parece una estatua de plata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle bondit sous le palmier doré. Quand elle s'arrête, on dirait une statue d'argent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta sotto la palma dorata. Quando si ferma sembra una statua d'argento."
          }
        }
      }
    },
    "Salta tra gli abeti di brina e scompare in un lampo d'argento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er springt zwischen den Raureiftannen und verschwindet in einem silbernen Blitz."
          }
