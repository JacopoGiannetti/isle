          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fliegt"
          }
        }
      }
    },
    "Vola solo nelle giornate di sole, tra i Fiori azzurri. Dove si posa, dicono, la giornata va bene.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vola solo nelle giornate di sole, tra i Fiori azzurri. Dove si posa, dicono, la giornata va bene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It only flies on sunny days, among the Blue Flowers. Where it lands, they say, the day goes well."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuela solo en los días de sol, entre las Flores azules. Donde se posa, dicen, el día va bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne vole que les jours de soleil, parmi les Fleurs bleues. Là où il se pose, paraît-il, la journée se passe bien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fliegt nur an Sonnentagen, zwischen den azurblauen Blumen. Wo sie sich setzt, sagt man, wird der Tag gut."
          }
        }
      }
    },
