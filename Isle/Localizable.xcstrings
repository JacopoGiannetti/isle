    "Bruca all'ombra degli alberi e beve solo acqua fresca. Al minimo rumore alza la testa e resta immobile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er äst im Schatten der Bäume und trinkt nur frisches Wasser. Beim kleinsten Geräusch hebt er den Kopf und bleibt still."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes in the shade of the trees and drinks only fresh water. At the slightest sound it lifts its head and stays still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pacea a la sombra de los árboles y bebe solo agua fresca. Al menor ruido alza la cabeza y se queda inmóvil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute à l'ombre des arbres et ne boit que de l'eau fraîche. Au moindre bruit il lève la tête et reste immobile."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca all'ombra degli alberi e beve solo acqua fresca. Al minimo rumore alza la testa e resta immobile."
          }
        }
      }
    },
    "Bruca gli aghi d'oro del larice. Le corna luccicano al tramonto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es knabbert die goldenen Nadeln der Lärche. Sein Geweih glitzert im Abendrot."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It nibbles the larch's golden needles. Its antlers sparkle at sunset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pace las agujas de oro del alerce. Su cornamenta reluce al atardecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute les aiguilles d'or du mélèze. Ses bois scintillent au coucher du soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca gli aghi d'oro del larice. Le corna luccicano al tramonto."
          }
        }
      }
    },
    "Bruca gli equiseti a testa bassa. Il collare gli serve per farsi bello." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er weidet mit gesenktem Kopf Schachtelhalme ab. Den Kragen trägt er nur, um sich schick zu machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes on horsetails with its head down. Its frill is just for looking good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta las colas de caballo con la cabeza gacha. El collar solo le sirve para ponerse guapo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute les prêles tête baissée. Sa collerette, c'est juste pour faire le beau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca gli equiseti a testa bassa. Il collare gli serve per farsi bello."
          }
        }
      }
    },
    "Bruca gli equiseti dorati con grande eleganza. Il collare gli brilla come una corona." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er weidet die goldenen Schachtelhalme mit großer Eleganz ab. Sein Kragen glänzt wie eine Krone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes on the golden horsetails with great elegance. Its frill shines like a crown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta las colas de caballo doradas con gran elegancia. El collar le brilla como una corona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute les prêles dorées avec une grande élégance. Sa collerette brille comme une couronne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca gli equiseti dorati con grande eleganza. Il collare gli brilla come una corona."
          }
        }
      }
    },
    "Bruca il ginkgo in piedi sulle zampe dietro. Saluta tutti alzando il pollice." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er frisst am Ginkgo, auf den Hinterbeinen stehend. Er grüßt alle mit erhobenem Daumen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes on the ginkgo standing on its hind legs. It greets everyone with a thumbs-up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta el ginkgo de pie sobre las patas traseras. Saluda a todos levantando el pulgar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute le ginkgo debout sur ses pattes arrière. Il salue tout le monde en levant le pouce."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca il ginkgo in piedi sulle zampe dietro. Saluta tutti alzando il pollice."
          }
        }
      }
    },
    "Bruca il tappeto di licheni per ore. Ha gli zoccoli larghi come racchette da neve." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es grast stundenlang auf dem Flechtenteppich. Seine Hufe sind breit wie Schneeschuhe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes the lichen carpet for hours. Its hooves are as wide as snowshoes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pace en la alfombra de líquenes durante horas. Tiene las pezuñas anchas como raquetas de nieve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute le tapis de lichens pendant des heures. Ses sabots sont larges comme des raquettes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca il tappeto di licheni per ore. Ha gli zoccoli larghi come racchette da neve."
          }
        }
      }
    },
    "Bruca l'acacia altissima in silenzio. Si fa vedere solo al tramonto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es knabbert still an der Riesenakazie. Es zeigt sich nur bei Sonnenuntergang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It quietly nibbles the towering acacia. It only shows itself at sunset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mordisquea la acacia altísima en silencio. Solo se deja ver al atardecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute l'acacia géant en silence. Il ne se montre qu'au coucher du soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca l'acacia altissima in silenzio. Si fa vedere solo al tramonto."
          }
        }
      }
    },
    "Bruca l'acacia d'argento sotto la luna. Di notte quasi brilla." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie knabbert an der Silberakazie unter dem Mond. Nachts leuchtet sie fast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It nibbles the silver acacia under the moon. At night it almost glows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mordisquea la acacia plateada bajo la luna. De noche casi brilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle broute l'acacia argenté sous la lune. La nuit, elle brille presque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca l'acacia d'argento sotto la luna. Di notte quasi brilla."
          }
        }
      }
    },
    "Bruca le foglie basse dell'acacia, sempre in coppia. Al minimo rumore scatta via a zig zag." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es knabbert die unteren Akazienblätter, immer zu zweit. Beim kleinsten Geräusch flitzt es im Zickzack davon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It nibbles the low acacia leaves, always in pairs. At the slightest sound, it zigzags away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mordisquea las hojas bajas de la acacia, siempre en pareja. Al menor ruido, sale disparado en zigzag."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute les feuilles basses de l'acacia, toujours en couple. Au moindre bruit, il file en zigzag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca le foglie basse dell'acacia, sempre in coppia. Al minimo rumore scatta via a zig zag."
          }
        }
      }
    },
    "Bruca solo dove crescono steli a segmenti." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er weidet nur, wo gegliederte Stängel wachsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only grazes where segmented stems grow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo pasta donde crecen tallos a segmentos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne broute que là où poussent des tiges à segments."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca solo dove crescono steli a segmenti."
          }
        }
      }
    },
    "Bruca sotto gli ulivi con le altre pecore. Se una si sposta, si spostano tutte." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es grast mit den anderen Schafen unter den Olivenbäumen. Wenn eins sich bewegt, bewegen sich alle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes under the olive trees with the other sheep. If one moves, they all move."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta bajo los olivos con las demás ovejas. Si una se mueve, se mueven todas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute sous les oliviers avec les autres moutons. Si l'un bouge, tous bougent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca sotto gli ulivi con le altre pecore. Se una si sposta, si spostano tutte."
          }
        }
      }
    },
    "Bruca sotto il larice d'oro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es grast unter der Goldlärche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes under the golden larch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pace bajo el alerce de oro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute sous le mélèze d'or."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca sotto il larice d'oro."
          }
        }
      }
    },
    "Bruca sotto il larice e raspa la neve con gli zoccoli. Le sue ginocchia fanno clic quando cammina." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es grast unter der Lärche und scharrt mit den Hufen im Schnee. Seine Knie machen Klick, wenn es läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes under the larch and paws the snow with its hooves. Its knees go click when it walks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pace bajo el alerce y escarba la nieve con las pezuñas. Sus rodillas hacen clic cuando camina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute sous le mélèze et gratte la neige avec ses sabots. Ses genoux font clic quand il marche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca sotto il larice e raspa la neve con gli zoccoli. Le sue ginocchia fanno clic quando cammina."
          }
        }
      }
    },
    "Bruca sotto l'acero d'autunno tra le foglie rosse. Fa l'inchino a chi passa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er grast unter dem Herbstahorn zwischen den roten Blättern. Er verbeugt sich vor allen, die vorbeikommen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes under the autumn maple among the red leaves. It bows to whoever passes by."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta bajo el arce de otoño entre las hojas rojas. Hace una reverencia a quien pasa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute sous l'érable d'automne parmi les feuilles rouges. Il salue d'une révérence ceux qui passent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca sotto l'acero d'autunno tra le foglie rosse. Fa l'inchino a chi passa."
          }
        }
      }
    },
    "Bruca sotto l'ulivo d'argento, un po' lontana dalle altre. Fa sempre di testa sua." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es grast unter dem silbernen Olivenbaum, etwas abseits von den anderen. Es macht immer, was es will."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes under the silver olive tree, a little apart from the others. It always does its own thing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta bajo el olivo de plata, un poco lejos de las demás. Siempre hace lo que quiere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il broute sous l'olivier d'argent, un peu à l'écart des autres. Il n'en fait toujours qu'à sa tête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca sotto l'ulivo d'argento, un po' lontana dalle altre. Fa sempre di testa sua."
          }
        }
      }
    },
    "Bruca sotto la palma e ogni tanto fa un salto altissimo, solo per allegria." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie grast unter der Palme und macht ab und zu einen riesigen Sprung, einfach aus Freude."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It grazes under the palm and now and then leaps sky-high, just for fun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta bajo la palmera y de vez en cuando da un salto altísimo, solo por alegría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle broute sous le palmier et fait parfois un bond immense, juste par joie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruca sotto la palma e ogni tanto fa un salto altissimo, solo per allegria."
          }
        }
      }
    },
