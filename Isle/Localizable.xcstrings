            "value": "Tu as %d graines."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %d Samen."
          }
        }
      }
    },
    "Hai resistito. È sbocciato un Fiore della tenacia.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai resistito. È sbocciato un Fiore della tenacia."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You held on. A Flower of Tenacity has bloomed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has aguantado. Ha nacido una Flor de la tenacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as tenu bon. Une Fleur de la ténacité a éclos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast standgehalten. Eine Blume der Ausdauer ist erblüht."
          }
        }
      }
    },
    "Hai sgarrato?": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai sgarrato?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you slip?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Has recaído?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as craqué ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bist du ausgerutscht?"
          }
        }
      }
    },
    "Hai un seme. Se non lo pianti entro domani, lo pianta il vento.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai un seme. Se non lo pianti entro domani, lo pianta il vento."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have a seed. If you don't plant it by tomorrow, the wind will."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes una semilla. Si no la plantas para mañana, la planta el viento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as une graine. Si tu ne la plantes pas d'ici demain, le vent s'en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast einen Samen. Wenn du ihn nicht bis morgen pflanzt, pflanzt ihn der Wind."
          }
        }
      }
    },
