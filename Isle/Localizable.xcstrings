    "Plana sopra il fiume senza battere le ali. Pesca e riparte." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er gleitet über den Fluss, ohne mit den Flügeln zu schlagen. Er fischt und fliegt weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It glides over the river without flapping its wings. It fishes and flies off again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planea sobre el río sin batir las alas. Pesca y se va."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il plane au-dessus de la rivière sans battre des ailes. Il pêche et repart."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plana sopra il fiume senza battere le ali. Pesca e riparte."
          }
        }
      }
    },
