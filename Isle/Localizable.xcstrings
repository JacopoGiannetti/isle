    "Trascina i rami del tronco caduto fino alla sorgente per costruire la sua diga. Lavora di notte e fa un baccano incredibile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er schleppt Äste vom gefallenen Stamm zur Quelle, um seinen Damm zu bauen. Er arbeitet nachts und macht einen unglaublichen Lärm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It drags branches from the fallen log to the spring to build its dam. It works at night and makes an incredible racket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra las ramas del tronco caído hasta el manantial para construir su presa. Trabaja de noche y hace un ruido increíble."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il traîne les branches du tronc tombé jusqu'à la source pour construire son barrage. Il travaille la nuit et fait un vacarme incroyable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i rami del tronco caduto fino alla sorgente per costruire la sua diga. Lavora di notte e fa un baccano incredibile."
          }
        }
      }
    },
    "Trasparente come il ghiaccio, si vede solo quando brilla." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsichtig wie Eis, man sieht sie nur, wenn sie leuchtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear as ice, you only see it when it glows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transparente como el hielo, solo se ve cuando brilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transparent comme la glace, on ne le voit que quand il brille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasparente come il ghiaccio, si vede solo quando brilla."
          }
        }
      }
    },
