    "Cento giorni per trovarla. L'acqua brilla come la luna." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hundert Tage, um sie zu finden. Das Wasser glänzt wie der Mond."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hundred days to find it. The water shines like the moon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cien días para encontrarlo. El agua brilla como la luna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cent jours pour la trouver. L'eau brille comme la lune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cento giorni per trovarla. L'acqua brilla come la luna."
          }
        }
      }
    },
    "Cento giorni per trovarla. Ogni moneta è un desiderio." : {
