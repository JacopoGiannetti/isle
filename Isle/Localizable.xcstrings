    "Ha cominciato a piovere. Gli animali cercano riparo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es hat angefangen zu regnen. Die Tiere suchen Schutz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's started raining. The animals are looking for shelter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha empezado a llover. Los animales buscan refugio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a commencé à pleuvoir. Les animaux cherchent un abri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha cominciato a piovere. Gli animali cercano riparo."
          }
        }
      }
    },
    "Ha gli occhi rosa e rosicchia solo carote viola." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hat rosa Augen und knabbert nur lila Karotten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has pink eyes and only nibbles purple carrots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene los ojos rosas y solo roe zanahorias moradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a les yeux roses et ne grignote que des carottes violettes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha gli occhi rosa e rosicchia solo carote viola."
          }
        }
      }
    },
    "Ha i baffi più lunghi del polo nord." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hat die längsten Schnurrhaare am Nordpol."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has the longest whiskers at the North Pole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene los bigotes más largos del polo norte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a les plus longues moustaches du pôle Nord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha i baffi più lunghi del polo nord."
          }
        }
      }
    },
    "Ha i denti arancioni e nuota benissimo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
