    "Per oggi è tutto": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per oggi è tutto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's all for today"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por hoy es todo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est tout pour aujourd'hui"
          }
        },
        "de": {
