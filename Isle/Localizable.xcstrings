    "Il Sentiero avanza di un giorno, sempre, anche nei giorni no: sblocca piante e animali nuovi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Pfad geht immer einen Tag weiter, auch an schlechten Tagen: er schaltet neue Pflanzen und Tiere frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Path moves forward one day, always, even on bad days: it unlocks new plants and animals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Sendero avanza un día, siempre, incluso en los días malos: desbloquea plantas y animales nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Sentier avance d'un jour, toujours, même les mauvais jours : il débloque de nouvelles plantes et de nouveaux animaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Sentiero avanza di un giorno, sempre, anche nei giorni no: sblocca piante e animali nuovi."
          }
        }
      }
    },
