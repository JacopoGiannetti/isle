    "Torna, o dovrò\nandarmene!" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm zurück, sonst\nmuss ich gehen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Come back, or I'll\nhave to leave!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Vuelve, o tendré\nque irme!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reviens, sinon je\ndevrai partir !"
          }
        }
      }
    },
