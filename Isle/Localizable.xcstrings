    "Il cielo resta nuvoloso finché non lo rifai. Nessun danno: appena segni «Fatto» torna il sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Himmel bleibt bewölkt, bis du es wieder tust. Kein Schaden: sobald du auf „Erledigt“ tippst, kommt die Sonne zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sky stays cloudy until you do it again. No damage: as soon as you mark \"Done\", the sun comes back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cielo sigue nublado hasta que lo repitas. Sin daños: en cuanto marques «Hecho», vuelve el sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le ciel reste nuageux jusqu'à ce que tu le refasses. Aucun dégât : dès que tu touches « C'est fait », le soleil revient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cielo resta nuvoloso finché non lo rifai. Nessun danno: appena segni «Fatto» torna il sole."
          }
        }
      }
    },
