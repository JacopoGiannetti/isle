    "Costruisce la diga solo se trova legna già pronta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er baut seinen Damm nur, wenn er schon fertiges Holz findet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only builds its dam if it finds wood ready to use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo construye la presa si encuentra madera ya lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne construit son barrage que s'il trouve du bois tout prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruisce la diga solo se trova legna già pronta."
          }
        }
      }
    },
    "Costruisce solo dove l'acqua cade." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baut nur dort, wo das Wasser fällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only builds where the water falls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construye solo donde cae el agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne construit que là où l'eau tombe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruisce solo dove l'acqua cade."
          }
        }
      }
    },
    "Costruisce un nido enorme e lo sistema un po' ogni anno. Non canta: per salutare batte il becco." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baut ein riesiges Nest und richtet es jedes Jahr ein bisschen. Singt nicht: zum Grüßen klappert sie mit dem Schnabel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It builds an enormous nest and tidies it a little each year. It doesn't sing: to say hello, it clacks its beak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construye un nido enorme y lo arregla un poco cada año. No canta: para saludar golpea el pico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle construit un nid énorme et le range un peu chaque année. Elle ne chante pas : pour dire bonjour, elle tape du bec."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruisce un nido enorme e lo sistema un po' ogni anno. Non canta: per salutare batte il becco."
          }
        }
      }
    },
    "Cova le uova a pois con pazienza infinita. Canta piano per farle schiudere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er brütet die getupften Eier mit unendlicher Geduld aus. Er singt leise, damit sie schlüpfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sits on the polka-dot eggs with endless patience. It sings softly to help them hatch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incuba los huevos de lunares con paciencia infinita. Canta bajito para que eclosionen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il couve les œufs à pois avec une patience infinie. Il chante doucement pour les faire éclore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cova le uova a pois con pazienza infinita. Canta piano per farle schiudere."
          }
        }
      }
    },
