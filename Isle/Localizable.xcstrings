    "I semi guadagnati, le risposte, il Sentiero con tutto ciò che hai sbloccato, la grandezza dell'isola e la sorgente al centro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die verdienten Samen, deine Antworten, den Pfad mit allem Freigeschalteten, die Größe der Insel und die Quelle in ihrer Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The seeds you've earned, your answers, the Path with everything you've unlocked, the size of the island and the spring at its heart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las semillas ganadas, tus respuestas, el Sendero con todo lo que has desbloqueado, el tamaño de la isla y el manantial del centro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les graines gagnées, tes réponses, le Sentier avec tout ce que tu as débloqué, la taille de l'île et la source en son centre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I semi guadagnati, le risposte, il Sentiero con tutto ciò che hai sbloccato, la grandezza dell'isola e la sorgente al centro."
          }
        }
      }
    },
