    "Dove il vento è forte e gli uccelli fanno il nido." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo der Wind stark ist und die Vögel nisten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where the wind is strong and the birds build nests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donde el viento es fuerte y los pájaros hacen su nido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Là où le vent est fort et où les oiseaux font leur nid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dove il vento è forte e gli uccelli fanno il nido."
          }
        }
      }
    },
    "Dove passa con la coda, il cielo si colora." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo sein Schwanz vorbeistreicht, färbt sich der Himmel."
          }
