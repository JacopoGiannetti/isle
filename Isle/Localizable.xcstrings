    "Esce %d%% delle volte, garantita entro 10 semi": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce %d%% delle volte, garantita entro 10 semi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appears %d%% of the time, guaranteed within 10 seeds"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale el %d%% de las veces, garantizada en 10 semillas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort %d %% des fois, garantie en 10 graines"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint in %d%% der Fälle, garantiert innerhalb von 10 Samen"
          }
        }
      }
    },
    "Esce al crepuscolo per il suo giro di ronda. Si scava una tana sotto un tronco e la tiene pulitissima.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce al crepuscolo per il suo giro di ronda. Si scava una tana sotto un tronco e la tiene pulitissima."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It comes out at dusk for its round. It digs a den under a log and keeps it spotless."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale al crepúsculo a hacer su ronda. Se cava una madriguera bajo un tronco y la tiene limpísima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle sort au crépuscule pour sa ronde. Elle se creuse un terrier sous un tronc et le tient impeccable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt in der Dämmerung zu seiner Runde heraus. Gräbt sich eine Höhle unter einem Stamm und hält sie blitzsauber."
          }
        }
      }
    },
    "Esce al crepuscolo, quando le foglie dell'Acero cremisi sembrano bruciare. Gioca a rincorrere quelle che cadono.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce al crepuscolo, quando le foglie dell'Acero cremisi sembrano bruciare. Gioca a rincorrere quelle che cadono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It comes out at dusk, when the Crimson Maple's leaves look like they're on fire. It plays at chasing the ones that fall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale al crepúsculo, cuando las hojas del Arce carmesí parecen arder. Juega a perseguir las que caen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle sort au crépuscule, quand les feuilles de l'Érable cramoisi ont l'air de brûler. Elle s'amuse à courir après celles qui tombent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt in der Dämmerung, wenn die Blätter des karmesinroten Ahorns zu brennen scheinen. Spielt, die fallenden zu jagen."
          }
        }
      }
    },
    "Esce al tramonto e annusa ogni bacca prima di sceglierla. Quando dorme sembra un batuffolo di zucchero.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce al tramonto e annusa ogni bacca prima di sceglierla. Quando dorme sembra un batuffolo di zucchero."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It comes out at dusk and sniffs every berry before choosing. When it sleeps it looks like a little puff of sugar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale al atardecer y huele cada baya antes de elegirla. Cuando duerme parece un copo de azúcar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sort au coucher du soleil et renifle chaque baie avant de la choisir. Quand il dort, on dirait une touffe de sucre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt bei Sonnenuntergang und beschnuppert jede Beere, bevor er wählt. Wenn er schläft, sieht er aus wie ein Zuckerwölkchen."
          }
        }
      }
    },
    "Esce al tramonto, a passettini.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce al tramonto, a passettini."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It comes out at dusk, in tiny steps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale al atardecer, a pasitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sort au coucher du soleil, à tout petits pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt bei Sonnenuntergang, in kleinen Schritten."
          }
        }
      }
    },
    "Esce all'alba e al tramonto a sgranocchiare trifoglio. Se si spaventa batte le zampe a terra per avvisare gli altri.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce all'alba e al tramonto a sgranocchiare trifoglio. Se si spaventa batte le zampe a terra per avvisare gli altri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It comes out at dawn and dusk to nibble clover. If it's startled it thumps its paws on the ground to warn the others."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale al amanecer y al atardecer a roer trébol. Si se asusta golpea las patas en el suelo para avisar a los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sort à l'aube et au crépuscule pour croquer du trèfle. S'il a peur, il frappe le sol de ses pattes pour prévenir les autres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt bei Sonnenaufgang und -untergang, um Klee zu knabbern. Wenn es erschrickt, trommelt es mit den Pfoten, um die anderen zu warnen."
          }
        }
      }
    },
    "Esce dal bosco all'alba e al tramonto a brucare i germogli. Se lo sorprendi, abbaia e scappa a balzi.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esce dal bosco all'alba e al tramonto a brucare i germogli. Se lo sorprendi, abbaia e scappa a balzi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It comes out of the woods at dawn and dusk to graze on shoots. If you startle it, it barks and bounds away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale del bosque al amanecer y al atardecer a pacer los brotes. Si lo sorprendes, ladra y huye a saltos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sort du bois à l'aube et au crépuscule pour brouter les pousses. Si tu le surprends, il aboie et s'enfuit par bonds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommt bei Sonnenaufgang und -untergang aus dem Wald, um an den Trieben zu äsen. Wenn du es überraschst, bellt es und springt davon."
          }
        }
      }
    },
    "Espira": {
      "extractionState": "manual",
