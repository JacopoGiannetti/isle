    "Bruca all'ombra degli alberi e beve solo acqua fresca. Al minimo rumore alza la testa e resta immobile.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruca all'ombra degli alberi e beve solo acqua fresca. Al minimo rumore alza la testa e resta immobile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It grazes in the shade of the trees and drinks only fresh water. At the slightest sound it lifts its head and stays still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacea a la sombra de los árboles y bebe solo agua fresca. Al menor ruido alza la cabeza y se queda inmóvil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il broute à l'ombre des arbres et ne boit que de l'eau fraîche. Au moindre bruit il lève la tête et reste immobile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er äst im Schatten der Bäume und trinkt nur frisches Wasser. Beim kleinsten Geräusch hebt er den Kopf und bleibt still."
          }
        }
      }
    },
