    "Va a caccia dove saltella la sua cena." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jagt dort, wo ihr Abendessen hüpft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It hunts where its dinner hops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va de caza donde saltalea su cena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle chasse là où sautille son dîner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va a caccia dove saltella la sua cena."
          }
        }
      }
    },
    "Va bene. L'isola ti aspetta domani." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gut. Die Insel wartet morgen auf dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That's alright. Your island will wait for you tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale. Tu isla te espera mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'accord. Ton île t'attendra demain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va bene. L'isola ti aspetta domani."
          }
        }
      }
    },
    "Va matta per l'uva. Di notte controlla se è matura." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ist verrückt nach Trauben. Nachts prüft er, ob sie reif sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's crazy about grapes. At night it checks if they're ripe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vuelven loca las uvas. De noche comprueba si están maduras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle raffole du raisin. La nuit, elle vérifie s'il est mûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va matta per l'uva. Di notte controlla se è matura."
          }
        }
      }
    },
    "Va matto per le carote. E per tutto il resto." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie ist verrückt nach Karotten. Und nach allem anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's crazy about carrots. And about everything else."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vuelven loco las zanahorias. Y todo lo demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il raffole des carottes. Et de tout le reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va matto per le carote. E per tutto il resto."
          }
        }
      }
    },
