    "Abita sul tetto della casa sull'albero. Ha visto passare più anni lui della quercia, dicono.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abita sul tetto della casa sull'albero. Ha visto passare più anni lui della quercia, dicono."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He lives on the roof of the treehouse. They say he's seen more years go by than the oak has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vive en el tejado de la casa del árbol. Dicen que ha visto pasar más años que el roble."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il habite sur le toit de la cabane. On dit qu'il a vu passer plus d'années que le chêne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wohnt auf dem Dach des Baumhauses. Er hat mehr Jahre vergehen sehen als die Eiche, sagt man."
          }
        }
      }
    },
