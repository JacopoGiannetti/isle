    "A volte un seme diventa una variante rara: è l'unico modo per attirare gli animali rari.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A volte un seme diventa una variante rara: è l'unico modo per attirare gli animali rari."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sometimes a seed becomes a rare variant: it's the only way to lure rare animals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A veces una semilla se vuelve una variante rara: es la única forma de atraer a los animales raros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfois une graine devient une variante rare : c'est la seule façon d'attirer les animaux rares."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manchmal wird aus einem Samen eine seltene Variante: nur so lockst du die seltenen Tiere an."
          }
        }
      }
    },
