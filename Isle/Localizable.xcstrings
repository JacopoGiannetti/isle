        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgens spielt er seinen Kamm wie eine Trompete. Die anderen antworten von weit her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the morning it plays its crest like a trumpet. The others answer from afar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por la mañana toca su cresta como una trompeta. Los demás responden desde lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le matin, il joue de sa crête comme d'une trompette. Les autres répondent de loin."
