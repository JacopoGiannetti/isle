    "Balla sui sassi d'argento con la pancia gialla al sole." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie tanzt auf den Silbersteinen, den gelben Bauch in der Sonne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It dances on the silver stones with its yellow belly in the sun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baila sobre las piedras de plata con la barriga amarilla al sol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle danse sur les pierres d'argent, le ventre jaune au soleil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balla sui sassi d'argento con la pancia gialla al sole."
          }
        }
      }
    },
    "Balla sui sassi d'argento e la pancia gialla brilla al sole. Non sta ferma un attimo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie tanzt auf den Silbersteinen, und ihr gelber Bauch glänzt in der Sonne. Sie steht keinen Moment still."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It dances on the silver stones and its yellow belly shines in the sun. It never keeps still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baila sobre las piedras de plata y la barriga amarilla brilla al sol. No se está quieta ni un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle danse sur les pierres d'argent et son ventre jaune brille au soleil. Elle ne tient pas en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balla sui sassi d'argento e la pancia gialla brilla al sole. Non sta ferma un attimo."
          }
        }
      }
    },
    "Balla sul ruscello di giada al chiaro di luna." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er tanzt im Mondschein auf dem Jadebach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It dances on the jade stream in the moonlight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baila sobre el arroyo de jade a la luz de la luna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle danse sur le ruisseau de jade au clair de lune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balla sul ruscello di giada al chiaro di luna."
          }
        }
      }
    },
    "Balla sul ruscello di giada quando c'è la luna. L'acqua si accende sotto i suoi passi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er tanzt auf dem Jadebach, wenn der Mond scheint. Das Wasser leuchtet unter seinen Schritten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It dances on the jade stream when the moon is out. The water lights up under its steps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baila sobre el arroyo de jade cuando hay luna. El agua se ilumina bajo sus pasos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle danse sur le ruisseau de jade quand la lune est là. L'eau s'illumine sous ses pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balla sul ruscello di giada quando c'è la luna. L'acqua si accende sotto i suoi passi."
          }
        }
      }
    },
