    "Vive in branco e si muove soprattutto di notte. Ulula per ritrovare gli altri, non per spaventare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebt im Rudel und bewegt sich vor allem nachts. Heult, um die anderen zu finden, nicht um zu erschrecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lives in a pack and moves mostly at night. It howls to find the others, not to frighten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive en manada y se mueve sobre todo de noche. Aúlla para reencontrar a los demás, no para asustar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vit en meute et se déplace surtout la nuit. Il hurle pour retrouver les autres, pas pour faire peur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive in branco e si muove soprattutto di notte. Ulula per ritrovare gli altri, non per spaventare."
          }
        }
      }
    },
    "Vive in montagna e sale sui sassi come su una scala." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er lebt in den Bergen und klettert über Felsen wie über eine Treppe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lives in the mountains and climbs rocks like stairs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive en la montaña y sube por las rocas como por una escalera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vit en montagne et grimpe sur les rochers comme sur un escalier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive in montagna e sale sui sassi come su una scala."
          }
        }
      }
    },
    "Vive in piccoli gruppi chiacchieroni. Fa il bagno nella polvere per pulirsi le piume." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebt in kleinen, geschwätzigen Gruppen. Nimmt Staubbäder, um die Federn zu putzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lives in little chatty groups. It takes dust baths to clean its feathers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive en pequeños grupos parlanchines. Se baña en el polvo para limpiarse las plumas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vit en petits groupes bavards. Il se baigne dans la poussière pour se nettoyer les plumes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive in piccoli gruppi chiacchieroni. Fa il bagno nella polvere per pulirsi le piume."
          }
        }
      }
    },
    "Vive nel tronco tra i funghi e ci resta per anni. Al tramonto apre le ali e fa un giro, rumoroso." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebt im Stamm zwischen den Pilzen und bleibt Jahre. In der Dämmerung öffnet er die Flügel und macht eine laute Runde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lives in the log among the mushrooms and stays there for years. At dusk it opens its wings and takes a noisy turn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive en el tronco entre los hongos y se queda años. Al atardecer abre las alas y da una vuelta, ruidoso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vit dans le tronc parmi les champignons et y reste des années. Au crépuscule il ouvre les ailes et fait un tour, bruyant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive nel tronco tra i funghi e ci resta per anni. Al tramonto apre le ali e fa un giro, rumoroso."
          }
        }
      }
    },
    "Vive nella tana del cumulo e controlla tutto quello che succede. Non ha paura di nessuno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wohnt im Bau der Schneewehe und behält alles im Blick. Er hat vor niemandem Angst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lives in the snowdrift den and keeps an eye on everything. It's afraid of no one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive en la madriguera del montón de nieve y lo vigila todo. No le tiene miedo a nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vit dans le terrier de la congère et surveille tout ce qui se passe. Il n'a peur de personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive nella tana del cumulo e controlla tutto quello che succede. Non ha paura di nessuno."
          }
        }
      }
    },
    "Vive su un'isola sola al mondo. Ora anche su questa." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie lebt auf nur einer Insel der Welt. Jetzt auch auf dieser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lives on just one island in the world. Now on this one too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive en una sola isla del mundo. Ahora también en esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vit sur une seule île au monde. Maintenant aussi sur celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive su un'isola sola al mondo. Ora anche su questa."
          }
        }
      }
    },
    "Vive tra i fiori luminosi e si accende con loro. Quando chiude gli occhi, il ramo si spegne." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebt zwischen den leuchtenden Blumen und leuchtet mit ihnen. Wenn sie die Augen schließt, erlischt der Zweig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It lives among the glowing flowers and lights up with them. When it closes its eyes, the branch goes dark."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive entre las flores luminosas y se enciende con ellas. Cuando cierra los ojos, la rama se apaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vit parmi les fleurs lumineuses et s'allume avec elles. Quand il ferme les yeux, la branche s'éteint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vive tra i fiori luminosi e si accende con loro. Quando chiude gli occhi, il ramo si spegne."
          }
        }
      }
    },
    "Vola" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fliegt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flies"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vole"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola"
          }
        }
      }
    },
    "Vola bassa sopra i fiori di loto. Si posa sempre sullo stesso stelo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie fliegt tief über den Lotusblüten. Sie landet immer auf demselben Stängel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flies low over the lotus flowers. It always lands on the same stem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela bajo sobre las flores de loto. Siempre se posa en el mismo tallo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle vole bas au-dessus des lotus. Elle se pose toujours sur la même tige."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola bassa sopra i fiori di loto. Si posa sempre sullo stesso stelo."
          }
        }
      }
    },
    "Vola bassa sui fiori della tundra. Quando c'è vento si nasconde tra i lamponi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fliegt tief über die Tundrablumen. Bei Wind versteckt er sich zwischen den Moltebeeren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flies low over the tundra flowers. When it's windy, it hides among the cloudberries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela bajo sobre las flores de la tundra. Cuando hace viento se esconde entre las moras árticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vole bas sur les fleurs de la toundra. Quand il y a du vent, il se cache parmi les plaquebières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola bassa sui fiori della tundra. Quando c'è vento si nasconde tra i lamponi."
          }
        }
      }
    },
    "Vola con le ali di pelle, come un aquilone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fliegt mit Hautflügeln, wie ein Drachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flies on wings of skin, like a kite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela con alas de piel, como una cometa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vole avec des ailes de peau, comme un cerf-volant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola con le ali di pelle, come un aquilone."
          }
        }
      }
    },
    "Vola da un fiore d'aloe all'altro. Quando c'è vento si posa sull'erba e aspetta." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er flattert von einer Aloeblüte zur nächsten. Wenn es windig ist, setzt er sich ins Gras und wartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flutters from one aloe flower to the next. When it's windy, it settles on the grass and waits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela de una flor de aloe a otra. Cuando hace viento, se posa en la hierba y espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vole d'une fleur d'aloès à l'autre. Quand il y a du vent, il se pose sur l'herbe et attend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola da un fiore d'aloe all'altro. Quando c'è vento si posa sull'erba e aspetta."
          }
        }
      }
    },
    "Vola da un polo all'altro, ogni anno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie fliegt jedes Jahr von einem Pol zum anderen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flies from one pole to the other, every year."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela de un polo al otro, cada año."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle vole d'un pôle à l'autre, chaque année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola da un polo all'altro, ogni anno."
          }
        }
      }
    },
    "Vola dalle azalee ai ciliegi senza fermarsi mai. Quando c'è vento si posa sulle ortensie." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fliegt von den Azaleen zu den Kirschbäumen, ohne je anzuhalten. Bei Wind setzt er sich auf die Hortensien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flies from the azaleas to the cherry trees without ever stopping. When it's windy it rests on the hydrangeas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela de las azaleas a los cerezos sin pararse nunca. Cuando hace viento se posa en las hortensias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vole des azalées aux cerisiers sans jamais s'arrêter. Quand il y a du vent, il se pose sur les hortensias."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola dalle azalee ai ciliegi senza fermarsi mai. Quando c'è vento si posa sulle ortensie."
          }
        }
      }
    },
    "Vola solo nelle giornate di sole, tra i Fiori azzurri. Dove si posa, dicono, la giornata va bene." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fliegt nur an Sonnentagen, zwischen den azurblauen Blumen. Wo sie sich setzt, sagt man, wird der Tag gut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only flies on sunny days, among the Blue Flowers. Where it lands, they say, the day goes well."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela solo en los días de sol, entre las Flores azules. Donde se posa, dicen, el día va bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne vole que les jours de soleil, parmi les Fleurs bleues. Là où il se pose, paraît-il, la journée se passe bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola solo nelle giornate di sole, tra i Fiori azzurri. Dove si posa, dicono, la giornata va bene."
          }
        }
      }
    },
    "Vola solo sopra il bambù di giada, e lascia una scia verde." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fliegt nur über dem Jadebambus und hinterlässt eine grüne Spur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only flies over the jade bamboo, and leaves a green trail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo vuela sobre el bambú de jade, y deja una estela verde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ne vole qu'au-dessus du bambou de jade, et laisse une traînée verte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola solo sopra il bambù di giada, e lascia una scia verde."
          }
        }
      }
    },
    "Vola sopra il bambù di giada stellato e lascia una scia verde nel cielo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fliegt über den Sternen-Jadebambus und hinterlässt eine grüne Spur am Himmel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flies over the starry jade bamboo and leaves a green trail in the sky."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela sobre el bambú de jade estrellado y deja una estela verde en el cielo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle vole au-dessus du bambou de jade étoilé et laisse une traînée verte dans le ciel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola sopra il bambù di giada stellato e lascia una scia verde nel cielo."
          }
        }
      }
    },
    "Vola sull'orto da una foglia all'altra. Si posa sui girasoli quando è stanca." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er fliegt über den Gemüsegarten von Blatt zu Blatt. Wenn er müde ist, setzt er sich auf die Sonnenblumen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It flies over the vegetable garden from leaf to leaf. It rests on the sunflowers when it's tired."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuela por el huerto de una hoja a otra. Se posa en los girasoles cuando está cansada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle vole au-dessus du potager d'une feuille à l'autre. Elle se pose sur les tournesols quand elle est fatiguée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vola sull'orto da una foglia all'altra. Si posa sui girasoli quando è stanca."
          }
        }
      }
    },
    "vola tra i fiori" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "fliegt zwischen den Blumen"
          }
        },
        "en" : {
          "stringUnit" : {
