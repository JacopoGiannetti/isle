    "Rosicchia gli equiseti col becco da pappagallo. Scuote il ciuffo della coda quando è contento." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er knabbert mit seinem Papageienschnabel an Schachtelhalmen. Wenn er sich freut, schüttelt er sein Schwanzbüschel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It nibbles horsetails with its parrot beak. It shakes its tail tuft when it's happy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mordisquea las colas de caballo con su pico de loro. Sacude el penacho de la cola cuando está contento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il grignote les prêles avec son bec de perroquet. Il secoue la houppe de sa queue quand il est content."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosicchia gli equiseti col becco da pappagallo. Scuote il ciuffo della coda quando è contento."
          }
        }
      }
    },
    "Rosicchia i rami di salice per costruire la sua diga. Lavora di notte e fa un baccano incredibile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagt Weidenzweige, um seinen Damm zu bauen. Arbeitet nachts und macht einen unglaublichen Lärm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gnaws willow branches to build its dam. It works at night and makes an incredible racket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roe las ramas de sauce para construir su presa. Trabaja de noche y arma un jaleo increíble."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ronge les branches de saule pour construire son barrage. Il travaille la nuit et fait un bruit du tonnerre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosicchia i rami di salice per costruire la sua diga. Lavora di notte e fa un baccano incredibile."
          }
        }
      }
    },
    "Rosicchia le carote giganti con le orecchie che strisciano per terra. Si lava il muso con le zampe." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es knabbert an den Riesenkarotten, die Ohren schleifen am Boden. Es putzt sich das Gesicht mit den Pfoten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It nibbles the giant carrots with its ears dragging on the ground. It washes its face with its paws."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roe las zanahorias gigantes con las orejas arrastrando por el suelo. Se lava el hocico con las patas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il grignote les carottes géantes, les oreilles traînant par terre. Il se lave le museau avec les pattes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosicchia le carote giganti con le orecchie che strisciano per terra. Si lava il muso con le zampe."
          }
        }
      }
    },
    "Rosicchia le carote viola nell'orto. Si lava i baffi dopo ogni morso." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie knabbert die lila Karotten im Gemüsegarten. Nach jedem Bissen putzt sie sich die Schnurrhaare."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It nibbles the purple carrots in the vegetable garden. It washes its whiskers after every bite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roe las zanahorias moradas del huerto. Se lava los bigotes después de cada mordisco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle grignote les carottes violettes du potager. Elle se lave les moustaches après chaque bouchée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosicchia le carote viola nell'orto. Si lava i baffi dopo ogni morso."
          }
        }
      }
    },
