    "Quel giorno niente seme e i giorni di fila ripartono da zero. L'isola resta com'è." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An dem Tag gibt es keinen Samen, und deine Serie beginnt bei null. Die Insel bleibt, wie sie ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seed that day, and your streak starts over from zero. The island stays as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese día no hay semilla y la racha vuelve a cero. La isla se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de graine ce jour-là, et ta série repart de zéro. L'île reste comme elle est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel giorno niente seme e i giorni di fila ripartono da zero. L'isola resta com'è."
          }
        }
      }
    },
    "Quel giorno niente seme e i giorni puliti ripartono da zero. L'isola resta com'è." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An dem Tag gibt es keinen Samen, und die sauberen Tage beginnen bei null. Die Insel bleibt, wie sie ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No seed that day, and the clean days start over from zero. The island stays as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese día no hay semilla y los días limpios vuelven a cero. La isla se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de graine ce jour-là, et les jours sans accroc repartent de zéro. L'île reste comme elle est."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel giorno niente seme e i giorni puliti ripartono da zero. L'isola resta com'è."
          }
        }
