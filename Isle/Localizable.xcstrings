    "Resta fermo nell'acqua bassa anche per un'ora. Poi scatta col becco, e non sbaglia quasi mai." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt eine ganze Stunde still im seichten Wasser. Dann schnellt der Schnabel, und er trifft fast immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays still in the shallows for a whole hour. Then it strikes with its beak, and it almost never misses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda quieto en el agua baja hasta una hora. Luego dispara con el pico, y casi nunca falla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste immobile dans l'eau basse pendant une heure. Puis il frappe du bec, et il ne rate presque jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta fermo nell'acqua bassa anche per un'ora. Poi scatta col becco, e non sbaglia quasi mai."
          }
        }
      }
    },
    "Resta solo su questo iPhone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bleibt nur auf diesem iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stays on this iPhone only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda solo en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste uniquement sur cet iPhone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta solo su questo iPhone."
          }
        }
      }
    },
    "Resta sospesa davanti ai fiori battendo le ali velocissime. Beve il nettare con una proboscide lunga quanto lei." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwebt vor den Blumen und schlägt die Flügel ganz schnell. Trinkt den Nektar mit einem Rüssel so lang wie sie selbst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It hangs in front of the flowers, beating its wings very fast. It drinks the nectar with a tongue as long as itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda suspendida frente a las flores batiendo las alas rapidísimo. Bebe el néctar con una trompa tan larga como ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle reste suspendue devant les fleurs en battant des ailes très vite. Elle boit le nectar avec une trompe aussi longue qu'elle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta sospesa davanti ai fiori battendo le ali velocissime. Beve il nettare con una proboscide lunga quanto lei."
          }
        }
      }
    },
    "Resta sull'isola solo finché dura il fenomeno: quando finisce, se ne va." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es bleibt nur auf der Insel, solange das Phänomen andauert. Wenn es endet, zieht es weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only stays on the island while the event lasts. When it ends, it leaves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se queda en la isla mientras dure el fenómeno. Cuando termine, se irá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne reste sur l'île que tant que dure le phénomène. Quand il se termine, il s'en va."
          }
        }
      }
    },
    "Restano su questo iPhone e nel tuo iCloud privato. Noi non le vediamo, mai." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bleiben auf diesem iPhone und in deiner privaten iCloud. Wir sehen sie nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They stay on this iPhone and in your private iCloud. We never see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quedan en este iPhone y en tu iCloud privado. Nosotros nunca las vemos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles restent sur cet iPhone et dans ton iCloud privé. Nous ne les voyons jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restano su questo iPhone e nel tuo iCloud privato. Noi non le vediamo, mai."
          }
        }
      }
    },
    "Restare in carreggiata ora è\nquasi troppo facile." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
