    "Di notte scende dalla giostra e galoppa nei campi. All'alba torna su, e nessuno se ne accorge." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachts steigt es vom Karussell und galoppiert über die Felder. Bei Tagesanbruch steigt es wieder auf, und niemand merkt es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At night it gets off the carousel and gallops through the fields. At dawn it climbs back on, and nobody notices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De noche baja del tiovivo y galopa por los campos. Al amanecer vuelve a subir, y nadie se da cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nuit, il descend du manège et galope dans les champs. À l'aube, il remonte, et personne ne s'en aperçoit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di notte scende dalla giostra e galoppa nei campi. All'alba torna su, e nessuno se ne accorge."
          }
        }
      }
    },
    "Di notte si accendono come lanterne." : {
      "extractionState" : "manual",
      "localizations" : {
