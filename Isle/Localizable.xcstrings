        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It hides among the azaleas and sings. You always hear it, but you almost never see it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esconde entre las azaleas y canta. Siempre lo oyes, pero casi nunca lo ves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle se cache dans les azalées et chante. On l'entend toujours, mais on ne la voit presque jamais."
