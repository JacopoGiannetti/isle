    "Sta sul sasso più caldo della sorgente a prendere il sole. Quando canta sembra una campanella.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta sul sasso più caldo della sorgente a prendere il sole. Quando canta sembra una campanella."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It sits on the warmest rock of the spring, sunning itself. When it sings it sounds like a little bell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está en la piedra más caliente del manantial tomando el sol. Cuando canta parece una campanita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est sur la pierre la plus chaude de la source, à prendre le soleil. Quand elle chante, on dirait une clochette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzt auf dem wärmsten Stein der Quelle und sonnt sich. Wenn sie singt, klingt sie wie ein Glöckchen."
          }
        }
      }
    },
    "Sta tra i sassi tiepidi della sorgente. Esce solo dopo la pioggia, quando tutto luccica.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta tra i sassi tiepidi della sorgente. Esce solo dopo la pioggia, quando tutto luccica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays among the warm stones of the spring. It only comes out after the rain, when everything glints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está entre las piedras tibias del manantial. Sale solo después de la lluvia, cuando todo brilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle reste parmi les pierres tièdes de la source. Elle ne sort qu'après la pluie, quand tout brille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt zwischen den warmen Steinen der Quelle. Kommt nur nach dem Regen heraus, wenn alles glitzert."
          }
        }
      }
    },
