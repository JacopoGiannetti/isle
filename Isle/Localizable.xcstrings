    },
    "Porta fortuna, se lo trovi tu." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es bringt Glück, wenn du es findest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It brings luck, if you're the one who finds it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da suerte, si la encuentras tú."
          }
        },
