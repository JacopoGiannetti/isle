    "Viaggia sulla schiena di giraffe ed elefanti e li tiene puliti. Loro non si lamentano." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er reist auf dem Rücken von Giraffen und Elefanten und hält sie sauber. Die beschweren sich nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It rides on the backs of giraffes and elephants and keeps them clean. They don't complain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaja a lomos de jirafas y elefantes y los mantiene limpios. Ellos no se quejan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il voyage sur le dos des girafes et des éléphants et les garde propres. Eux ne s'en plaignent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viaggia sulla schiena di giraffe ed elefanti e li tiene puliti. Loro non si lamentano."
          }
        }
      }
    },
