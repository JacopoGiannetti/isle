    "Così grande che una regina ci si riparò con cento cavalieri." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So groß, dass eine Königin mit hundert Rittern darunter Schutz fand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So big that a queen once sheltered under it with a hundred knights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tan grande que una reina se refugió bajo él con cien caballeros."
