    "C'è da quando è nata l'isola": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è da quando è nata l'isola"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's been here since the island was born"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está desde que nació la isla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est là depuis la naissance de l'île"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist da, seit die Insel geboren wurde"
          }
        }
      }
    },
    "C'è il temporale sulla tua isola. Rispondi: il cielo si apre subito.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è il temporale sulla tua isola. Rispondi: il cielo si apre subito."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's a storm on your island. Answer: the sky clears at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una tormenta en tu isla. Responde: el cielo se abre enseguida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a un orage sur ton île. Réponds : le ciel s'ouvre tout de suite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über deiner Insel liegt ein Gewitter. Antworte: der Himmel öffnet sich sofort."
          }
        }
      }
    },
    "C'è l'aurora sulla tua isola": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è l'aurora sulla tua isola"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's an aurora over your island"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay aurora en tu isla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il y a une aurore sur ton île"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über deiner Insel liegt ein Polarlicht"
          }
        }
      }
