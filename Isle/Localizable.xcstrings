    "Si fa bello solo davanti a quattro piante in fiore." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht sich nur vor vier blühenden Pflanzen schön."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only shows off in front of four plants in bloom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pone guapo solo delante de cuatro plantas en flor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne se fait beau que devant quatre plantes en fleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fa bello solo davanti a quattro piante in fiore."
          }
        }
      }
    },
    "Si fa più selvaggio." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird wilder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It gets wilder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuelve salvaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça devient sauvage."
          }
        }
      }
    },
    "Si fa vedere al mattino presto, sotto i petali bianchi. Beve alla sorgente e poi sparisce tra gli alberi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt sich früh am Morgen, unter den weißen Blüten. Trinkt an der Quelle und verschwindet dann zwischen den Bäumen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It shows itself early in the morning, under the white petals. It drinks at the spring and then vanishes among the trees."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se deja ver por la mañana temprano, bajo los pétalos blancos. Bebe en el manantial y luego desaparece entre los árboles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se montre tôt le matin, sous les pétales blancs. Il boit à la source, puis disparaît parmi les arbres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fa vedere al mattino presto, sotto i petali bianchi. Beve alla sorgente e poi sparisce tra gli alberi."
          }
        }
      }
    },
    "Si fa vedere solo dove pascolano le strisce." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zeigt sich nur dort, wo Streifen grasen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only shows up where stripes are grazing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo aparece donde pastan las rayas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne se montre que là où broutent les rayures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fa vedere solo dove pascolano le strisce."
          }
        }
      }
    },
    "Si ferma solo dove trova felci alte da brucare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er bleibt nur, wo er hohe Farne zum Fressen findet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only stops where it finds tall ferns to graze on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se detiene donde encuentra helechos altos que pastar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s'arrête que là où il trouve de hautes fougères à brouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ferma solo dove trova felci alte da brucare."
          }
        }
      }
    },
    "Si ferma solo dove trova qualcosa di dolce da brucare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es bleibt nur dort, wo es etwas Süßes zum Knabbern findet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It only stops where it finds something sweet to nibble."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se detiene donde encuentra algo dulce que mordisquear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ne s'arrête que là où il trouve quelque chose de sucré à brouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ferma solo dove trova qualcosa di dolce da brucare."
          }
        }
      }
    },
    "Si gode il fango profondo con tutta la mandria. Non si sposta per nessuno." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er genießt den tiefen Schlamm mit der ganzen Herde. Für niemanden geht er zur Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It enjoys the deep mud with the whole herd. It won't budge for anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disfruta del barro profundo con toda la manada. No se aparta por nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profite du bourbier profond avec tout le troupeau. Il ne bouge pour personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si gode il fango profondo con tutta la mandria. Non si sposta per nessuno."
          }
        }
      }
    },
    "Si gode il vapore della sorgente. Il collare di spuntoni gli serve solo per farsi notare." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er genießt den Dampf der Quelle. Den Stachelkragen trägt er nur, um aufzufallen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It enjoys the steam from the spring. Its spiky frill is only there to get noticed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disfruta del vapor del manantial. El collar de pinchos solo le sirve para hacerse notar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profite de la vapeur de la source. Sa collerette à pointes ne sert qu'à se faire remarquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si gode il vapore della sorgente. Il collare di spuntoni gli serve solo per farsi notare."
          }
        }
      }
    },
    "si guarda intorno" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "schaut sich um"
