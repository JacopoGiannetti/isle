    "Sale sull'acero di notte per leccare lo sciroppo dai secchielli. Al mattino non c'è mai nessuna prova.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale sull'acero di notte per leccare lo sciroppo dai secchielli. Al mattino non c'è mai nessuna prova."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It climbs the maple at night to lick syrup from the buckets. In the morning there's never any proof."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube al arce de noche a lamer el jarabe de los cubitos. Por la mañana nunca queda ninguna prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle grimpe à l'érable la nuit pour lécher le sirop dans les seillets. Le matin, il n'y a jamais la moindre preuve."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klettert nachts auf den Ahorn, um Sirup aus den Eimern zu lecken. Am Morgen gibt es nie einen Beweis."
          }
        }
      }
    },
