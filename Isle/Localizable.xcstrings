    "Beve alla fontana di bambù e tuba piano. Fa un salto ogni volta che la fontana fa toc." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie trinkt am Bambusbrunnen und gurrt leise. Jedes Mal, wenn der Brunnen tock macht, zuckt sie zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It drinks at the bamboo fountain and coos softly. It jumps every time the fountain goes tock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe en la fuente de bambú y arrulla bajito. Da un salto cada vez que la fuente hace toc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle boit à la fontaine de bambou et roucoule doucement. Elle sursaute chaque fois que la fontaine fait toc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beve alla fontana di bambù e tuba piano. Fa un salto ogni volta che la fontana fa toc."
          }
        }
      }
    },
    "Beve alla pozza in gruppo, con qualcuno che fa sempre la guardia. Si gratta la schiena sulle zebre vicine." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es trinkt in der Gruppe an der Wasserstelle, und einer hält immer Wache. Es kratzt sich den Rücken an den Zebras nebenan."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It drinks at the waterhole in a group, with someone always on guard. It scratches its back on nearby zebras."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe en la charca en grupo, con alguien siempre vigilando. Se rasca la espalda contra las cebras de al lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il boit au point d'eau en groupe, avec toujours quelqu'un qui monte la garde. Il se gratte le dos contre les zèbres voisins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beve alla pozza in gruppo, con qualcuno che fa sempre la guardia. Si gratta la schiena sulle zebre vicine."
          }
        }
      }
    },
    "Beve dai fiori dell'aloe e brilla come una goccia verde." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er trinkt aus den Aloeblüten und glänzt wie ein grüner Tropfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It drinks from the aloe flowers and shines like a green drop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe de las flores del aloe y brilla como una gota verde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il boit dans les fleurs d'aloès et brille comme une goutte verte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beve dai fiori dell'aloe e brilla come una goccia verde."
          }
        }
      }
    },
    "Beve il nettare col becco ricurvo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er trinkt Nektar mit seinem gebogenen Schnabel."
          }
        },
        "en" : {
